<Application x:Class="AudioFool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:fmt="clr-namespace:AudioFool.Formatting">
    <!-- No StartupUri: App.OnStartup builds the window so it can inject the view model. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Light, because PS1 is dark ink on grey plastic: a stock key
                     the theme does not restate falls back to a light value. -->
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />

                <!--
                    The design system, over WPF-UI's base. Order matters twice
                    over: tokens before the components that read them, and both
                    after WPF-UI so a token can override one of its keys.

                    Everything themeable lives in these two dictionaries rather
                    than in the entries below, because a key in this dictionary's
                    own body outranks every merged one - including the PS1
                    theme, which ThemeService merges last of all.
                -->
                <ResourceDictionary Source="pack://application:,,,/AudioFool;component/Themes/DesignTokens.xaml" />
                <ResourceDictionary Source="pack://application:,,,/AudioFool;component/Themes/Components.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters are logic, not looks: no theme has anything to say
                 about them, so they stay here. -->
            <fmt:DurationConverter x:Key="Duration" />
            <fmt:BitrateConverter x:Key="Bitrate" />
            <fmt:BitDepthConverter x:Key="BitDepth" />
            <fmt:SampleRateConverter x:Key="SampleRate" />
            <fmt:NumberConverter x:Key="Number" />
            <fmt:NullToCollapsedConverter x:Key="NullToCollapsed" />
            <fmt:NullToVisibleConverter x:Key="NullToVisible" />
            <fmt:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <fmt:InverseBoolConverter x:Key="InverseBool" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
