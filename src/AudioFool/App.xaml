<Application x:Class="AudioFool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:fmt="clr-namespace:AudioFool.Formatting">
    <!-- No StartupUri: App.OnStartup builds the window so it can inject the view model. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Light, because the theme is dark text on light grey: a stock
                     key the theme does not restate falls back to a light value.
                     The theme itself is merged over these by ThemeService.Apply().
                     Nothing themeable goes in this file's own body: a key there
                     outranks every merged dictionary, the theme's included. -->
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters are logic, not looks: no theme has anything to say
                 about them, so they stay here. -->
            <fmt:DurationConverter x:Key="Duration" />
            <fmt:BitrateConverter x:Key="Bitrate" />
            <fmt:BitDepthConverter x:Key="BitDepth" />
            <fmt:SampleRateConverter x:Key="SampleRate" />
            <fmt:NumberConverter x:Key="Number" />
            <fmt:NullToCollapsedConverter x:Key="NullToCollapsed" />
            <fmt:NullToVisibleConverter x:Key="NullToVisible" />
            <fmt:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <fmt:InverseBoolConverter x:Key="InverseBool" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
