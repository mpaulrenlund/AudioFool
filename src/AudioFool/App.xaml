<Application x:Class="AudioFool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:fmt="clr-namespace:AudioFool.Formatting">
    <!-- No StartupUri: App.OnStartup builds the window so it can inject the view model. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Dark is the default, as asked for. -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <fmt:DurationConverter x:Key="Duration" />
            <fmt:BitrateConverter x:Key="Bitrate" />
            <fmt:BitDepthConverter x:Key="BitDepth" />
            <fmt:SampleRateConverter x:Key="SampleRate" />
            <fmt:NumberConverter x:Key="Number" />
            <fmt:NullToCollapsedConverter x:Key="NullToCollapsed" />
            <fmt:NullToVisibleConverter x:Key="NullToVisible" />
            <fmt:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <fmt:InverseBoolConverter x:Key="InverseBool" />
            <fmt:EnabledOpacityConverter x:Key="EnabledOpacity" />

            <!-- The three browser panes share one card look. -->
            <Style x:Key="PaneBorder" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="PaneHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Opacity" Value="0.5" />
                <Setter Property="Margin" Value="12,10,12,6" />
            </Style>

            <!-- Numbers right-align so track and bitrate columns scan vertically. -->
            <Style x:Key="NumericCell" TargetType="TextBlock">
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>

            <!--
                The stock WPF-UI slider rail spans the full width, so its rounded
                end cap pokes out past the circular thumb at 0% and 100%, leaving a
                bright sliver beside the thumb. Insetting the rail by the thumb
                radius tucks both caps under the thumb at the extremes. The thumb
                and hover states are copied verbatim from the WPF-UI default
                template; only the rail's Margin changes.
            -->
            <!--
                No BasedOn: inheriting the WPF-UI base Slider style silently
                resets the TrackBackground's Margin to 0 (and widens the control),
                which is exactly what reintroduced the sliver. This template is
                self-contained - every brush is a DynamicResource - so it needs
                nothing from the base style.
            -->
            <Style x:Key="EdgeToEdgeSlider" TargetType="Slider">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid VerticalAlignment="Center">
                                <Border x:Name="TrackBackground"
                                        Height="4" CornerRadius="2" Margin="10,0"
                                        Background="{DynamicResource SliderTrackFill}" />
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Focusable="False" IsTabStop="False"
                                                      OverridesDefaultStyle="True">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Focusable="False" IsTabStop="False"
                                                      OverridesDefaultStyle="True">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb x:Name="Thumb"
                                               Height="20" Width="20"
                                               OverridesDefaultStyle="True"
                                               SnapsToDevicePixels="True"
                                               Background="{DynamicResource SliderOuterThumbBackground}"
                                               BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                               BorderThickness="1"
                                               Foreground="{DynamicResource SliderThumbBackground}">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="16"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            Background="{TemplateBinding Background}">
                                                        <Ellipse Width="12" Height="12"
                                                                 Fill="{TemplateBinding Foreground}" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TrackBackground" Property="Background"
                                            Value="{DynamicResource SliderTrackFillPointerOver}" />
                                    <Setter TargetName="Thumb" Property="Foreground"
                                            Value="{DynamicResource SliderThumbBackgroundPointerOver}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
