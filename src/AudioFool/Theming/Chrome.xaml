<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:theme="clr-namespace:AudioFool.Theming"
                    xmlns:local="clr-namespace:AudioFool"
                    xmlns:fmt="clr-namespace:AudioFool.Formatting"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        ============================================================================
        PS1 theme: title bar and panels (design/theme-spec.md 6.1 to 6.4)
        ============================================================================

        The new theme's components, built only from the central theme
        (design/theme-tokens.json, loaded by TokenResources). Every colour, size,
        radius and gap below is a token; the only literal numbers are icon
        geometry on its 24-unit grid, as drawn in the mockup.

        Screens move here one region at a time. Until the last one has, the old
        Af* dictionaries stay loaded beside this one for everything not yet
        restyled. Keys here start with "theme." so they cannot collide with
        either the Af* keys or the token names.
    -->

    <!-- ========================================================== panels -->

    <!--
        6.2: panel grey, a 1 px border, 4 px corners, and a 1 px highlight just
        inside the top edge (shadow.panelHighlight, which WPF cannot draw as an
        inset). The header is a 28 px strip over a divider.
    -->
    <ControlTemplate x:Key="theme.panelTemplate" TargetType="HeaderedContentControl">
        <Border Background="{DynamicResource color.panel.bg}"
                BorderBrush="{DynamicResource color.panel.border}"
                BorderThickness="{theme:Token layout.panelBorder}"
                CornerRadius="{DynamicResource radius.surface}"
                SnapsToDevicePixels="True">
            <Grid>
                <DockPanel>
                    <Border x:Name="HeaderStrip"
                            DockPanel.Dock="Top"
                            Height="{TemplateBinding Tag}"
                            Padding="{TemplateBinding Padding}"
                            BorderBrush="{DynamicResource color.panel.divider}"
                            BorderThickness="{theme:Thickness Bottom=layout.panelBorder}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                    </Border>
                    <ContentPresenter />
                </DockPanel>
                <Border Height="{theme:Token shadow.panelHighlight.inset1.y}"
                        VerticalAlignment="Top"
                        Background="{DynamicResource shadow.panelHighlight.inset1}"
                        CornerRadius="{DynamicResource radius.surface}"
                        IsHitTestVisible="False" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="Header" Value="{x:Null}">
                <Setter TargetName="HeaderStrip" Property="Visibility" Value="Collapsed" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Artists and Albums: a label header. Tag carries the strip's height,
         so the Songs panel below can share the template with a header that
         sizes to its content. -->
    <Style x:Key="theme.panel" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Tag" Value="{theme:Token layout.panelHeaderHeight}" />
        <Setter Property="Padding" Value="{theme:Thickness X=layout.panelHeaderPaddingX}" />
        <Setter Property="Template" Value="{StaticResource theme.panelTemplate}" />
    </Style>

    <!-- Songs: the same shell. Its header is the album header, which sets its
         own size and padding (6.5). -->
    <Style x:Key="theme.panel.songs" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Tag">
            <Setter.Value>
                <sys:Double>NaN</sys:Double>
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template" Value="{StaticResource theme.panelTemplate}" />
    </Style>

    <!-- ===================================================== list rows -->

    <!--
        6.3 and 6.4: an artist or album row. Selection is a mid grey fill, hover
        a faint wash laid over whatever is there, both with 3 px corners. No
        focus ring on these rows, at the user's request (confirmed in session 5,
        overriding spec 8): the selection already moves with the arrow keys.
        The sublines' colour change on selection is in the item templates,
        which watch IsSelected on this row.
    -->
    <ControlTemplate x:Key="theme.browserRowTemplate" TargetType="ListBoxItem">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="Fill"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{DynamicResource radius.row}" />
            <Border x:Name="Hover"
                    Visibility="Collapsed"
                    Background="{DynamicResource color.state.hoverOverlay}"
                    CornerRadius="{DynamicResource radius.row}"
                    IsHitTestVisible="False" />
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource color.state.selectionBg}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ===================================================== song table -->

    <!--
        6.6: ten columns 12 px apart, under a 32 px header strip with a divider,
        in a list area padded 6 / 8, with 28 px rows padded 8 either side.

        The 12 px gap is split as half a gap of padding either side of every
        cell (and header), so it moves with a column that is dragged elsewhere.
        That puts half a gap inside each row's padding and the header's, so
        those are set to the token minus half a gap. MainWindow works the three
        out from the tokens (ApplySongTableLayout) and puts them in the grid's
        resources as songTable.derived.*, beside each column's width and
        alignment, which are read from songTable.columns.

        DataGrid sizes its columns to the viewport less the cells' offset from
        its own left edge (measured: list padding plus row padding), which
        counts the left list padding twice when the viewport has already lost
        it. So the list area is inset by the full list padding on the left but
        only the row padding on the right, and the row's fill and hover stop
        the difference short of its right edge. The fill still spans the list
        area, and the columns fill exactly the space inside the row padding.
    -->

    <Style x:Key="theme.songHeaderGripper" TargetType="Thumb">
        <!-- The drag handle on a column's edge: 8 px, the stock DataGrid width,
             a framework constant rather than a design value. Invisible. -->
        <Setter Property="Width" Value="8" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SONG, ARTIST: small grey capitals tracked 0.06 em. Written in capitals
         in MainWindow, since a style cannot change case. -->
    <Style x:Key="theme.songHeaderLabel" TargetType="TextBlock" BasedOn="{StaticResource type.tableHeader}">
        <Setter Property="fmt:LetterSpacing.Em" Value="{DynamicResource type.tableHeader.letterSpacingEm}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A column header: the label, and the grips that resize the column.
         Click to sort and drag to reorder are DataGridColumnHeader's own. No
         sort arrow (the user's call). The column's alignment is set per column
         from code, on a style based on this one. -->
    <Style x:Key="theme.songHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="{DynamicResource songTable.derived.cellPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{StaticResource theme.songHeaderLabel}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid Background="{TemplateBinding Background}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="False" />
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left"
                               Style="{StaticResource theme.songHeaderGripper}" />
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right"
                               Style="{StaticResource theme.songHeaderGripper}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A song row: transparent, a faint wash on hover, the selection grey when
        selected, and the now-playing tint when it is the playing track, which
        wins over selection. 3 px corners. Applied by the row style in
        MainWindow, which also sets local:TrackRow.IsNowPlaying.
    -->
    <ControlTemplate x:Key="theme.songRowTemplate" TargetType="DataGridRow">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="Fill"
                    Margin="{DynamicResource songTable.derived.rowFillMargin}"
                    Background="Transparent"
                    CornerRadius="{DynamicResource radius.row}" />
            <Border x:Name="Hover"
                    Margin="{DynamicResource songTable.derived.rowFillMargin}"
                    Visibility="Collapsed"
                    Background="{DynamicResource color.state.hoverOverlay}"
                    CornerRadius="{DynamicResource radius.row}"
                    IsHitTestVisible="False" />
            <DataGridCellsPresenter Margin="{DynamicResource songTable.derived.rowCellsMargin}"
                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource color.state.selectionBg}" />
            </Trigger>
            <Trigger Property="local:TrackRow.IsNowPlaying" Value="True">
                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource color.state.nowPlayingBg}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- A cell paints nothing: the row owns the fill. Half a gap either side. -->
    <Style x:Key="theme.songCell" TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource songTable.derived.cellPadding}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The # cell: an 8 px slot for the now-playing triangle, a 3 px gap, then
        the number right-aligned in what is left (16 px, or 23 px on an album
        of 100+ tracks, when MainWindow widens the column). The number always
        shows. The triangle is solid while playing and outlined while paused.
        Its path is the mockup's, on its own 7.4 x 10 grid inside an 8 x 10 box.
    -->
    <Style x:Key="theme.songNumberCell" TargetType="DataGridCell" BasedOn="{StaticResource theme.songCell}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{theme:Token songTable.numberCell.triangleSlot}" />
                                <ColumnDefinition Width="{theme:Token songTable.numberCell.gap}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Viewbox x:Name="Triangle"
                                     Grid.Column="0"
                                     Width="{theme:Token songTable.numberCell.triangleSlot}"
                                     Height="10"
                                     VerticalAlignment="Center"
                                     Visibility="Collapsed">
                                <Canvas Width="7.4" Height="10">
                                    <Path x:Name="TrianglePath"
                                          Canvas.Left="-1.6"
                                          Data="M 2.2,1.3 V 8.7 L 8.5,5 Z"
                                          Fill="{DynamicResource color.accent.teal}"
                                          Stroke="{DynamicResource color.accent.teal}"
                                          StrokeThickness="1.2"
                                          StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <ContentPresenter Grid.Column="2" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="local:TrackRow.IsNowPlaying" Value="True">
                            <Setter TargetName="Triangle" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <DataTrigger Binding="{Binding DataContext.IsPlaying, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="False">
                            <Setter TargetName="TrianglePath" Property="Fill" Value="Transparent" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Cell text. Song in type.songTitle, # in type.trackNumber, the rest in
        type.tableCell; "…" when too long, and no tooltip. On the now-playing
        row every one turns teal and semibold; on a selected row the number
        turns text.secondary. Alignment is added per column from code.
    -->
    <Style x:Key="theme.songText" TargetType="TextBlock" BasedOn="{StaticResource type.tableCell}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Style.Triggers>
            <Trigger Property="local:TrackRow.IsNowPlaying" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource color.accent.tealText}" />
                <Setter Property="FontWeight" Value="{DynamicResource songTable.nowPlayingWeight.fontWeight}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="theme.songTitleText" TargetType="TextBlock" BasedOn="{StaticResource type.songTitle}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Style.Triggers>
            <Trigger Property="local:TrackRow.IsNowPlaying" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource color.accent.tealText}" />
                <Setter Property="FontWeight" Value="{DynamicResource songTable.nowPlayingWeight.fontWeight}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="theme.songNumberText" TargetType="TextBlock" BasedOn="{StaticResource type.trackNumber}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource color.text.secondary}" />
            </DataTrigger>
            <Trigger Property="local:TrackRow.IsNowPlaying" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource color.accent.tealText}" />
                <Setter Property="FontWeight" Value="{DynamicResource songTable.nowPlayingWeight.fontWeight}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The table itself. No scrollbars; the wheel, trackpad and keyboard
         still scroll it. -->
    <Style x:Key="theme.songTable" TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="RowHeight" Value="{DynamicResource songTable.rowHeight}" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource theme.songHeader}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGrid">
                    <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="DG_ScrollViewer"
                                      Focusable="False"
                                      Style="{x:Null}"
                                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}">
                            <ScrollViewer.Template>
                                <ControlTemplate TargetType="ScrollViewer">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top"
                                                Height="{theme:Token songTable.headerHeight}"
                                                BorderBrush="{DynamicResource color.panel.divider}"
                                                BorderThickness="{theme:Thickness Bottom=layout.panelBorder}"
                                                SnapsToDevicePixels="True">
                                            <DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter"
                                                                            Margin="{DynamicResource songTable.derived.headerPadding}">
                                                <DataGridColumnHeadersPresenter.Template>
                                                    <ControlTemplate TargetType="DataGridColumnHeadersPresenter">
                                                        <ItemsPresenter />
                                                    </ControlTemplate>
                                                </DataGridColumnHeadersPresenter.Template>
                                            </DataGridColumnHeadersPresenter>
                                        </Border>
                                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                                Margin="{DynamicResource songTable.derived.listMargin}"
                                                                CanContentScroll="{TemplateBinding CanContentScroll}" />
                                    </DockPanel>
                                </ControlTemplate>
                            </ScrollViewer.Template>
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================== search box -->

    <!--
        6.1: 30 px tall, 4 px corners, a 1 px border, 12 px either side, a 16 px
        magnifier 10 px before the text. At rest it is panel grey with a soft
        shadow along the top (shadow.searchInset, drawn as a fade). Focused, it
        lightens and gains a 2 px teal ring outside the border, as the CSS
        box-shadow ring does, so the box itself does not move.

        A template of its own on WPF-UI's TextBox, which keeps the placeholder
        and clear-button logic: CurrentPlaceholderEnabled and ShowClearButton say
        when each shows, and TemplateButtonCommand clears the text.
    -->
    <Style x:Key="theme.searchBox" TargetType="ui:TextBox">
        <Setter Property="Height" Value="{theme:Token titleBar.search.height}" />
        <Setter Property="FontFamily" Value="{DynamicResource font.family}" />
        <Setter Property="FontSize" Value="{theme:Token type.search.size}" />
        <Setter Property="Foreground" Value="{DynamicResource color.text.primary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource color.text.primary}" />
        <Setter Property="Background" Value="{DynamicResource color.panel.bg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource color.panel.border}" />
        <Setter Property="BorderThickness" Value="{theme:Thickness All=layout.panelBorder}" />
        <!-- Zero: a TextBox applies its Padding inside the text host as well,
             which would inset the text twice. The 12 px is the template's. -->
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:TextBox">
                    <Grid>
                        <Border x:Name="FocusRing"
                                Visibility="Collapsed"
                                Margin="{theme:Thickness All=-titleBar.search.focusRingWidth}"
                                BorderBrush="{DynamicResource color.state.searchFocusRing}"
                                BorderThickness="{theme:Thickness All=titleBar.search.focusRingWidth}"
                                CornerRadius="{DynamicResource radius.surface}"
                                IsHitTestVisible="False" />
                        <Border x:Name="Box"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource radius.surface}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border Height="{theme:Token shadow.searchInset.inset1.depth}"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource shadow.searchInset.inset1.fade}"
                                        CornerRadius="{DynamicResource radius.surface}"
                                        IsHitTestVisible="False" />
                                <Grid Margin="{theme:Thickness X=titleBar.search.paddingX}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Viewbox Grid.Column="0"
                                             Width="{theme:Token titleBar.search.iconSize}"
                                             Height="{theme:Token titleBar.search.iconSize}"
                                             VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M 17.5,11 A 6.5,6.5 0 1 1 4.5,11 A 6.5,6.5 0 1 1 17.5,11 Z M 16,16 L 20,20"
                                                  Stroke="{DynamicResource color.text.muted}"
                                                  StrokeThickness="{theme:Token titleBar.search.iconStrokeOn24Grid}"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Canvas>
                                    </Viewbox>

                                    <Grid Grid.Column="1" Margin="{theme:Thickness Left=titleBar.search.iconGap}">
                                        <!-- The -2 cancels the caret gutter WPF puts
                                             before a TextBox's text (measured, 2 px), so
                                             typed text starts where the placeholder does:
                                             iconGap after the icon. A framework constant,
                                             not a design value. -->
                                        <ScrollViewer x:Name="PART_ContentHost"
                                                      Margin="-2,0,0,0"
                                                      Style="{x:Null}"
                                                      Focusable="False"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      HorizontalScrollBarVisibility="Hidden"
                                                      VerticalScrollBarVisibility="Hidden" />
                                        <TextBlock x:Name="Placeholder"
                                                   Text="{TemplateBinding PlaceholderText}"
                                                   FontFamily="{TemplateBinding FontFamily}"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   Foreground="{DynamicResource color.text.placeholder}"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False" />
                                    </Grid>

                                    <Button x:Name="ClearButton"
                                            Grid.Column="2"
                                            Visibility="Collapsed"
                                            Margin="{theme:Thickness Left=titleBar.search.iconGap}"
                                            VerticalAlignment="Center"
                                            Focusable="False"
                                            Cursor="Arrow"
                                            Command="{Binding TemplateButtonCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                            AutomationProperties.Name="Clear search"
                                            ToolTip="Clear search">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <Viewbox Width="{theme:Token titleBar.search.iconSize}"
                                                             Height="{theme:Token titleBar.search.iconSize}">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="M 7,7 L 17,17 M 17,7 L 7,17"
                                                                  Stroke="{DynamicResource color.text.muted}"
                                                                  StrokeThickness="{theme:Token titleBar.search.iconStrokeOn24Grid}"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="CurrentPlaceholderEnabled" Value="False">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ShowClearButton" Value="True" />
                                <Condition Property="ClearButtonEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ClearButton" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <!-- WPF-UI reveals the clear button on focus even with
                             nothing to clear. -->
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ClearButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource color.state.searchFocusBg}" />
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================= window buttons -->

    <!--
        6.1: minimize, maximize and close, always in the controller colours,
        46 px wide and the full height of the title bar, with 18 px icons
        stroked at 2.6 on a 24-unit grid (about 1.95 px) with round ends.

        This restyles WPF-UI's own TitleBarButton rather than replacing it, so
        the title bar keeps its window-message handling - above all the
        maximize button's hit test, which is what opens Windows 11's snap
        layouts. The button colours its icon through RenderButtonsForeground
        and its hover through Background; both are driven from code inside
        WPF-UI, including the hover it fakes for the maximize button from
        non-client mouse messages, so the template binds to those.

        The CommandParameter setters are restated from WPF-UI's template, whose
        triggers are the only thing telling the shared command which button
        was pressed.

        Applied as an implicit style inside the title bar's resources; close's
        red hover comes from PaletteRedBrush, re-pointed there too, because
        WPF-UI's title-bar template sets it on that one button directly.
    -->
    <Style x:Key="theme.windowButton" TargetType="ui:TitleBarButton"
           BasedOn="{StaticResource {x:Type ui:TitleBarButton}}">
        <Setter Property="Width" Value="{theme:Token titleBar.windowButton.width}" />
        <Setter Property="Height" Value="{theme:Token layout.titleBarHeight}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:TitleBarButton">
                    <Grid Background="{TemplateBinding Background}">
                        <Viewbox Width="{theme:Token titleBar.windowButton.iconSize}"
                                 Height="{theme:Token titleBar.windowButton.iconSize}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="Glyph"
                                      Stroke="{TemplateBinding RenderButtonsForeground}"
                                      StrokeThickness="{theme:Token titleBar.windowButton.strokeOn24Grid}"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ButtonType" Value="Minimize">
                            <Setter Property="CommandParameter" Value="{x:Static ui:TitleBarButtonType.Minimize}" />
                            <Setter TargetName="Glyph" Property="Data" Value="M 5,12 H 19" />
                        </Trigger>
                        <Trigger Property="ButtonType" Value="Maximize">
                            <Setter Property="CommandParameter" Value="{x:Static ui:TitleBarButtonType.Maximize}" />
                            <Setter TargetName="Glyph" Property="Data"
                                    Value="M 7.5,5.5 H 16.5 A 2,2 0 0 1 18.5,7.5 V 16.5 A 2,2 0 0 1 16.5,18.5 H 7.5 A 2,2 0 0 1 5.5,16.5 V 7.5 A 2,2 0 0 1 7.5,5.5 Z" />
                        </Trigger>
                        <!-- Not in the mockup: the maximize square, smaller and moved
                             down-left, with a corner of a second one behind it. -->
                        <Trigger Property="ButtonType" Value="Restore">
                            <Setter Property="CommandParameter" Value="{x:Static ui:TitleBarButtonType.Restore}" />
                            <Setter TargetName="Glyph" Property="Data"
                                    Value="M 7.5,8.5 H 13.5 A 2,2 0 0 1 15.5,10.5 V 16.5 A 2,2 0 0 1 13.5,18.5 H 7.5 A 2,2 0 0 1 5.5,16.5 V 10.5 A 2,2 0 0 1 7.5,8.5 Z M 8.5,5.5 H 16.5 A 2,2 0 0 1 18.5,7.5 V 15.5" />
                        </Trigger>
                        <Trigger Property="ButtonType" Value="Close">
                            <Setter Property="CommandParameter" Value="{x:Static ui:TitleBarButtonType.Close}" />
                            <Setter TargetName="Glyph" Property="Data" Value="M 6,6 L 18,18 M 18,6 L 6,18" />
                        </Trigger>
                        <Trigger Property="ButtonType" Value="Help">
                            <Setter Property="CommandParameter" Value="{x:Static ui:TitleBarButtonType.Help}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- The names a screen reader speaks (spec 8); the template is a bare
             Path, so there is no content to take one from. -->
        <Style.Triggers>
            <Trigger Property="ButtonType" Value="Minimize">
                <Setter Property="ButtonsForeground" Value="{DynamicResource color.window.minimize}" />
                <Setter Property="MouseOverButtonsForeground" Value="{DynamicResource color.window.minimize}" />
                <Setter Property="AutomationProperties.Name" Value="Minimize" />
            </Trigger>
            <Trigger Property="ButtonType" Value="Maximize">
                <Setter Property="ButtonsForeground" Value="{DynamicResource color.window.maximize}" />
                <Setter Property="MouseOverButtonsForeground" Value="{DynamicResource color.window.maximize}" />
                <Setter Property="AutomationProperties.Name" Value="Maximize" />
            </Trigger>
            <Trigger Property="ButtonType" Value="Restore">
                <Setter Property="ButtonsForeground" Value="{DynamicResource color.window.maximize}" />
                <Setter Property="MouseOverButtonsForeground" Value="{DynamicResource color.window.maximize}" />
                <Setter Property="AutomationProperties.Name" Value="Restore" />
            </Trigger>
            <Trigger Property="ButtonType" Value="Close">
                <Setter Property="ButtonsForeground" Value="{DynamicResource color.window.close}" />
                <Setter Property="AutomationProperties.Name" Value="Close" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ====================================================== focus rings -->

    <!--
        8: keyboard focus is a 2 px accent.tealText outline (color.state.focusRing)
        2 px outside the control, as the mockup's outline-offset draws it. These
        are FocusVisualStyles, so WPF shows them only after keyboard input, never
        after a click, and draws them in the adorner layer, above the control.
        TokenResources builds the outset and the grown corners from focus.*.
        The list rows have none, at the user's request (session 5); the search
        box has its own teal ring (6.1), and the ARTISTS header its underline.
    -->
    <Style x:Key="theme.focusRing.circle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Ellipse Margin="{DynamicResource focus.ring.outset}"
                             Stroke="{DynamicResource color.state.focusRing}"
                             StrokeThickness="{theme:Token focus.ringWidth}"
                             SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="theme.focusRing.chip">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="{DynamicResource focus.ring.outset}"
                            BorderBrush="{DynamicResource color.state.focusRing}"
                            BorderThickness="{theme:Token focus.ringWidth}"
                            CornerRadius="{DynamicResource focus.ring.radius.chip}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The logo menu's ring sits just inside its 40 x 36 slot instead: WPF clips a
         focus outline to its control's ancestors, and the menu around the logo
         clips to the slot, so a ring outside it is cut away entirely. The slot
         is larger than the logo, so the ring still clears it. -->
    <Style x:Key="theme.focusRing.inside">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource color.state.focusRing}"
                            BorderThickness="{theme:Token focus.ringWidth}"
                            CornerRadius="{DynamicResource radius.chip}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A slider's ring goes round its whole sliderHitHeight strip, further
         out (focus.sliderRingOffset), as the mockup's .scrub outline does. -->
    <Style x:Key="theme.focusRing.slider">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="{DynamicResource focus.sliderRing.outset}"
                            BorderBrush="{DynamicResource color.state.focusRing}"
                            BorderThickness="{theme:Token focus.ringWidth}"
                            CornerRadius="{DynamicResource focus.sliderRing.radius}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================== playback bar -->

    <theme:ThumbOverhangConverter x:Key="theme.thumbOverhang" />

    <!-- Icon strokes on the 24-unit grid, as the mockup draws them, in the
         Foreground of the button they sit in. theme.iconFill also fills. -->
    <Style x:Key="theme.iconStroke" TargetType="Shape">
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
        <Setter Property="StrokeThickness" Value="{theme:Token playbackBar.iconStrokeOn24Grid}" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
    </Style>

    <Style x:Key="theme.iconFill" TargetType="Shape" BasedOn="{StaticResource theme.iconStroke}">
        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
    </Style>

    <Style x:Key="theme.iconSolid" TargetType="Shape">
        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
    </Style>

    <!--
        6.7: a round transport button with the molded look. Tag names the shadow
        token: shadow.controlButton for the 44 px buttons, shadow.playButton for
        Play/Pause. The icon is the content and draws in the button's
        Foreground. Hover brightens the face; pressed nudges the whole button
        down by playbackBar.pressedOffset.
    -->
    <Style x:Key="theme.transportButton" TargetType="ButtonBase">
        <Setter Property="Width" Value="{theme:Token playbackBar.buttonSize}" />
        <Setter Property="Height" Value="{theme:Token playbackBar.buttonSize}" />
        <Setter Property="Tag" Value="shadow.controlButton" />
        <Setter Property="Foreground" Value="{DynamicResource color.control.iconNeutral}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource theme.focusRing.circle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid x:Name="Root" Background="Transparent">
                        <theme:MoldedFace x:Name="Face"
                                          Face="{DynamicResource color.control.face}"
                                          Stroke="{DynamicResource color.control.faceBorder}"
                                          StrokeThickness="{theme:Token layout.panelBorder}"
                                          Shadow="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                          Effect="{DynamicResource shadow.controlButton}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="shadow.playButton">
                            <Setter TargetName="Face" Property="Effect" Value="{DynamicResource shadow.playButton}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Face" Value="{DynamicResource color.control.faceHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="{theme:Token playbackBar.pressedOffset}" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="theme.playButton" TargetType="ButtonBase" BasedOn="{StaticResource theme.transportButton}">
        <Setter Property="Width" Value="{theme:Token playbackBar.playButtonSize}" />
        <Setter Property="Height" Value="{theme:Token playbackBar.playButtonSize}" />
        <Setter Property="Tag" Value="shadow.playButton" />
        <Setter Property="Foreground" Value="{DynamicResource color.control.playPause}" />
    </Style>

    <!-- The speaker: the same hit area as a transport button, with no face.
         Round in the mockup, so its focus ring is a circle too. -->
    <Style x:Key="theme.bareIconButton" TargetType="ButtonBase">
        <Setter Property="Width" Value="{theme:Token playbackBar.volumeButton}" />
        <Setter Property="Height" Value="{theme:Token playbackBar.volumeButton}" />
        <Setter Property="Foreground" Value="{DynamicResource color.text.muted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource theme.focusRing.circle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The played portion: a rounded bar in the slider's Foreground, from the
         visible track's start to the handle's centre. -->
    <Style x:Key="theme.sliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="{theme:Token playbackBar.trackHeight}"
                                VerticalAlignment="Center"
                                Margin="{Binding Tag, RelativeSource={RelativeSource AncestorType=Slider}, Converter={StaticResource theme.thumbOverhang}, ConverterParameter=fill}"
                                CornerRadius="{DynamicResource radius.sliderTrack}"
                                Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="theme.sliderSpace" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        6.7: the seekbar and volume slider share this. A 6 px fully rounded
        track with a faint inset along the top, the played portion in the
        slider's Foreground, and a round handle whose size is the slider's Tag.
        The whole sliderHitHeight strip takes clicks. No BasedOn: WPF-UI's
        Slider style would bring its own template triggers.
    -->
    <Style x:Key="theme.slider" TargetType="Slider">
        <Setter Property="Height" Value="{theme:Token playbackBar.sliderHitHeight}" />
        <Setter Property="Tag" Value="{theme:Token playbackBar.seekThumb}" />
        <Setter Property="Foreground" Value="{DynamicResource color.slider.seekFill}" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource theme.focusRing.slider}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border Height="{theme:Token playbackBar.trackHeight}"
                                VerticalAlignment="Center"
                                Background="{DynamicResource color.slider.track}"
                                CornerRadius="{DynamicResource radius.sliderTrack}"
                                SnapsToDevicePixels="True">
                            <Border Height="{theme:Token shadow.sliderTrackInset.inset1.depth}"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource shadow.sliderTrackInset.inset1.fade}"
                                    CornerRadius="{DynamicResource radius.sliderTrack}" />
                        </Border>
                        <Track x:Name="PART_Track"
                               Margin="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource theme.thumbOverhang}}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource theme.sliderFill}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource theme.sliderSpace}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="{TemplateBinding Tag}" Height="{TemplateBinding Tag}">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{DynamicResource color.slider.thumb}"
                                                     Stroke="{DynamicResource color.slider.thumbBorder}"
                                                     StrokeThickness="{theme:Token layout.panelBorder}"
                                                     Effect="{DynamicResource shadow.sliderThumb}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================================= status bar -->

    <!--
        6.8: Refresh, Last.fm and Bit-Perfect. Chip grey, a 1 px border, 4 px
        corners, 26 px tall. Hover brightens the face like a transport button's.
    -->
    <Style x:Key="theme.chip" TargetType="ButtonBase">
        <Setter Property="Height" Value="{theme:Token statusBar.chipHeight}" />
        <Setter Property="Padding" Value="{theme:Thickness X=statusBar.chipPaddingX}" />
        <Setter Property="FontFamily" Value="{DynamicResource font.family}" />
        <Setter Property="FontSize" Value="{theme:Token type.status.size}" />
        <Setter Property="Foreground" Value="{DynamicResource color.text.status}" />
        <Setter Property="Background" Value="{DynamicResource color.status.chipBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource color.status.chipBorder}" />
        <Setter Property="BorderThickness" Value="{theme:Thickness All=layout.panelBorder}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource theme.focusRing.chip}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Chip"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource radius.chip}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource color.control.faceHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{theme:Token layout.disabledOpacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The 7 px status dot. -->
    <Style x:Key="theme.statusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="{theme:Token statusBar.dotSize}" />
        <Setter Property="Height" Value="{theme:Token statusBar.dotSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Scan progress: not in the spec. A thin neutral bar, not teal, which
         means playback (the user's call). -->
    <Style x:Key="theme.scanProgress" TargetType="ProgressBar">
        <Setter Property="Width" Value="{theme:Token statusBar.scanProgressWidth}" />
        <Setter Property="Height" Value="{theme:Token statusBar.scanProgressHeight}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border x:Name="PART_Track"
                            Background="{DynamicResource color.status.scanTrack}"
                            CornerRadius="{DynamicResource radius.sliderTrack}">
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource color.status.scanFill}"
                                CornerRadius="{DynamicResource radius.sliderTrack}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ============================================================================
        Session 5 polish: not in the spec, so each follows the nearest thing that is
        ============================================================================
    -->

    <!--
        The Songs panel with no album selected: the old theme's square outline and
        two lines, in the header's details style and the album meta style. The
        wording comes from EmptyStateText, so it doesn't say "pick an artist" when
        there is none to pick.
    -->
    <ControlTemplate x:Key="theme.emptyState" TargetType="Control">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="{theme:Token emptyState.squareSize}"
                    Height="{theme:Token emptyState.squareSize}"
                    HorizontalAlignment="Center"
                    BorderBrush="{DynamicResource color.text.muted}"
                    BorderThickness="{theme:Thickness All=emptyState.squareStroke}"
                    SnapsToDevicePixels="True" />
            <TextBlock Text="{Binding EmptyStateTitle}"
                       Style="{DynamicResource type.headerDetails}"
                       Margin="{theme:Thickness Top=emptyState.squareToTitleGap}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding EmptyStateDetail}"
                       Style="{DynamicResource type.albumMeta}"
                       Margin="{theme:Thickness Top=emptyState.titleToSublineGap}"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </ControlTemplate>

    <!--
        The box a song cell turns into while edited in place: the focused search
        box at row size (searchFocusBg, a teal line), in the column's own text
        style. A template of its own: WPF-UI's text box has padding and a minimum
        height that don't fit a 28 px row, and a bare style falls back to Aero's
        white box.
    -->
    <Style x:Key="theme.cellEditBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource font.family}" />
        <Setter Property="FontSize" Value="{DynamicResource type.tableCell.size}" />
        <Setter Property="Foreground" Value="{DynamicResource color.text.primary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource color.text.primary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource color.text.muted}" />
        <Setter Property="Background" Value="{DynamicResource color.state.searchFocusBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource color.state.searchFocusRing}" />
        <Setter Property="BorderThickness" Value="{theme:Thickness All=songTable.editBox.borderWidth}" />
        <Setter Property="Padding" Value="{theme:Thickness X=songTable.editBox.paddingX}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource radius.row}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Padding="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Style="{x:Null}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="theme.cellEditBox.title" TargetType="TextBox" BasedOn="{StaticResource theme.cellEditBox}">
        <Setter Property="FontSize" Value="{DynamicResource type.songTitle.size}" />
    </Style>

    <Style x:Key="theme.cellEditBox.number" TargetType="TextBox" BasedOn="{StaticResource theme.cellEditBox}">
        <Setter Property="FontSize" Value="{DynamicResource type.trackNumber.size}" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!--
        Tooltips, everywhere (dialogs included): a panel-styled box, 4 px
        corners, status-size text. Flat, like the panels, without WPF-UI's
        drop shadow.
    -->
    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="MaxWidth" Value="{DynamicResource popup.toolTipMaxWidth}" />
        <Setter Property="FontFamily" Value="{DynamicResource font.family}" />
        <Setter Property="FontSize" Value="{DynamicResource type.status.size}" />
        <Setter Property="FontWeight" Value="{DynamicResource type.status.weight.fontWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource color.text.primary}" />
        <Setter Property="Background" Value="{DynamicResource color.panel.bg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource color.panel.border}" />
        <Setter Property="BorderThickness" Value="{theme:Thickness All=layout.panelBorder}" />
        <Setter Property="Padding" Value="{theme:Thickness X=popup.toolTipPaddingX, Y=popup.toolTipPaddingY}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource radius.surface}"
                            Padding="{TemplateBinding Padding}"
                            MaxWidth="{TemplateBinding MaxWidth}">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Context menus: the same box. The items are WPF-UI's, recoloured by the
        MenuItem style below.
    -->
    <Style TargetType="ContextMenu" BasedOn="{StaticResource {x:Type ContextMenu}}">
        <Setter Property="Foreground" Value="{DynamicResource color.text.primary}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource color.text.primary}" />
        <Setter Property="Background" Value="{DynamicResource color.panel.bg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource color.panel.border}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{theme:Thickness All=layout.panelBorder}"
                            CornerRadius="{DynamicResource radius.surface}"
                            Padding="{theme:Thickness Y=popup.menuPaddingY}"
                            SnapsToDevicePixels="True">
                        <StackPanel ClipToBounds="True"
                                    IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle"
                                    Orientation="Vertical" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Menu items, in context menus and the logo menu's drop-downs. WPF-UI's
        templates stay (check marks, icons, submenus); the colours they read are
        restated here, in the style's own resources, so nothing outside menus
        changes. A highlighted item gets the selection grey, as list rows do. The
        drop-downs' corners are WPF-UI's (8 px): its templates fix them.
    -->
    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
        <Style.Resources>
            <SolidColorBrush x:Key="FlyoutBackground" Color="{StaticResource color.panel.bg.value}" />
            <SolidColorBrush x:Key="FlyoutBorderBrush" Color="{StaticResource color.panel.border.value}" />
            <SolidColorBrush x:Key="MenuBarItemBackgroundSelected" Color="{StaticResource color.state.selectionBg.value}" />
            <SolidColorBrush x:Key="MenuBarItemBackgroundPressed" Color="{StaticResource color.state.selectionBg.value}" />
            <SolidColorBrush x:Key="MenuBarItemTextForegroundPressed" Color="{StaticResource color.text.primary.value}" />
            <SolidColorBrush x:Key="MenuBarItemBorderBrush" Color="{StaticResource color.panel.divider.value}" />
        </Style.Resources>
        <Setter Property="Foreground" Value="{DynamicResource color.text.primary}" />
    </Style>

    <!--
        The logo itself: a title-bar button, so it hovers like Minimize and
        Maximize. Its drop-down and items use the menu item style above.
    -->
    <Style x:Key="theme.logoMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
        <Style.Resources>
            <SolidColorBrush x:Key="FlyoutBackground" Color="{StaticResource color.panel.bg.value}" />
            <SolidColorBrush x:Key="FlyoutBorderBrush" Color="{StaticResource color.panel.border.value}" />
            <SolidColorBrush x:Key="MenuBarItemBackgroundSelected" Color="{StaticResource color.window.buttonHover.value}" />
            <SolidColorBrush x:Key="MenuBarItemBackgroundPressed" Color="{StaticResource color.window.buttonHover.value}" />
            <SolidColorBrush x:Key="MenuBarItemBorderBrush" Color="{StaticResource color.panel.divider.value}" />
        </Style.Resources>
        <Setter Property="Foreground" Value="{DynamicResource color.text.primary}" />
    </Style>

</ResourceDictionary>
