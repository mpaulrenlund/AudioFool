<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Vista Aero Glass: translucent blue-tinted surfaces with a glossy sheen.
        Applied over WPF-UI's dark base; the Acrylic window backdrop supplies the
        blur that makes the semi-transparent panels read as glass.

        Two halves. The AudioFool tokens dress the app's own chrome - panes, the
        deck, cover slots, rows - and the WPF-UI keys below dress the stock
        controls. Before the design system existed this file only needed the
        second half, because the panes read WPF-UI's keys directly; they read
        tokens now, so the glass gradient has to be named twice. Same brush,
        two audiences.
    -->

    <!-- Panel and control backgrounds: glass gradient, bright highlight at top -->
    <LinearGradientBrush x:Key="AfSurfacePanel" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#5860A0E0" Offset="0"/>
        <GradientStop Color="#3848689E" Offset="0.5"/>
        <GradientStop Color="#4858889E" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ControlFillColorDefaultBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#5860A0E0" Offset="0"/>
        <GradientStop Color="#3848689E" Offset="0.5"/>
        <GradientStop Color="#4858889E" Offset="1"/>
    </LinearGradientBrush>

    <!-- A slightly brighter pane of the same glass for raised strips. -->
    <LinearGradientBrush x:Key="AfSurfaceRaised" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#6870B0F0" Offset="0"/>
        <GradientStop Color="#4858789E" Offset="1"/>
    </LinearGradientBrush>

    <!-- Secondary surfaces: album art placeholders, subdued elements -->
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#30606060" />
    <SolidColorBrush x:Key="AfSurfaceWell" Color="#30606060" />
    <SolidColorBrush x:Key="AfSurfaceRowSelected" Color="#30606060" />
    <SolidColorBrush x:Key="AfSurfaceRowHover" Color="#18FFFFFF" />

    <!-- Glass-edge borders: lighter, like refracted light at the edge of glass -->
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#6080B0E0" />
    <SolidColorBrush x:Key="AfStrokeRaised" Color="#6080B0E0" />
    <SolidColorBrush x:Key="AfStrokeInset" Color="#6080B0E0" />
    <SolidColorBrush x:Key="AfStrokeDivider" Color="#4080B0E0" />

    <!-- Slider rail -->
    <SolidColorBrush x:Key="SliderTrackFill" Color="#305878B0" />
    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#406888C0" />

    <!-- Slider thumb -->
    <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="#C06888A8" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="#FF5498D8" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FF68ACE8" />

</ResourceDictionary>
