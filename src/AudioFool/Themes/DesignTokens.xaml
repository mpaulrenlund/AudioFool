<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        ============================================================================
        AudioFool design tokens
        ============================================================================

        Every colour, size, radius, border, shadow, duration and easing the app's
        own chrome uses is named here. Screens and component styles reference these
        keys with DynamicResource; a theme overlay in this folder redefines the
        keys it wants to change and the whole app follows. Nothing else in the app
        should carry a literal colour or measurement.

        These defaults ARE the Dark theme. The colour values are the ones WPF-UI's
        dark dictionary resolves to at runtime (dumped from a live app rather than
        guessed), so pulling the app onto tokens left Dark looking exactly as it
        did. Where a value has no WPF-UI equivalent - the four accent colours, the
        texture and decor layers, the motion tokens - the default is the inert one:
        a neutral colour, a transparent brush, zero opacity. A theme that wants
        those effects opts in.

        Naming: Af<group><role>. Groups are Surface, Text, Accent, Status, Stroke,
        Space, Font, Radius, Icon, Focus and Duration.
    -->

    <!-- ======================================================== surfaces -->

    <!--
        Five depths. Shell is the window base, Panel is a pane body, Raised is a
        header strip or control face, Well is a recess content sits inside, and
        Overlay is a flyout or dialog above everything.

        Dark leaves Shell transparent on purpose: the Mica backdrop is the window
        base there, and painting over it would throw the effect away.
    -->
    <SolidColorBrush x:Key="AfSurfaceShell" Color="Transparent" />
    <SolidColorBrush x:Key="AfSurfacePanel" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="AfSurfaceRaised" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="AfSurfaceWell" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="AfSurfaceOverlay" Color="#FF2C2C2C" />

    <!-- A raised face under the pointer, and the same face pushed in. Pressed
         going darker than default is what makes a control feel like a key
         rather than a rectangle that changes colour. -->
    <SolidColorBrush x:Key="AfSurfaceRaisedHover" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="AfSurfaceRaisedPressed" Color="#08FFFFFF" />

    <!-- The mat behind an enlarged cover, so a light-edged image still reads as
         a distinct object. -->
    <SolidColorBrush x:Key="AfSurfaceMat" Color="#12000000" />

    <!-- Row states. Hover and selection are separate so a theme can make
         selection loud without making hover noisy. -->
    <SolidColorBrush x:Key="AfSurfaceRowHover" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="AfSurfaceRowSelected" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="AfSurfaceRowAlternate" Color="Transparent" />

    <!-- The track grid picks selection out with a flat grey rather than the
         WinUI accent; the accent fought the now-playing indicator. -->
    <SolidColorBrush x:Key="AfSurfaceTrackSelected" Color="#50A0A0A0" />

    <!-- ============================================================ text -->

    <SolidColorBrush x:Key="AfTextPrimary" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AfTextSecondary" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="AfTextTertiary" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="AfTextQuaternary" Color="#59FFFFFF" />
    <SolidColorBrush x:Key="AfTextDisabled" Color="#5DFFFFFF" />
    <SolidColorBrush x:Key="AfTextInverse" Color="#E4000000" />

    <!-- Placeholder glyph inside an empty cover slot. -->
    <SolidColorBrush x:Key="AfTextPlaceholder" Color="#59FFFFFF" />

    <!-- ========================================================== accents -->

    <!--
        Four accents, used by role rather than by taste:

          Blue    primary action, selection, active navigation
          Green   success, ready, connected
          Red     destructive, error, critical
          Yellow  caution, pending, metadata emphasis

        Fill is a background tint of the same hue; Text is the variant that still
        clears contrast requirements as small text on a dark surface.
    -->
    <SolidColorBrush x:Key="AfAccentBlue" Color="#FF2D7DFF" />
    <SolidColorBrush x:Key="AfAccentBlueFill" Color="#332D7DFF" />
    <SolidColorBrush x:Key="AfAccentBlueText" Color="#FF8FBBFF" />

    <SolidColorBrush x:Key="AfAccentGreen" Color="#FF37B86D" />
    <SolidColorBrush x:Key="AfAccentGreenFill" Color="#3337B86D" />
    <SolidColorBrush x:Key="AfAccentGreenText" Color="#FF7FDAA4" />

    <SolidColorBrush x:Key="AfAccentRed" Color="#FFE64B4B" />
    <SolidColorBrush x:Key="AfAccentRedFill" Color="#33E64B4B" />
    <SolidColorBrush x:Key="AfAccentRedText" Color="#FFF29A9A" />

    <SolidColorBrush x:Key="AfAccentYellow" Color="#FFE5B83E" />
    <SolidColorBrush x:Key="AfAccentYellowFill" Color="#33E5B83E" />
    <SolidColorBrush x:Key="AfAccentYellowText" Color="#FFEFD285" />

    <!-- =========================================================== status -->

    <!--
        Status colours are aliases of the accents, named for what they mean so a
        screen never has to decide that green means ready. Colour is never the
        only carrier: every component that uses one of these pairs it with text
        and with a shape - see the status lamp and the bit-perfect key in
        Ps1Theme.xaml, which change glyph as well as colour.
    -->
    <SolidColorBrush x:Key="AfStatusOk" Color="#FF37B86D" />
    <SolidColorBrush x:Key="AfStatusOkText" Color="#FF7FDAA4" />
    <SolidColorBrush x:Key="AfStatusCaution" Color="#FFE5B83E" />
    <SolidColorBrush x:Key="AfStatusCautionText" Color="#FFEFD285" />
    <SolidColorBrush x:Key="AfStatusDanger" Color="#FFE64B4B" />
    <SolidColorBrush x:Key="AfStatusDangerText" Color="#FFF29A9A" />
    <SolidColorBrush x:Key="AfStatusInfo" Color="#FF2D7DFF" />
    <SolidColorBrush x:Key="AfStatusInfoText" Color="#FF8FBBFF" />
    <SolidColorBrush x:Key="AfStatusIdle" Color="#8BFFFFFF" />

    <!--
        Solid variants, for a surface that is filled with the accent and carries
        text on top. The bright accents above are tuned to read as small text or
        a hairline against a dark panel, which makes them too light to put white
        text on; these are the same hues taken down until white clears 4.5:1.
    -->
    <SolidColorBrush x:Key="AfAccentBlueSolid" Color="#FF1F5FD0" />
    <SolidColorBrush x:Key="AfAccentGreenSolid" Color="#FF23844B" />
    <SolidColorBrush x:Key="AfAccentRedSolid" Color="#FFB23434" />
    <SolidColorBrush x:Key="AfAccentYellowSolid" Color="#FF8A6B14" />

    <!-- ========================================================== strokes -->

    <!--
        Panel and control edges. Raised runs light at the top and dark at the
        bottom so a surface reads as standing proud of its background; Inset is
        the same gradient upside down, for a recess. Both are absolute-mapped
        over 3px, so the bevel stays a hairline whatever the panel's height -
        the same trick WPF-UI's own elevation border uses.
    -->
    <LinearGradientBrush x:Key="AfStrokeRaised" StartPoint="0,0" EndPoint="0,3"
                         MappingMode="Absolute">
        <GradientStop Color="#18FFFFFF" Offset="0.33" />
        <GradientStop Color="#12FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AfStrokeInset" StartPoint="0,0" EndPoint="0,3"
                         MappingMode="Absolute">
        <GradientStop Color="#18FFFFFF" Offset="0.33" />
        <GradientStop Color="#12FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="AfStrokeDivider" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="AfStrokeSeam" Color="Transparent" />
    <SolidColorBrush x:Key="AfStrokeBevelHighlight" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="AfStrokeBevelShadow" Color="#12FFFFFF" />

    <!-- A warm hairline, for the moulding seam where two sections of a plastic
         chassis meet. Invisible unless a theme gives it a colour. -->
    <SolidColorBrush x:Key="AfStrokeWarm" Color="Transparent" />

    <Thickness x:Key="AfStrokeThin">1</Thickness>
    <Thickness x:Key="AfStrokeNone">0</Thickness>

    <!--
        Left marker on a selected row: the cue that stops selection being
        carried by tint alone. Transparent and zero-width by default, so Dark
        shows none of it.

        Two forms, because rows are styled two ways. AfSizeSelectionBar is the
        width of the marker element inside the row templates in this folder;
        AfStrokeSelectionBarThickness is a border thickness, for the track grid,
        whose rows are styled by properties rather than by template because
        their style also carries a context menu and an event handler.
    -->
    <SolidColorBrush x:Key="AfStrokeSelectionBar" Color="Transparent" />
    <sys:Double x:Key="AfSizeSelectionBar">0</sys:Double>
    <Thickness x:Key="AfStrokeSelectionBarThickness">0</Thickness>

    <!-- ========================================================== spacing -->

    <sys:Double x:Key="AfSpaceXxs">2</sys:Double>
    <sys:Double x:Key="AfSpaceXs">4</sys:Double>
    <sys:Double x:Key="AfSpaceSm">6</sys:Double>
    <sys:Double x:Key="AfSpaceMd">8</sys:Double>
    <sys:Double x:Key="AfSpaceLg">12</sys:Double>
    <sys:Double x:Key="AfSpaceXl">16</sys:Double>
    <sys:Double x:Key="AfSpaceXxl">24</sys:Double>

    <!-- Window-safe framing. The browser row runs to the window edges at the
         bottom because the deck below it supplies its own top margin. -->
    <Thickness x:Key="AfPadWindowBrowser">16,0,16,0</Thickness>
    <Thickness x:Key="AfPadWindowDeck">16,12,16,0</Thickness>
    <Thickness x:Key="AfPadWindowStatus">16,8,16,10</Thickness>

    <Thickness x:Key="AfPadPaneHeader">12,10,12,6</Thickness>
    <Thickness x:Key="AfPadAlbumHeader">12</Thickness>
    <Thickness x:Key="AfPadDeck">12</Thickness>

    <!-- The gap between a cover and the text beside it, at row and header size. -->
    <Thickness x:Key="AfPadBesideArt">10,0,0,0</Thickness>
    <Thickness x:Key="AfPadBesideArtLarge">16,0,0,0</Thickness>

    <!-- A small utility key, like the bit-perfect toggle in the status bar. -->
    <Thickness x:Key="AfPadUtilityKey">6,2</Thickness>
    <Thickness x:Key="AfPadRow">8,4</Thickness>
    <Thickness x:Key="AfPadRowMargin">0,2</Thickness>

    <!-- Track grid. Cell and header share their left inset so a column's values
         line up under its title whatever a theme does to either. -->
    <Thickness x:Key="AfPadGridCell">8,0</Thickness>
    <Thickness x:Key="AfPadGridHeader">8,5</Thickness>
    <Thickness x:Key="AfPadNumericCell">0,0,8,0</Thickness>

    <!-- Keeps list content clear of its own scrollbar. -->
    <Thickness x:Key="AfPadListInner">0,0,4,0</Thickness>

    <sys:Double x:Key="AfSizeTrackRowHeight">30</sys:Double>
    <sys:Double x:Key="AfSizeSplitter">6</sys:Double>

    <!-- Cover slots, largest to smallest. -->
    <sys:Double x:Key="AfSizeArtHeader">104</sys:Double>
    <sys:Double x:Key="AfSizeArtDeck">56</sys:Double>
    <sys:Double x:Key="AfSizeArtRow">48</sys:Double>

    <!-- Height of the title-bar identity mark. -->
    <sys:Double x:Key="AfSizeBrandMark">30</sys:Double>

    <!-- =========================================================== type -->

    <!--
        One UI family for everything readable, and a second for numeric
        readouts. Dark points both at the system UI font, so its numbers look
        exactly as they always have; a theme that wants tabular digits in the
        bitrate and timecode columns redefines AfFontMono alone.
    -->
    <FontFamily x:Key="AfFontUi">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="AfFontMono">Segoe UI Variable Text, Segoe UI</FontFamily>

    <sys:Double x:Key="AfFontSizeMicro">10</sys:Double>
    <sys:Double x:Key="AfFontSizeSmall">11</sys:Double>
    <sys:Double x:Key="AfFontSizeBody">12</sys:Double>
    <sys:Double x:Key="AfFontSizeStrong">13</sys:Double>
    <sys:Double x:Key="AfFontSizeSubtitle">16</sys:Double>
    <sys:Double x:Key="AfFontSizeTitle">24</sys:Double>

    <FontWeight x:Key="AfFontWeightNormal">Normal</FontWeight>
    <FontWeight x:Key="AfFontWeightMedium">Medium</FontWeight>
    <FontWeight x:Key="AfFontWeightSemiBold">SemiBold</FontWeight>

    <sys:Double x:Key="AfLineHeightBody">16</sys:Double>
    <sys:Double x:Key="AfLineHeightTitle">30</sys:Double>

    <!--
        Letter spacing. WPF has no tracking property, so Formatting.LetterSpacing
        inserts this string between characters and keeps the unspaced text as the
        control's automation name. Empty means no tracking, which is why Dark is
        unaffected. Only ever set on short static labels.
    -->
    <sys:String x:Key="AfTrackingLabel"></sys:String>

    <!-- ========================================================== radii -->

    <!-- Restrained by intention: a theme goes squarer, never rounder. -->
    <CornerRadius x:Key="AfRadiusNone">0</CornerRadius>
    <CornerRadius x:Key="AfRadiusControl">4</CornerRadius>
    <CornerRadius x:Key="AfRadiusWell">4</CornerRadius>
    <CornerRadius x:Key="AfRadiusPanel">8</CornerRadius>
    <CornerRadius x:Key="AfRadiusArt">6</CornerRadius>
    <CornerRadius x:Key="AfRadiusArtSmall">4</CornerRadius>

    <!-- ========================================================== icons -->

    <sys:Double x:Key="AfIconSizeMicro">11</sys:Double>
    <sys:Double x:Key="AfIconSizeSmall">16</sys:Double>
    <sys:Double x:Key="AfIconSizeMedium">20</sys:Double>
    <sys:Double x:Key="AfIconSizeLarge">22</sys:Double>
    <sys:Double x:Key="AfIconSizeHero">36</sys:Double>

    <!-- ========================================================== states -->

    <!-- How far a control dims when it is switched off. The whole control dims,
         not just its text: WPF-UI's disabled slider still draws an accent thumb,
         which reads as active. -->
    <sys:Double x:Key="AfOpacityDisabled">0.4</sys:Double>

    <!-- ================================================ depth and texture -->

    <!--
        Depth is drawn, not blurred: bevel gradients and seam lines cost one
        extra border each, where a drop shadow or a backdrop blur costs a render
        pass per panel. Texture and decor are off by default - a brush that
        paints nothing plus zero opacity - so no theme pays for an effect it
        does not use, and both layers only ever sit behind content.
    -->
    <SolidColorBrush x:Key="AfTextureBrush" Color="Transparent" />
    <sys:Double x:Key="AfTextureOpacity">0</sys:Double>

    <SolidColorBrush x:Key="AfGrainBrush" Color="Transparent" />
    <sys:Double x:Key="AfGrainOpacity">0</sys:Double>

    <SolidColorBrush x:Key="AfDecorBrush" Color="Transparent" />
    <sys:Double x:Key="AfDecorOpacity">0</sys:Double>

    <!-- ========================================================== focus -->

    <!--
        Keyboard focus is a ring, not a tint: a dark spacer under a bright
        outline, so it stays visible against both a selected row and a raised
        button face. The dash pattern is there for controls that draw a dotted
        focus rect inside their own bounds, the way a list has since Windows 95.
    -->
    <SolidColorBrush x:Key="AfFocusRing" Color="#FF79AFFF" />
    <SolidColorBrush x:Key="AfFocusRingSpacer" Color="Transparent" />
    <Thickness x:Key="AfFocusRingThickness">2</Thickness>
    <Thickness x:Key="AfFocusRingInset">1</Thickness>
    <CornerRadius x:Key="AfFocusRingRadius">4</CornerRadius>
    <DoubleCollection x:Key="AfFocusRingDash">2 2</DoubleCollection>

    <!-- ========================================================= motion -->

    <!--
        Short enough to feel like a response rather than a transition. Themes
        with animation load their storyboards from a separate dictionary, so
        turning motion off is a matter of not merging it - see ThemeService.
    -->
    <Duration x:Key="AfDurationFast">0:0:0.09</Duration>
    <Duration x:Key="AfDurationNormal">0:0:0.14</Duration>
    <Duration x:Key="AfDurationSlow">0:0:0.22</Duration>
    <Duration x:Key="AfDurationEntrance">0:0:0.45</Duration>

    <CubicEase x:Key="AfEaseOut" EasingMode="EaseOut" />
    <CubicEase x:Key="AfEaseInOut" EasingMode="EaseInOut" />
    <QuadraticEase x:Key="AfEaseIn" EasingMode="EaseIn" />

</ResourceDictionary>
