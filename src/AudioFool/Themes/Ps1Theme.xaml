<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:fmt="clr-namespace:AudioFool.Formatting"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        ============================================================================
        PS1
        ============================================================================

        The original grey PlayStation console as a piece of 1990s consumer
        electronics: warm moulded-plastic greys, crisp 1px outlines, understated
        bevels, compact spacing, and the controller's colours used as sparse,
        semantic punctuation.

        The PS1 grey is the primary surface, not a supporting colour. The bright
        controller colours are semantic punctuation, not the theme's dominant
        visual treatment.

        Palette. Five neutrals carry the whole interface:

          shell     #A7A4A3   window base, gutters, title and status strips
          surface   #B6B3B1   raised panels, cards, keys
          recessed  #999593   inputs, slider and progress tracks, art mats
          shadow    #656362   outlines, dividers, neutral fills
          ink       #242424   text and icons

        These are the brief's greys (#C5C1C0, #D6D2D0, #AAA6A4, #777473) taken
        about 15% darker at the user's request; the recess only 10%, so ink on
        it still clears 4.5:1.

        and four accents, each with one job and a short list of places it may
        appear. One accent per component:

          triangle  #00AC9F   playing: the playing row's mark, the seek bar's
                              travelled part, the ready lamp, Bit-Perfect on,
                              and the transport key while it shows Play
          cross     #2E6DB4   links
          yellow    #F3C300   the scanning lamp and scan progress bar,
                              Last.fm "waiting"
          circle    #DF0024   the transport key while it shows Pause, error
                              text, Last.fm "reconnect"

        The pane labels (ARTISTS, ALBUMS, the album title) carry no mark: the
        user had the controller-shape marks removed.

        The Play/Pause key is the one place an accent is a fill: a small key,
        like a controller's face button, outlined in ink. The
        square colour is not used, at the user's request.

        Contrast (WCAG, measured). Ink is 6.3:1 on the shell, 7.4:1 on the
        surface and 5.2:1 in a recess; secondary text 5.1:1 and 6.0:1, and 4.7:1
        on a selected row. Recessed regions carry ink only. The accents are close
        in brightness to these greys - green is 1.0-1.4:1, so it reads by hue
        alone - which is why every accent mark has an ink keyline, and every
        state also has a shape or a word. Accent text uses darkened variants
        that clear 4.5:1 on the shell. On the keys: ink on green 5.5:1, light on
        red 4.2:1.

        WPF-UI. ThemeService runs this theme on WPF-UI's Light base dictionary,
        so any stock key not restated below is already a light value rather than
        white-on-grey. The WPF-UI section at the end re-points the keys its
        controls read, at both levels it has: the shared palette
        (ControlFillColorDefaultBrush and friends) and the per-control keys
        (ButtonBackground, TextControlBackground, ContextMenuBackground...).
    -->

    <!-- ===================================================== primitives -->

    <Color x:Key="Ps1Shell">#FFA7A4A3</Color>
    <Color x:Key="Ps1Surface">#FFB6B3B1</Color>
    <Color x:Key="Ps1Recessed">#FF999593</Color>
    <Color x:Key="Ps1Shadow">#FF656362</Color>
    <Color x:Key="Ps1Ink">#FF242424</Color>

    <!-- Shapes on a 10x10 box, for status marks. Defined before first use so the
         templates below can reach them with StaticResource. -->
    <EllipseGeometry x:Key="Ps1Circle" Center="5,5" RadiusX="3.5" RadiusY="3.5" />
    <PathGeometry x:Key="Ps1Triangle" Figures="M 5,1.3 L 9,8.4 L 1,8.4 Z" />
    <PathGeometry x:Key="Ps1Play" Figures="M 2.2,1 L 9,5 L 2.2,9 Z" />
    <PathGeometry x:Key="Ps1Square" Figures="M 1.5,1.5 L 8.5,1.5 L 8.5,8.5 L 1.5,8.5 Z" />

    <!-- ======================================================== surfaces -->

    <SolidColorBrush x:Key="AfSurfaceShell" Color="#FFA7A4A3" />
    <SolidColorBrush x:Key="AfSurfacePanel" Color="#FFB6B3B1" />
    <SolidColorBrush x:Key="AfSurfaceRaised" Color="#FFB6B3B1" />
    <SolidColorBrush x:Key="AfSurfaceRaisedHover" Color="#FFBDB9B8" />
    <SolidColorBrush x:Key="AfSurfaceRaisedPressed" Color="#FFA19D9C" />
    <SolidColorBrush x:Key="AfSurfaceWell" Color="#FF999593" />
    <SolidColorBrush x:Key="AfSurfaceOverlay" Color="#FFB6B3B1" />
    <SolidColorBrush x:Key="AfSurfaceMat" Color="#FF999593" />

    <!-- Row states are all neutral, and selection is a darker grey. The track
         grid's band is 8 levels under the panel; its hover sits between the
         band and selection, so hovering a banded row still darkens it. -->
    <SolidColorBrush x:Key="AfSurfaceRowHover" Color="#FFAEABA9" />
    <SolidColorBrush x:Key="AfSurfaceRowSelected" Color="#FFA19D9C" />
    <SolidColorBrush x:Key="AfSurfaceRowAlternate" Color="#FFAEABA9" />
    <SolidColorBrush x:Key="AfSurfaceTrackHover" Color="#FFA8A5A3" />
    <SolidColorBrush x:Key="AfSurfaceTrackSelected" Color="#FFA19D9C" />

    <!-- ============================================================ text -->

    <SolidColorBrush x:Key="AfTextPrimary" Color="#FF242424" />
    <SolidColorBrush x:Key="AfTextSecondary" Color="#FF353332" />
    <SolidColorBrush x:Key="AfTextTertiary" Color="#FF3B3938" />

    <!-- Ornament only: placeholder glyphs and empty-state line art. -->
    <SolidColorBrush x:Key="AfTextQuaternary" Color="#FF7A7675" />
    <SolidColorBrush x:Key="AfTextPlaceholder" Color="#FF5E5B5A" />

    <SolidColorBrush x:Key="AfTextDisabled" Color="#FF6A6766" />
    <SolidColorBrush x:Key="AfTextInverse" Color="#FFEEEBE9" />

    <!-- ========================================================= accents -->

    <!--
        Bright is the token colour, for marks and hairlines. Text is darkened
        until it clears 4.5:1 on the surface. Solid carries light text. Fill is a
        faint tint, kept only because shared code may ask for it.
    -->
    <SolidColorBrush x:Key="AfAccentBlue" Color="#FF2E6DB4" />
    <SolidColorBrush x:Key="AfAccentBlueFill" Color="#1F2E6DB4" />
    <SolidColorBrush x:Key="AfAccentBlueText" Color="#FF143860" />
    <SolidColorBrush x:Key="AfAccentBlueSolid" Color="#FF2E6DB4" />

    <SolidColorBrush x:Key="AfAccentGreen" Color="#FF00AC9F" />
    <SolidColorBrush x:Key="AfAccentGreenFill" Color="#1F00AC9F" />
    <SolidColorBrush x:Key="AfAccentGreenText" Color="#FF004A44" />
    <SolidColorBrush x:Key="AfAccentGreenSolid" Color="#FF00776E" />

    <SolidColorBrush x:Key="AfAccentRed" Color="#FFDF0024" />
    <SolidColorBrush x:Key="AfAccentRedFill" Color="#1FDF0024" />
    <SolidColorBrush x:Key="AfAccentRedText" Color="#FF7A0015" />
    <SolidColorBrush x:Key="AfAccentRedSolid" Color="#FFB3001D" />

    <SolidColorBrush x:Key="AfAccentYellow" Color="#FFF3C300" />
    <SolidColorBrush x:Key="AfAccentYellowFill" Color="#1FF3C300" />
    <SolidColorBrush x:Key="AfAccentYellowText" Color="#FF463700" />
    <SolidColorBrush x:Key="AfAccentYellowSolid" Color="#FF463700" />

    <SolidColorBrush x:Key="AfStatusOk" Color="#FF00AC9F" />
    <!-- Ink, not a green: "complete" in Statistics is a word, not a playback
         state, and green is kept for playing. -->
    <SolidColorBrush x:Key="AfStatusOkText" Color="#FF242424" />
    <SolidColorBrush x:Key="AfStatusCaution" Color="#FFF3C300" />
    <SolidColorBrush x:Key="AfStatusCautionText" Color="#FF463700" />
    <SolidColorBrush x:Key="AfStatusDanger" Color="#FFDF0024" />
    <SolidColorBrush x:Key="AfStatusDangerText" Color="#FF7A0015" />
    <SolidColorBrush x:Key="AfStatusInfo" Color="#FF2E6DB4" />
    <SolidColorBrush x:Key="AfStatusInfoText" Color="#FF143860" />
    <SolidColorBrush x:Key="AfStatusIdle" Color="#FF837F7F" />

    <SolidColorBrush x:Key="AfStatusKeyline" Color="#FF242424" />
    <sys:Double x:Key="AfStatusKeylineThickness">1</sys:Double>

    <!-- Shuffle and repeat: the glyph says on or off, in ink. No accent. -->
    <SolidColorBrush x:Key="AfStateQueue" Color="#FF242424" />
    <SolidColorBrush x:Key="AfSliderSeekFill" Color="#FF00AC9F" />
    <SolidColorBrush x:Key="AfStatBarCaution" Color="#FF656362" />

    <!-- ========================================================= strokes -->

    <!-- Solid, not the 3px bevel gradients the dark themes use: a 1px shadow
         outline, with the raised look drawn as a separate highlight line inside
         the templates below. -->
    <SolidColorBrush x:Key="AfStrokeRaised" Color="#FF656362" />
    <SolidColorBrush x:Key="AfStrokeInset" Color="#FF656362" />
    <SolidColorBrush x:Key="AfStrokeDivider" Color="#FF8F8B8A" />
    <SolidColorBrush x:Key="AfStrokeSeam" Color="#FF656362" />
    <SolidColorBrush x:Key="AfStrokeBevelHighlight" Color="#FFC6C3C2" />
    <SolidColorBrush x:Key="AfStrokeBevelShadow" Color="#FF837F7F" />

    <!-- No selection marker anywhere: the grey row is the selection. The user
         had the blue bar on the selected artist and album removed, and the
         track grid never had one - a grid row can also be playing (green), and
         the ink keyboard-focus bar was distracting. AfStrokeSelectionBar and
         AfSizeSelectionBar keep their inert defaults. -->
    <Thickness x:Key="AfStrokeSelectionBarThickness">0</Thickness>
    <SolidColorBrush x:Key="AfStrokeTrackSelectionBar" Color="Transparent" />

    <!-- ================================================= spacing, density -->

    <Thickness x:Key="AfPadWindowBrowser">12,0,12,0</Thickness>
    <Thickness x:Key="AfPadWindowDeck">12,10,12,0</Thickness>
    <Thickness x:Key="AfPadWindowStatus">12,6,12,8</Thickness>

    <Thickness x:Key="AfPadPaneHeader">10,6,10,6</Thickness>
    <Thickness x:Key="AfPadAlbumHeader">10</Thickness>
    <Thickness x:Key="AfPadDeck">10</Thickness>
    <Thickness x:Key="AfPadRow">8,3</Thickness>
    <Thickness x:Key="AfPadRowMargin">0,1</Thickness>

    <sys:Double x:Key="AfSizeTrackRowHeight">27</sys:Double>

    <!-- =========================================================== radii -->

    <CornerRadius x:Key="AfRadiusControl">2</CornerRadius>
    <CornerRadius x:Key="AfRadiusWell">2</CornerRadius>
    <CornerRadius x:Key="AfRadiusPanel">3</CornerRadius>
    <CornerRadius x:Key="AfRadiusArt">2</CornerRadius>
    <CornerRadius x:Key="AfRadiusArtSmall">1</CornerRadius>
    <CornerRadius x:Key="AfFocusRingRadius">2</CornerRadius>

    <!-- ============================================================ type -->

    <!-- The system face throughout, numbers included: tabular figures (set on
         the numeric styles below) keep columns aligned without a monospaced
         font. Pane labels keep a little tracking, like a printed legend. -->
    <sys:String x:Key="AfTrackingLabel" xml:space="preserve">&#x200A;</sys:String>

    <!-- =========================================================== focus -->

    <!-- Ink, not an accent: focus is not one of the four states. -->
    <SolidColorBrush x:Key="AfFocusRing" Color="#FF242424" />
    <SolidColorBrush x:Key="AfFocusRingSpacer" Color="Transparent" />

    <!-- No ring on a focused artist or album row, at the user's request: the
         grey selection is enough. Buttons and dialogs keep theirs. -->
    <Thickness x:Key="AfBrowserRowFocusInset">0</Thickness>

    <!-- ====================================================== typography -->

    <Style x:Key="AfPaneHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AfFontSizeMicro}" />
        <Setter Property="FontWeight" Value="{DynamicResource AfFontWeightSemiBold}" />
        <Setter Property="Foreground" Value="{DynamicResource AfTextTertiary}" />
        <Setter Property="Margin" Value="{DynamicResource AfPadPaneHeader}" />
        <Setter Property="fmt:LetterSpacing.Spacer" Value="{DynamicResource AfTrackingLabel}" />
    </Style>

    <Style x:Key="AfNumericCell" TargetType="TextBlock">
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="{DynamicResource AfPadNumericCell}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <Style x:Key="AfReadout" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AfFontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource AfTextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- =========================================================== panes -->

    <!--
        A raised panel: surface grey, a 1px shadow outline, and a 1px highlight
        just inside the top edge - the light catching the moulded lip. The
        header strip is the same grey, separated from the body by a divider.
    -->
    <Style x:Key="AfPane" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="{DynamicResource AfSurfacePanel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AfStrokeSeam}" />
        <Setter Property="BorderThickness" Value="{DynamicResource AfStrokeThin}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource AfRadiusPanel}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <DockPanel>
                                <Border x:Name="HeaderStrip"
                                        DockPanel.Dock="Top"
                                        BorderBrush="{DynamicResource AfStrokeDivider}"
                                        BorderThickness="0,0,0,1"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter ContentSource="Header" />
                                </Border>
                                <ContentPresenter />
                            </DockPanel>
                            <Border Height="1" VerticalAlignment="Top" Margin="1,0"
                                    Background="{DynamicResource AfStrokeBevelHighlight}"
                                    IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="HeaderStrip" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The track pane: the same panel. No texture or decoration here. -->
    <Style x:Key="AfPaneDisplay" TargetType="HeaderedContentControl"
           BasedOn="{StaticResource AfPane}" />

    <!-- The transport deck: the same raised panel, padded. -->
    <Style x:Key="AfDeck" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="{DynamicResource AfSurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AfStrokeSeam}" />
        <Setter Property="BorderThickness" Value="{DynamicResource AfStrokeThin}" />
        <Setter Property="Padding" Value="{DynamicResource AfPadDeck}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource AfRadiusPanel}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                            <Border Height="1" VerticalAlignment="Top" Margin="1,0"
                                    Background="{DynamicResource AfStrokeBevelHighlight}"
                                    IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cover slots are recessed: the disc window in the lid. -->
    <Style x:Key="AfArtFrame" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AfSurfaceMat}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AfStrokeInset}" />
        <Setter Property="BorderThickness" Value="{DynamicResource AfStrokeThin}" />
        <Setter Property="CornerRadius" Value="{DynamicResource AfRadiusArtSmall}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="AfArtFrameLarge" TargetType="Border" BasedOn="{StaticResource AfArtFrame}">
        <Setter Property="CornerRadius" Value="{DynamicResource AfRadiusArt}" />
    </Style>

    <!-- ======================================================= track grid -->

    <!-- Column titles on the panel grey with a divider under them. Property
         setters only, so the stock header keeps its sort arrow and grips. -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource AfSurfacePanel}" />
        <Setter Property="Foreground" Value="{DynamicResource AfTextSecondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AfStrokeDivider}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="SeparatorBrush" Value="{DynamicResource AfStrokeDivider}" />
        <Setter Property="SeparatorVisibility" Value="Visible" />
        <Setter Property="FontSize" Value="{DynamicResource AfFontSizeSmall}" />
        <Setter Property="FontWeight" Value="{DynamicResource AfFontWeightSemiBold}" />
        <Setter Property="Padding" Value="{DynamicResource AfPadGridHeader}" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Cells paint nothing; the row owns selection and focus. -->
    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource AfTextSecondary}" />
        <Setter Property="Padding" Value="{DynamicResource AfPadGridCell}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The playing row: a small green play mark with an ink keyline. -->
    <ControlTemplate x:Key="AfNowPlayingGlyph" TargetType="Control">
        <Path Data="{StaticResource Ps1Play}"
              Width="9" Height="9"
              Stretch="Uniform"
              Fill="{DynamicResource AfStatusOk}"
              Stroke="{DynamicResource AfStatusKeyline}"
              StrokeThickness="1"
              StrokeLineJoin="Round"
              SnapsToDevicePixels="True" />
    </ControlTemplate>

    <!-- ========================================================== slider -->

    <!--
        A recessed rail with a raised grey key for a thumb. The travelled part
        is the slider's Foreground: shadow grey by default (volume), and the
        seek bar sets the playing green through AfSliderSeekFill. The rail is
        inset by the thumb's half-width so no end cap shows past it.

        The repeat buttons need Style={x:Null} as well as OverridesDefaultStyle:
        WPF-UI's implicit RepeatButton style still applies without it, and it
        collapses the travelled segment to zero width.
    -->
    <Style x:Key="AfSlider" TargetType="Slider">
        <Setter Property="Foreground" Value="{DynamicResource AfStrokeSeam}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="Root" VerticalAlignment="Center" Height="20">
                        <Border Height="6" Margin="5,0"
                                Background="{DynamicResource AfSurfaceWell}"
                                BorderBrush="{DynamicResource AfStrokeSeam}"
                                BorderThickness="1"
                                CornerRadius="1"
                                SnapsToDevicePixels="True" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Focusable="False" IsTabStop="False"
                                              Style="{x:Null}" OverridesDefaultStyle="True"
                                              Foreground="{TemplateBinding Foreground}">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid Background="Transparent">
                                                <Border Height="4" Margin="6,0,0,0"
                                                        HorizontalAlignment="Stretch"
                                                        Background="{TemplateBinding Foreground}"
                                                        SnapsToDevicePixels="True" />
                                            </Grid>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Focusable="False" IsTabStop="False"
                                              Style="{x:Null}" OverridesDefaultStyle="True">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Thumb"
                                       Height="16" Width="10"
                                       OverridesDefaultStyle="True"
                                       SnapsToDevicePixels="True"
                                       Background="{DynamicResource AfSurfaceRaised}">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{DynamicResource AfStrokeSeam}"
                                                    BorderThickness="1"
                                                    CornerRadius="{DynamicResource AfRadiusControl}"
                                                    SnapsToDevicePixels="True">
                                                <Grid>
                                                    <Border Height="1" VerticalAlignment="Top"
                                                            Background="{DynamicResource AfStrokeBevelHighlight}" />
                                                    <Border Width="1" Height="6"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource AfTextSecondary}" />
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>

                        <Border x:Name="FocusRing"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"
                                BorderBrush="{DynamicResource AfFocusRing}"
                                BorderThickness="{DynamicResource AfFocusRingInset}"
                                CornerRadius="{DynamicResource AfFocusRingRadius}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Thumb" Property="Background"
                                    Value="{DynamicResource AfSurfaceRaisedHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity"
                                    Value="{DynamicResource AfOpacityDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================== transport keys -->

    <!--
        The one place accents are fills: three small keys, like a controller's
        face buttons, each outlined in ink. Play/Pause is green while it shows
        Play and red while it shows Pause. Ink glyph on green; light on red
        (4.2:1), where ink would only reach 3.1:1.

        The colours are set in triggers rather than plain setters: WPF-UI's base
        style sets its Appearance colours in triggers, and a base style's trigger
        outranks a derived style's setter. A derived trigger, defined later, wins.
        Disabled keeps WPF-UI's grey disabled face.

        Appearance is Secondary, not Primary: WPF-UI colours a Primary button in
        its template's own triggers, which no style can override.
    -->
    <Style x:Key="AfPlayKey" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Secondary" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="True">
                <Setter Property="Background" Value="#FF00AC9F" />
                <Setter Property="MouseOverBackground" Value="#FF1DBDB0" />
                <Setter Property="PressedBackground" Value="#FF00968A" />
                <Setter Property="Foreground" Value="#FF242424" />
                <Setter Property="PressedForeground" Value="#FF242424" />
                <Setter Property="BorderBrush" Value="#FF242424" />
                <Setter Property="MouseOverBorderBrush" Value="#FF242424" />
                <Setter Property="PressedBorderBrush" Value="#FF242424" />
            </Trigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsPlaying}" Value="True" />
                    <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="#FFDF0024" />
                <Setter Property="MouseOverBackground" Value="#FFE8203F" />
                <Setter Property="PressedBackground" Value="#FFB8001E" />
                <Setter Property="Foreground" Value="#FFEEEBE9" />
                <Setter Property="PressedForeground" Value="#FFEEEBE9" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Previous and Next are plain grey keys: no AfSkipKey here, so they use
         the neutral default from Components.xaml. They were yellow for a round;
         the user preferred them without colour. -->

    <!-- ======================================================== progress -->

    <!-- The scan bar: recessed track, yellow fill (scanning, like the lamp beside the status text), ink outline, no animation. -->
    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource AfSurfaceWell}" />
        <Setter Property="Foreground" Value="{DynamicResource AfAccentYellow}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AfStatusKeyline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="HorizontalAlignment"
                                    Value="Stretch" />
                            <Setter TargetName="PART_Indicator" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================== toggle -->

    <!--
        The Bit-Perfect key. Three cues for one state, none of them colour on
        its own: the key sits in rather than proud, the lamp lights green, and
        the word beside it changes from OFF to ON. That matters here - engaging
        it silences every other application on the machine.
    -->
    <Style TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource AfTextSecondary}" />
        <Setter Property="FontSize" Value="{DynamicResource AfFontSizeSmall}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root">
                        <Border x:Name="Face"
                                Background="{DynamicResource AfSurfaceRaised}"
                                BorderBrush="{DynamicResource AfStrokeSeam}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource AfRadiusControl}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="Highlight" Height="1" VerticalAlignment="Top"
                                        Background="{DynamicResource AfStrokeBevelHighlight}" />
                                <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
                                    <Border x:Name="Lamp"
                                            Width="7" Height="7"
                                            VerticalAlignment="Center"
                                            Margin="0,0,6,0"
                                            Background="{DynamicResource AfStatusIdle}"
                                            BorderBrush="{DynamicResource AfStrokeSeam}"
                                            BorderThickness="1"
                                            SnapsToDevicePixels="True" />
                                    <ContentPresenter VerticalAlignment="Center" />
                                    <TextBlock x:Name="State"
                                               Text="OFF"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="{DynamicResource AfFontSizeMicro}"
                                               FontWeight="{DynamicResource AfFontWeightSemiBold}"
                                               Foreground="{DynamicResource AfTextTertiary}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="FocusRing"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"
                                Margin="-2"
                                BorderBrush="{DynamicResource AfFocusRing}"
                                BorderThickness="{DynamicResource AfFocusRingThickness}"
                                CornerRadius="{DynamicResource AfFocusRingRadius}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background"
                                    Value="{DynamicResource AfSurfaceRaisedHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background"
                                    Value="{DynamicResource AfSurfaceRaisedPressed}" />
                            <Setter TargetName="Highlight" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Face" Property="Background"
                                    Value="{DynamicResource AfSurfaceRaisedPressed}" />
                            <Setter TargetName="Highlight" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Lamp" Property="Background"
                                    Value="{DynamicResource AfStatusOk}" />
                            <Setter TargetName="Lamp" Property="BorderBrush"
                                    Value="{DynamicResource AfStatusKeyline}" />
                            <Setter TargetName="State" Property="Text" Value="ON" />
                            <Setter TargetName="State" Property="Foreground"
                                    Value="{DynamicResource AfTextPrimary}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource AfTextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity"
                                    Value="{DynamicResource AfOpacityDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================== themed slots -->

    <!-- The shell: plain PS1 grey behind every pixel of the window. -->
    <ControlTemplate x:Key="AfWindowDecor" TargetType="Control">
        <Border Background="{DynamicResource AfSurfaceShell}" IsHitTestVisible="False" />
    </ControlTemplate>

    <!--
        Library state in the status bar. Shape, colour and the words beside it
        change together: a grey circle when idle, a green circle when the output
        is live, a yellow triangle while scanning. Accent shapes get the ink
        keyline so they read against the grey.
    -->
    <ControlTemplate x:Key="AfStatusLamp" TargetType="Control">
        <Grid Width="12" Height="12" Margin="0,0,6,0" ToolTip="{Binding StatusText}">
            <Path x:Name="Idle"
                  Data="{StaticResource Ps1Circle}"
                  Fill="{DynamicResource AfStatusIdle}"
                  Stroke="{DynamicResource AfStrokeSeam}"
                  StrokeThickness="1"
                  Stretch="Uniform" Margin="1.5" />
            <Path x:Name="Ready"
                  Data="{StaticResource Ps1Circle}"
                  Fill="{DynamicResource AfStatusOk}"
                  Stroke="{DynamicResource AfStatusKeyline}"
                  StrokeThickness="1"
                  Stretch="Uniform" Margin="1.5"
                  Visibility="Collapsed" />
            <Path x:Name="Busy"
                  Data="{StaticResource Ps1Triangle}"
                  Fill="{DynamicResource AfStatusCaution}"
                  Stroke="{DynamicResource AfStatusKeyline}"
                  StrokeThickness="1"
                  StrokeLineJoin="Round"
                  Stretch="Uniform" Margin="0.5"
                  Visibility="Collapsed" />
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsOutputActive}" Value="True">
                <Setter TargetName="Idle" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Ready" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsScanning}" Value="True">
                <Setter TargetName="Idle" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Ready" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Busy" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Nothing selected yet: a square outline and two lines of text. -->
    <ControlTemplate x:Key="AfEmptyState" TargetType="Control">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Path Data="{StaticResource Ps1Square}"
                  Stroke="{DynamicResource AfTextQuaternary}"
                  StrokeThickness="0.6"
                  Width="44" Height="44"
                  Stretch="Uniform"
                  HorizontalAlignment="Center" />
            <TextBlock Text="No album selected"
                       Margin="0,16,0,0"
                       HorizontalAlignment="Center"
                       FontSize="{DynamicResource AfFontSizeBody}"
                       Foreground="{DynamicResource AfTextSecondary}" />
            <TextBlock Text="Pick an artist, then one of their albums."
                       Margin="0,4,0,0"
                       HorizontalAlignment="Center"
                       FontSize="{DynamicResource AfFontSizeSmall}"
                       Foreground="{DynamicResource AfTextTertiary}" />
        </StackPanel>
    </ControlTemplate>

