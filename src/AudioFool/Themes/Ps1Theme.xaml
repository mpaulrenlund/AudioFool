<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:fmt="clr-namespace:AudioFool.Formatting"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        ============================================================================
        PS1
        ============================================================================

        A first-generation PlayStation reading of the app: grey moulded plastic,
        dark recessed wells where content lives, hairline bevels, square corners,
        and four saturated accents used strictly by role. It is an original design
        in that idiom, not a copy of any console screen - no BIOS, memory-card or
        disc-player interface is reproduced here.

        Where the personality lives:

          - Chassis, not cards. Panels are moulded plastic with a light top edge
            and a dark bottom edge, separated by dark seams. Nothing is rounded
            past 2px and nothing is blurred.
          - The four face-button shapes carry status. Circle is ready, triangle
            is caution, cross is error, square is information - always beside the
            word, never instead of it.
          - Numbers are monospaced. Bitrate, depth, sample rate and timecodes read
            as instrumentation, and the digits stop shifting as they change.
          - The track list is the display: the one surface with texture behind it.
            Everything else is opaque plastic.

        What it deliberately is not: a CRT filter, a pixel-art skin, or an
        emulator front end. Texture never sits over text, nothing loops, and no
        effect costs a render pass - depth is drawn with borders.

        This dictionary is merged over WPF-UI's dark base, so it works on two
        levels. It redefines AudioFool's own tokens and components, and it
        redefines the WPF-UI keys that the stock controls resolve at runtime, so
        buttons, menus, scrollbars, text boxes and tooltips follow without any of
        them needing a hand-written template.
    -->

    <!-- ==================================================== shape glyphs -->

    <!--
        The four face-button shapes on a 10x10 box. Kept here rather than in
        DesignTokens because they are this theme's vocabulary, and defined before
        first use so the templates below can reach them with StaticResource - a
        merged dictionary cannot StaticResource a sibling dictionary's key.
    -->
    <EllipseGeometry x:Key="Ps1Circle" Center="5,5" RadiusX="3.5" RadiusY="3.5" />
    <PathGeometry x:Key="Ps1Triangle" Figures="M 5,1.1 L 9.3,8.6 L 0.7,8.6 Z" />
    <PathGeometry x:Key="Ps1Square" Figures="M 1.5,1.5 L 8.5,1.5 L 8.5,8.5 L 1.5,8.5 Z" />
    <PathGeometry x:Key="Ps1Cross" Figures="M 1.5,1.5 L 8.5,8.5 M 8.5,1.5 L 1.5,8.5" />

    <!-- ======================================================== surfaces -->

    <!--
        Five depths of moulded grey. Shell is opaque here, unlike Dark: the theme
        wants a hardware surface rather than the desktop showing through, so
        ThemeService turns the window backdrop off for PS1.
    -->
    <SolidColorBrush x:Key="AfSurfaceShell" Color="#FF0E0F11" />
    <SolidColorBrush x:Key="AfSurfacePanel" Color="#FF1E2023" />
    <SolidColorBrush x:Key="AfSurfaceRaised" Color="#FF2A2C30" />
    <SolidColorBrush x:Key="AfSurfaceRaisedHover" Color="#FF34373C" />
    <SolidColorBrush x:Key="AfSurfaceRaisedPressed" Color="#FF17181B" />
    <SolidColorBrush x:Key="AfSurfaceWell" Color="#FF141518" />
    <SolidColorBrush x:Key="AfSurfaceOverlay" Color="#FF23252A" />
    <SolidColorBrush x:Key="AfSurfaceMat" Color="#FF0A0B0C" />

    <SolidColorBrush x:Key="AfSurfaceRowHover" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="AfSurfaceRowSelected" Color="#332D7DFF" />
    <SolidColorBrush x:Key="AfSurfaceRowAlternate" Color="#06FFFFFF" />
    <SolidColorBrush x:Key="AfSurfaceTrackSelected" Color="#332D7DFF" />

    <!-- ============================================================ text -->

    <SolidColorBrush x:Key="AfTextPrimary" Color="#FFF1F0EC" />
    <SolidColorBrush x:Key="AfTextSecondary" Color="#FFB8B6B0" />
    <SolidColorBrush x:Key="AfTextTertiary" Color="#FF9A9893" />

    <!-- Ornament only - placeholder glyphs and empty-state line art. Below the
         contrast floor for text, which is why nothing readable uses it. -->
    <SolidColorBrush x:Key="AfTextQuaternary" Color="#FF5C5B57" />

    <SolidColorBrush x:Key="AfTextDisabled" Color="#FF5A5955" />
    <SolidColorBrush x:Key="AfTextInverse" Color="#FF16171A" />
    <SolidColorBrush x:Key="AfTextPlaceholder" Color="#FF5C5B57" />

    <!-- ========================================================= accents -->

    <!--
        Blue selects and acts, green confirms, red destroys or fails, yellow
        cautions. Each has three jobs and three values: the bright hue for
        hairlines, bars and glyphs; Solid for a filled surface carrying white
        text; Text for accent-coloured words on a dark panel. The bright hue is
        never used as small text and Solid is never used as a hairline.
    -->
    <SolidColorBrush x:Key="AfAccentBlue" Color="#FF2D7DFF" />
    <SolidColorBrush x:Key="AfAccentBlueFill" Color="#332D7DFF" />
    <SolidColorBrush x:Key="AfAccentBlueText" Color="#FF8FBBFF" />
    <SolidColorBrush x:Key="AfAccentBlueSolid" Color="#FF1F5FD0" />

    <SolidColorBrush x:Key="AfAccentGreen" Color="#FF37B86D" />
    <SolidColorBrush x:Key="AfAccentGreenFill" Color="#3337B86D" />
    <SolidColorBrush x:Key="AfAccentGreenText" Color="#FF7FDAA4" />
    <SolidColorBrush x:Key="AfAccentGreenSolid" Color="#FF23844B" />

    <SolidColorBrush x:Key="AfAccentRed" Color="#FFE64B4B" />
    <SolidColorBrush x:Key="AfAccentRedFill" Color="#33E64B4B" />
    <SolidColorBrush x:Key="AfAccentRedText" Color="#FFF29A9A" />
    <SolidColorBrush x:Key="AfAccentRedSolid" Color="#FFB23434" />

    <SolidColorBrush x:Key="AfAccentYellow" Color="#FFE5B83E" />
    <SolidColorBrush x:Key="AfAccentYellowFill" Color="#33E5B83E" />
    <SolidColorBrush x:Key="AfAccentYellowText" Color="#FFEFD285" />
    <SolidColorBrush x:Key="AfAccentYellowSolid" Color="#FF8A6B14" />

    <SolidColorBrush x:Key="AfStatusOk" Color="#FF37B86D" />
    <SolidColorBrush x:Key="AfStatusOkText" Color="#FF7FDAA4" />
    <SolidColorBrush x:Key="AfStatusCaution" Color="#FFE5B83E" />
    <SolidColorBrush x:Key="AfStatusCautionText" Color="#FFEFD285" />
    <SolidColorBrush x:Key="AfStatusDanger" Color="#FFE64B4B" />
    <SolidColorBrush x:Key="AfStatusDangerText" Color="#FFF29A9A" />
    <SolidColorBrush x:Key="AfStatusInfo" Color="#FF2D7DFF" />
    <SolidColorBrush x:Key="AfStatusInfoText" Color="#FF8FBBFF" />
    <SolidColorBrush x:Key="AfStatusIdle" Color="#FF6E6C68" />

    <!-- ========================================================= strokes -->

    <!--
        Bevels, as a 3px absolute-mapped gradient on a 1px border: the top edge
        picks up the first stop and every edge below it pads to the last, so one
        border draws a light top and a dark bottom. Raised stands proud, Inset is
        the same idea inverted for a recess. This is why the theme needs no drop
        shadows.
    -->
    <LinearGradientBrush x:Key="AfStrokeRaised" StartPoint="0,0" EndPoint="0,3"
                         MappingMode="Absolute">
        <GradientStop Color="#2EFFFFFF" Offset="0" />
        <GradientStop Color="#59000000" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AfStrokeInset" StartPoint="0,0" EndPoint="0,3"
                         MappingMode="Absolute">
        <GradientStop Color="#73000000" Offset="0" />
        <GradientStop Color="#1FFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="AfStrokeDivider" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="AfStrokeSeam" Color="#FF08090A" />
    <SolidColorBrush x:Key="AfStrokeBevelHighlight" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="AfStrokeBevelShadow" Color="#59000000" />

    <!-- The moulding seam: warm grey, the colour of the console's own plastic,
         at the join between chassis sections. -->
    <SolidColorBrush x:Key="AfStrokeWarm" Color="#2ED8D4CA" />

    <!-- Selection reads as a blue marker down the left edge of the row, so it
         survives being looked at in greyscale or by someone who cannot separate
         the tint from the row beside it. -->
    <SolidColorBrush x:Key="AfStrokeSelectionBar" Color="#FF2D7DFF" />
    <Thickness x:Key="AfStrokeSelectionBarThickness">3,0,0,0</Thickness>

    <!-- ================================================= spacing, density -->

    <!-- Tighter than Dark throughout: this is a dense instrument panel, not a
         page of cards. -->
    <Thickness x:Key="AfPadWindowBrowser">12,0,12,0</Thickness>
    <Thickness x:Key="AfPadWindowDeck">12,10,12,0</Thickness>
    <Thickness x:Key="AfPadWindowStatus">12,6,12,8</Thickness>

    <Thickness x:Key="AfPadPaneHeader">10,6,10,6</Thickness>
    <Thickness x:Key="AfPadAlbumHeader">10</Thickness>
    <Thickness x:Key="AfPadDeck">10</Thickness>
    <Thickness x:Key="AfPadRow">8,3</Thickness>
    <Thickness x:Key="AfPadRowMargin">0,1</Thickness>

    <sys:Double x:Key="AfSizeTrackRowHeight">27</sys:Double>

    <!-- A moulded badge rather than a picture, so it sits at key height. -->
    <sys:Double x:Key="AfSizeBrandMark">22</sys:Double>

    <!-- =========================================================== radii -->

    <CornerRadius x:Key="AfRadiusControl">1</CornerRadius>
    <CornerRadius x:Key="AfRadiusWell">0</CornerRadius>
    <CornerRadius x:Key="AfRadiusPanel">2</CornerRadius>
    <CornerRadius x:Key="AfRadiusArt">2</CornerRadius>
    <CornerRadius x:Key="AfRadiusArtSmall">1</CornerRadius>
    <CornerRadius x:Key="AfFocusRingRadius">0</CornerRadius>

    <!-- ============================================================ type -->

    <!--
        The UI face stays the system one - this has to read as a Windows
        application at any DPI or text scale, and a period bitmap font would
        throw that away. Only the numbers change: a monospaced face makes the
        bitrate, depth, sample-rate and timecode columns line up digit for digit
        and stop twitching as they update.
    -->
    <FontFamily x:Key="AfFontMono">Consolas, Cascadia Mono, Courier New</FontFamily>

    <!-- Hair spaces between characters, for the spaced-caps hardware labels
         above each pane. See Formatting/LetterSpacing.cs - WPF has no tracking
         property, so this is inserted into the text and the unspaced original is
         kept as the automation name. -->
    <sys:String x:Key="AfTrackingLabel" xml:space="preserve">&#x200A;</sys:String>

    <!-- =========================================================== focus -->

    <SolidColorBrush x:Key="AfFocusRing" Color="#FF79AFFF" />
    <SolidColorBrush x:Key="AfFocusRingSpacer" Color="#FF0A0B0C" />

    <!-- =============================================== texture and decor -->

    <!--
        Three static brushes, all of them behind content and none of them
        animated. Tiled and vector fills cost one draw each - there is no blur,
        no bitmap effect and nothing that repaints per frame.
    -->

    <!-- Scanlines: one hairline every 3px. At 3% over a near-black plate this is
         a texture you notice on the chassis and cannot see under text. -->
    <DrawingBrush x:Key="AfTextureBrush" TileMode="Tile" Stretch="None"
                  Viewport="0,0,4,3" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#FFFFFFFF">
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,4,1" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <sys:Double x:Key="AfTextureOpacity">0.03</sys:Double>

    <!-- Ordered dither, the 4x4 cell early hardware used to fake shades it did
         not have. Two lit cells out of sixteen, at 2%. -->
    <DrawingBrush x:Key="AfGrainBrush" TileMode="Tile" Stretch="None"
                  Viewport="0,0,4,4" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#FFFFFFFF">
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <RectangleGeometry Rect="0,0,1,1" />
                        <RectangleGeometry Rect="2,2,1,1" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <sys:Double x:Key="AfGrainOpacity">0.02</sys:Double>

    <!--
        Low-poly geometry, the sort of faceted object an early 3D demo would
        rotate on a title screen. Drawn at natural size and anchored to the
        bottom-right rather than stretched, so the lines stay hairlines at every
        DPI instead of thickening with the pane.
    -->
    <DrawingBrush x:Key="AfDecorBrush" Stretch="None" TileMode="None"
                  AlignmentX="Right" AlignmentY="Bottom">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF2D7DFF" Thickness="1.25" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 24,150 L 78,44 L 168,96 L 122,204 Z
                                               M 24,150 L 168,96
                                               M 78,44 L 122,204
                                               M 168,96 L 240,30 L 286,118 L 214,166 Z
                                               M 168,96 L 286,118
                                               M 240,30 L 214,166" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <sys:Double x:Key="AfDecorOpacity">0.07</sys:Double>

    <!-- ===================================================== WPF-UI keys -->

    <!--
        Everything below re-points WPF-UI's own semantic keys at PS1 surfaces.
        Its controls resolve these with DynamicResource, so buttons, text boxes,
        menus, scrollbars, checkboxes and tooltips all land on this palette
        without a single hand-written template - which is both far less code and
        far less to get wrong than replacing their templates would be.
    -->

    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FF0E0F11" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FF0E0F11" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="#FF08090A" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#FF1E2023" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#FF23252A" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#FF2A2C30" />

    <!-- Control faces. Pressed is darker than default, not lighter: a key that
         goes in when you push it. -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FF2A2C30" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FF34373C" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#FF17181B" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#FF1E2023" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#FF141518" />
    <SolidColorBrush x:Key="ControlFillColorTransparentBrush" Color="Transparent" />

    <SolidColorBrush x:Key="ControlAltFillColorSecondaryBrush" Color="#FF141518" />
    <SolidColorBrush x:Key="ControlAltFillColorTertiaryBrush" Color="#FF2A2C30" />
    <SolidColorBrush x:Key="ControlAltFillColorQuarternaryBrush" Color="#FF34373C" />
    <SolidColorBrush x:Key="ControlAltFillColorDisabledBrush" Color="#FF1E2023" />

    <SolidColorBrush x:Key="ControlSolidFillColorDefaultBrush" Color="#FF2A2C30" />
    <SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="#FF8C8A85" />
    <SolidColorBrush x:Key="ControlStrongFillColorDisabledBrush" Color="#FF3A3C40" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#FFB8B6B0" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDisabledBrush" Color="#FF3A3C40" />

    <!-- Bevelled edges on every stock control, from the same gradient the panels
         use. -->
    <LinearGradientBrush x:Key="ControlElevationBorderBrush" StartPoint="0,0" EndPoint="0,3"
                         MappingMode="Absolute">
        <GradientStop Color="#2EFFFFFF" Offset="0" />
        <GradientStop Color="#59000000" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TextControlElevationBorderBrush" StartPoint="0,0" EndPoint="0,3"
                         MappingMode="Absolute">
        <GradientStop Color="#73000000" Offset="0" />
        <GradientStop Color="#1FFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CircleElevationBorderBrush" StartPoint="0,0" EndPoint="0,3"
                         MappingMode="Absolute">
        <GradientStop Color="#2EFFFFFF" Offset="0" />
        <GradientStop Color="#59000000" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="ControlStrokeColorTertiaryBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentDefaultBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentSecondaryBrush" Color="#59000000" />

    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FF1E2023" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FF141518" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FF08090A" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#FF08090A" />

    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FF1E2023" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#FF2A2C30" />
    <SolidColorBrush x:Key="LayerOnAcrylicFillColorDefaultBrush" Color="#FF23252A" />
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorDefaultBrush" Color="#FF23252A" />
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorSecondaryBrush" Color="#FF2A2C30" />
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorTertiaryBrush" Color="#FF34373C" />

    <!-- Hover and press for the flat, borderless controls: the window buttons,
         the rescan button, menu bar items. -->
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#0CFFFFFF" />
    <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="SubtleFillColorDisabledBrush" Color="Transparent" />

    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#FF08090A" />
    <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush" Color="#FF08090A" />
    <SolidColorBrush x:Key="ContextMenuBorderBrush" Color="#FF08090A" />
    <SolidColorBrush x:Key="FlyoutBorderBrush" Color="#FF08090A" />
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#FF08090A" />
    <SolidColorBrush x:Key="MenuBarItemBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ProgressBarBorderBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#FF08090A" />
    <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="#1FFFFFFF" />

    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFF1F0EC" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FFB8B6B0" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF8C8A85" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#FF5A5955" />
    <SolidColorBrush x:Key="TextFillColorInverseBrush" Color="#FF16171A" />
    <SolidColorBrush x:Key="TextPlaceholderColorBrush" Color="#FF8C8A85" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#FF5A5955" />

    <!--
        The accent WPF-UI derives from a seed colour is a light pastel on dark
        surfaces, which is the WinUI convention but not this one: a primary key
        here is saturated blue with a white glyph. These four therefore restate
        the accent explicitly, and ThemeService writes them over what
        ApplicationAccentColorManager leaves behind - it puts its values directly
        into Application.Resources, which outranks any merged dictionary.
    -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF1F5FD0" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF2A6EE0" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF184FB0" />
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#FF262A31" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF8FBBFF" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FFB9D3FF" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FF8FBBFF" />
    <SolidColorBrush x:Key="AccentTextFillColorDisabledBrush" Color="#FF5A5955" />

    <LinearGradientBrush x:Key="AccentControlElevationBorderBrush" StartPoint="0,0" EndPoint="0,3"
                         MappingMode="Absolute">
        <GradientStop Color="#3DFFFFFF" Offset="0" />
        <GradientStop Color="#66000000" Offset="1" />
    </LinearGradientBrush>

    <!-- A focus ring the eye lands on: a bright outline over a dark spacer, so
         it stays visible on a raised key, a selected row and a dark well alike. -->
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#FF79AFFF" />
    <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="#FF0A0B0C" />
    <SolidColorBrush x:Key="KeyboardFocusBorderColorBrush" Color="#FF79AFFF" />

    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#FF37B86D" />
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FFE5B83E" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FFE64B4B" />
    <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#FF2D7DFF" />
    <SolidColorBrush x:Key="SystemFillColorNeutralBrush" Color="#FFB8B6B0" />
    <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#3337B86D" />
    <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="#33E5B83E" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#33E64B4B" />
    <SolidColorBrush x:Key="SystemFillColorAttentionBackgroundBrush" Color="#332D7DFF" />

    <!-- Square corners on every stock control. -->
    <CornerRadius x:Key="ControlCornerRadius">1</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">2</CornerRadius>

    <!-- Slider rail and thumb, shared with the seek and volume sliders. -->
    <SolidColorBrush x:Key="SliderTrackFill" Color="#FF3A3C40" />
    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#FF474A4F" />
    <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="#FF34373C" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="#FF2D7DFF" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FF5B9AFF" />

    <!-- ====================================================== typography -->

    <!-- Hardware labels: small, spaced capitals, the way a moulded legend is
         printed above a socket. -->
    <Style x:Key="AfPaneHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AfFontSizeMicro}" />
        <Setter Property="FontWeight" Value="{DynamicResource AfFontWeightSemiBold}" />
        <Setter Property="Foreground" Value="{DynamicResource AfTextTertiary}" />
        <Setter Property="Margin" Value="{DynamicResource AfPadPaneHeader}" />
        <Setter Property="fmt:LetterSpacing.Spacer" Value="{DynamicResource AfTrackingLabel}" />
    </Style>

    <!-- Numeric columns and timecodes, monospaced. -->
    <Style x:Key="AfNumericCell" TargetType="TextBlock">
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="{DynamicResource AfPadNumericCell}" />
        <Setter Property="FontFamily" Value="{DynamicResource AfFontMono}" />
        <Setter Property="FontSize" Value="{DynamicResource AfFontSizeSmall}" />
    </Style>

    <Style x:Key="AfReadout" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AfFontMono}" />
        <Setter Property="FontSize" Value="{DynamicResource AfFontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource AfTextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AfAlbumTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AfFontSizeTitle}" />
        <Setter Property="FontWeight" Value="{DynamicResource AfFontWeightSemiBold}" />
        <Setter Property="Foreground" Value="{DynamicResource AfTextPrimary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="LineHeight" Value="{DynamicResource AfLineHeightTitle}" />
    </Style>

    <!-- =========================================================== panes -->

    <!--
        Moulded chassis: a dark seam on the outside, a bevelled edge inside it, a
        raised header strip with a warm moulding line along its top, and the body
        recessed into a well. Four elements, no effects.
    -->
    <Style x:Key="AfPane" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="{DynamicResource AfSurfacePanel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AfStrokeSeam}" />
        <Setter Property="BorderThickness" Value="{DynamicResource AfStrokeThin}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource AfRadiusPanel}"
                            SnapsToDevicePixels="True">
                        <Border BorderBrush="{DynamicResource AfStrokeRaised}"
                                BorderThickness="{DynamicResource AfStrokeThin}"
                                SnapsToDevicePixels="True">
                            <DockPanel>
                                <Border x:Name="HeaderStrip"
                                        DockPanel.Dock="Top"
                                        Background="{DynamicResource AfSurfaceRaised}"
                                        BorderBrush="{DynamicResource AfStrokeSeam}"
                                        BorderThickness="0,0,0,1"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <ContentPresenter ContentSource="Header" />
                                        <Border Height="1" VerticalAlignment="Top"
                                                Background="{DynamicResource AfStrokeWarm}" />
                                    </Grid>
                                </Border>

                                <Border x:Name="Well"
                                        Background="{DynamicResource AfSurfaceWell}"
                                        BorderBrush="{DynamicResource AfStrokeInset}"
                                        BorderThickness="0,1,0,0"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter />
                                </Border>
                            </DockPanel>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="HeaderStrip" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The display: the track pane. Identical chassis, with the theme's one
        textured surface behind its content - low-poly geometry anchored bottom
        right, plus scanlines, both under the rows and both far too faint to
        touch the contrast of anything written over them.
    -->
    <Style x:Key="AfPaneDisplay" TargetType="HeaderedContentControl"
           BasedOn="{StaticResource AfPane}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource AfRadiusPanel}"
                            SnapsToDevicePixels="True">
                        <Border BorderBrush="{DynamicResource AfStrokeRaised}"
                                BorderThickness="{DynamicResource AfStrokeThin}"
                                SnapsToDevicePixels="True">
                            <DockPanel>
                                <Border x:Name="HeaderStrip"
                                        DockPanel.Dock="Top"
                                        Background="{DynamicResource AfSurfaceRaised}"
                                        BorderBrush="{DynamicResource AfStrokeSeam}"
                                        BorderThickness="0,0,0,1"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <ContentPresenter ContentSource="Header" />
                                        <Border Height="1" VerticalAlignment="Top"
                                                Background="{DynamicResource AfStrokeWarm}" />
                                    </Grid>
                                </Border>

                                <Border Background="{DynamicResource AfSurfaceWell}"
                                        BorderBrush="{DynamicResource AfStrokeInset}"
                                        BorderThickness="0,1,0,0"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <Border Background="{DynamicResource AfDecorBrush}"
                                                Opacity="{DynamicResource AfDecorOpacity}"
                                                IsHitTestVisible="False" />
                                        <Border Background="{DynamicResource AfTextureBrush}"
                                                Opacity="{DynamicResource AfTextureOpacity}"
                                                IsHitTestVisible="False" />
                                        <ContentPresenter />
                                    </Grid>
                                </Border>
                            </DockPanel>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="HeaderStrip" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The transport deck. Raised rather than recessed - it is the front panel
        you press, so it sits proud of the shell with a warm moulding line along
        its top edge.
    -->
    <Style x:Key="AfDeck" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="{DynamicResource AfSurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AfStrokeSeam}" />
        <Setter Property="BorderThickness" Value="{DynamicResource AfStrokeThin}" />
        <Setter Property="Padding" Value="{DynamicResource AfPadDeck}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource AfRadiusPanel}"
                            SnapsToDevicePixels="True">
                        <Border BorderBrush="{DynamicResource AfStrokeRaised}"
                                BorderThickness="{DynamicResource AfStrokeThin}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                                <Border Height="1" VerticalAlignment="Top"
                                        Background="{DynamicResource AfStrokeWarm}" />
                            </Grid>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cover slots are recessed, like the disc window in a console lid. -->
    <Style x:Key="AfArtFrame" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AfSurfaceMat}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AfStrokeInset}" />
        <Setter Property="BorderThickness" Value="{DynamicResource AfStrokeThin}" />
        <Setter Property="CornerRadius" Value="{DynamicResource AfRadiusArtSmall}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="AfArtFrameLarge" TargetType="Border" BasedOn="{StaticResource AfArtFrame}">
        <Setter Property="CornerRadius" Value="{DynamicResource AfRadiusArt}" />
    </Style>

    <!-- ======================================================= track grid -->

    <!--
        Column titles sit on a raised strip with a seam under it, separated by
        hairlines: a legend plate over the display rather than text floating
        above rows. Kept to property setters so the stock header keeps its sort
        indicator and its resize grips - templating it would mean rebuilding both.
    -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource AfSurfaceRaised}" />
        <Setter Property="Foreground" Value="{DynamicResource AfTextSecondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AfStrokeSeam}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="SeparatorBrush" Value="{DynamicResource AfStrokeDivider}" />
        <Setter Property="SeparatorVisibility" Value="Visible" />
        <Setter Property="FontSize" Value="{DynamicResource AfFontSizeSmall}" />
        <Setter Property="FontWeight" Value="{DynamicResource AfFontWeightSemiBold}" />
        <Setter Property="Padding" Value="{DynamicResource AfPadGridHeader}" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!--
        Cells paint nothing: the row owns selection, and it owns keyboard focus
        too - a focused row brightens its marker rather than drawing a box round
        a cell. FocusVisualStyle is cleared for the same reason, or WPF would put
        its own dotted rectangle there.
    -->
    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource AfTextSecondary}" />
        <Setter Property="Padding" Value="{DynamicResource AfPadGridCell}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================== slider -->

    <!--
        A rectangular thumb in an inset rail, with the travelled part filled
        blue. Keeps the rail inset by the thumb's half-width so neither end cap
        shows past the thumb at 0% or 100% - the reason this app has always
        carried its own slider template.
    -->
    <Style x:Key="AfSlider" TargetType="Slider">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="Root" VerticalAlignment="Center" Height="20">
                        <Border Height="6" Margin="6,0"
                                Background="{DynamicResource AfSurfaceWell}"
                                BorderBrush="{DynamicResource AfStrokeInset}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Focusable="False" IsTabStop="False"
                                              OverridesDefaultStyle="True">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <!-- The filled part of the rail. Transparent
                                                 padding either side keeps it inside the
                                                 well's own border. -->
                                            <Grid Background="Transparent">
                                                <Border Height="4" Margin="7,0,0,0"
                                                        HorizontalAlignment="Stretch"
                                                        Background="{DynamicResource AfAccentBlue}"
                                                        SnapsToDevicePixels="True" />
                                            </Grid>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Focusable="False" IsTabStop="False"
                                              OverridesDefaultStyle="True">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Thumb"
                                       Height="18" Width="12"
                                       OverridesDefaultStyle="True"
                                       SnapsToDevicePixels="True"
                                       Background="{DynamicResource AfSurfaceRaised}"
                                       BorderBrush="{DynamicResource AfStrokeSeam}"
                                       Foreground="{DynamicResource AfAccentBlue}">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{DynamicResource AfRadiusControl}"
                                                    SnapsToDevicePixels="True">
                                                <Border BorderBrush="{DynamicResource AfStrokeRaised}"
                                                        BorderThickness="1"
                                                        SnapsToDevicePixels="True">
                                                    <!-- Grip line, so the thumb reads as
                                                         something to take hold of. -->
                                                    <Border Width="2" Height="8"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Background="{TemplateBinding Foreground}" />
                                                </Border>
                                            </Border>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>

                        <Border x:Name="FocusRing"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"
                                BorderBrush="{DynamicResource AfFocusRing}"
                                BorderThickness="{DynamicResource AfFocusRingInset}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Thumb" Property="Background"
                                    Value="{DynamicResource AfSurfaceRaisedHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity"
                                    Value="{DynamicResource AfOpacityDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================================== progress -->

    <!--
        A segmented bar, masked into ticks rather than drawn as a smooth fill.
        Determinate is what the app uses - the scan reports a fraction - and the
        indeterminate case falls back to a dim full-width fill rather than an
        animation, because nothing in this theme loops.
    -->
    <DrawingBrush x:Key="Ps1SegmentMask" TileMode="Tile" Stretch="None"
                  Viewport="0,0,4,1" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#FFFFFFFF">
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,3,1" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource AfSurfaceWell}" />
        <Setter Property="Foreground" Value="{DynamicResource AfAccentBlue}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AfStrokeInset}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    OpacityMask="{StaticResource Ps1SegmentMask}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="HorizontalAlignment"
                                    Value="Stretch" />
                            <Setter TargetName="PART_Indicator" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================== toggle -->

    <!--
        The bit-perfect key. Three cues for one state, none of them colour on its
        own: the key sits in rather than proud, a square lamp lights, and the
        word beside it changes. That matters here - engaging it silences every
        other application on the machine.
    -->
    <Style TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource AfTextSecondary}" />
        <Setter Property="FontSize" Value="{DynamicResource AfFontSizeSmall}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root">
                        <Border x:Name="Face"
                                Background="{DynamicResource AfSurfaceRaised}"
                                BorderBrush="{DynamicResource AfStrokeSeam}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource AfRadiusControl}"
                                SnapsToDevicePixels="True">
                            <Border x:Name="Bevel"
                                    BorderBrush="{DynamicResource AfStrokeRaised}"
                                    BorderThickness="1"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="Lamp"
                                            Width="7" Height="7"
                                            VerticalAlignment="Center"
                                            Margin="0,0,6,0"
                                            Background="{DynamicResource AfStatusIdle}"
                                            BorderBrush="{DynamicResource AfStrokeSeam}"
                                            BorderThickness="1"
                                            SnapsToDevicePixels="True" />
                                    <ContentPresenter VerticalAlignment="Center" />
                                    <TextBlock x:Name="State"
                                               Text="OFF"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="{DynamicResource AfFontSizeMicro}"
                                               FontWeight="{DynamicResource AfFontWeightSemiBold}"
                                               Foreground="{DynamicResource AfTextTertiary}" />
                                </StackPanel>
                            </Border>
                        </Border>

                        <Border x:Name="FocusRing"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"
                                Margin="-2"
                                BorderBrush="{DynamicResource AfFocusRing}"
                                BorderThickness="{DynamicResource AfFocusRingThickness}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background"
                                    Value="{DynamicResource AfSurfaceRaisedHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background"
                                    Value="{DynamicResource AfSurfaceRaisedPressed}" />
                            <Setter TargetName="Bevel" Property="BorderBrush"
                                    Value="{DynamicResource AfStrokeInset}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Face" Property="Background"
                                    Value="{DynamicResource AfSurfaceRaisedPressed}" />
                            <Setter TargetName="Bevel" Property="BorderBrush"
                                    Value="{DynamicResource AfStrokeInset}" />
                            <Setter TargetName="Lamp" Property="Background"
                                    Value="{DynamicResource AfStatusOk}" />
                            <Setter TargetName="State" Property="Text" Value="ON" />
                            <Setter TargetName="State" Property="Foreground"
                                    Value="{DynamicResource AfStatusOkText}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource AfTextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity"
                                    Value="{DynamicResource AfOpacityDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================== themed slots -->

    <!--
        The shell plate. Scanlines and dither over near-black, behind every
        pixel of content - visible in the title strip, the status strip and the
        gutters between panels, and never between the reader and a word.
    -->
    <ControlTemplate x:Key="AfWindowDecor" TargetType="Control">
        <Grid IsHitTestVisible="False">
            <Border Background="{DynamicResource AfSurfaceShell}" />
            <Border Background="{DynamicResource AfTextureBrush}"
                    Opacity="{DynamicResource AfTextureOpacity}" />
            <Border Background="{DynamicResource AfGrainBrush}"
                    Opacity="{DynamicResource AfGrainOpacity}" />
        </Grid>
    </ControlTemplate>

    <!--
        Title-bar identity: a moulded badge carrying the four face-button shapes
        in the theme's four accent colours, which are also the four status
        colours. An original mark in the console's idiom rather than a redrawing
        of anybody's logo.

        The shapes carry their own style and transform so Ps1Motion.xaml can give
        them an entrance without a second copy of this template.
    -->
    <Style x:Key="Ps1BrandShapes" TargetType="StackPanel" />
    <ControlTemplate x:Key="AfBrandMark" TargetType="Control">
        <Border Background="{DynamicResource AfSurfaceRaised}"
                BorderBrush="{DynamicResource AfStrokeSeam}"
                BorderThickness="1"
                CornerRadius="{DynamicResource AfRadiusControl}"
                SnapsToDevicePixels="True">
            <Border BorderBrush="{DynamicResource AfStrokeRaised}"
                    BorderThickness="1"
                    Padding="9,0"
                    SnapsToDevicePixels="True">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Style="{DynamicResource Ps1BrandShapes}"
                            RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <ScaleTransform />
                    </StackPanel.RenderTransform>
                    <Path Data="{StaticResource Ps1Square}"
                          Fill="{DynamicResource AfAccentBlue}"
                          Width="11" Height="11" Margin="0,0,6,0"
                          Stretch="Uniform" />
                    <Path Data="{StaticResource Ps1Triangle}"
                          Fill="{DynamicResource AfAccentYellow}"
                          Width="11" Height="11" Margin="0,0,6,0"
                          Stretch="Uniform" />
                    <Path Data="{StaticResource Ps1Circle}"
                          Fill="{DynamicResource AfAccentGreen}"
                          Width="11" Height="11" Margin="0,0,6,0"
                          Stretch="Uniform" />
                    <Path Data="{StaticResource Ps1Cross}"
                          Stroke="{DynamicResource AfAccentRed}"
                          StrokeThickness="1.7"
                          Width="11" Height="11"
                          Stretch="Uniform" />
                </StackPanel>
            </Border>
        </Border>
    </ControlTemplate>

    <!--
        Library state, in the status bar. Shape and word change together with the
        colour: a yellow triangle while scanning, a green circle when the library
        is loaded and the output is live, a grey circle otherwise.
    -->
    <ControlTemplate x:Key="AfStatusLamp" TargetType="Control">
        <Grid Width="12" Height="12" ToolTip="{Binding StatusText}">
            <Path x:Name="Idle"
                  Data="{StaticResource Ps1Circle}"
                  Fill="{DynamicResource AfStatusIdle}"
                  Stretch="Uniform" Margin="1" />
            <Path x:Name="Ready"
                  Data="{StaticResource Ps1Circle}"
                  Fill="{DynamicResource AfStatusOk}"
                  Stretch="Uniform" Margin="1"
                  Visibility="Collapsed" />
            <Path x:Name="Busy"
                  Data="{StaticResource Ps1Triangle}"
                  Fill="{DynamicResource AfStatusCaution}"
                  Stretch="Uniform" Margin="0"
                  Visibility="Collapsed" />
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsOutputActive}" Value="True">
                <Setter TargetName="Idle" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Ready" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsScanning}" Value="True">
                <Setter TargetName="Idle" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Ready" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Busy" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Nothing selected yet: line art in the ornament grey, and two lines
         saying what to do about it. -->
    <ControlTemplate x:Key="AfEmptyState" TargetType="Control">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Path Data="{StaticResource Ps1Square}"
                  Stroke="{DynamicResource AfTextQuaternary}"
                  StrokeThickness="0.6"
                  Width="44" Height="44"
                  Stretch="Uniform"
                  HorizontalAlignment="Center" />
            <TextBlock Text="No album selected"
                       Margin="0,16,0,0"
                       HorizontalAlignment="Center"
                       FontSize="{DynamicResource AfFontSizeBody}"
                       Foreground="{DynamicResource AfTextSecondary}" />
            <TextBlock Text="Pick an artist, then one of their albums."
                       Margin="0,4,0,0"
                       HorizontalAlignment="Center"
                       FontSize="{DynamicResource AfFontSizeSmall}"
                       Foreground="{DynamicResource AfTextTertiary}" />
        </StackPanel>
    </ControlTemplate>

</ResourceDictionary>
