<ui:FluentWindow x:Class="AudioFool.TagEditWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Edit Tags"
                 Icon="/Resources/AudioFool.ico"
                 Width="460" SizeToContent="Height"
                 MinWidth="380"
                 WindowStartupLocation="Manual"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="Bar" Grid.Row="0" Title="{Binding WindowTitle}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Resources/AudioFool.ico" Width="16" Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1">
            <!-- Cover art - album mode only. Replacing it always applies to every -->
            <!-- track in the album plus the folder cover file, never just one file. -->
            <StackPanel Margin="20,12,20,0"
                        Visibility="{Binding IsAlbumMode, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="72" Height="72" CornerRadius="4"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <Grid>
                            <ui:SymbolIcon Symbol="MusicNote224" FontSize="20" Opacity="0.35"
                                           Visibility="{Binding ArtPreview, Converter={StaticResource NullToVisible}}" />
                            <Image Source="{Binding ArtPreview}" Stretch="UniformToFill"
                                   Visibility="{Binding ArtPreview, Converter={StaticResource NullToCollapsed}}" />
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <ui:Button Content="Choose Image..." Command="{Binding ChooseImageCommand}" />
                        <TextBlock Text="Replacing the cover updates every track in this album,&#10;plus its folder cover file."
                                   FontSize="11" Opacity="0.6" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <Grid Margin="20,16,20,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Title" VerticalAlignment="Center" Margin="0,0,0,8"
                           Visibility="{Binding IsTrackMode, Converter={StaticResource BoolToVisibility}}" />
                <ui:TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                            Visibility="{Binding IsTrackMode, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Artist" VerticalAlignment="Center" Margin="0,0,0,8" />
                <ui:TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Artist, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Album Artist" VerticalAlignment="Center" Margin="0,0,0,8" />
                <ui:TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AlbumArtist, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Album" VerticalAlignment="Center" Margin="0,0,0,8" />
                <ui:TextBox Grid.Row="3" Grid.Column="1" Text="{Binding AlbumTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Year" VerticalAlignment="Center" Margin="0,0,0,8" />
                <ui:TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}"
                            HorizontalAlignment="Left" Width="80" Margin="0,0,0,8" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Track / Disc" VerticalAlignment="Center"
                           Visibility="{Binding IsTrackMode, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal"
                            Visibility="{Binding IsTrackMode, Converter={StaticResource BoolToVisibility}}">
                    <ui:TextBox Text="{Binding TrackNumber, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                    <TextBlock Text="/" VerticalAlignment="Center" Margin="8,0,8,0" Opacity="0.6" />
                    <ui:TextBox Text="{Binding DiscNumber, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="2" Margin="20,4,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding ValidationError}"
                       Foreground="IndianRed" FontSize="12" VerticalAlignment="Center"
                       TextWrapping="Wrap" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" />
                <ui:Button Content="Save" Appearance="Primary" IsEnabled="{Binding CanSave}" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
