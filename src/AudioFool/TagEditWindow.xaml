<ui:FluentWindow x:Class="AudioFool.TagEditWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Edit Tags"
                 Icon="/Resources/AudioFool.ico"
                 Width="460" SizeToContent="Height"
                 MinWidth="380"
                 WindowStartupLocation="Manual"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="Bar" Grid.Row="0" Title="{Binding WindowTitle}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Resources/AudioFool.ico" Width="16" Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1">
            <!-- Cover art - the album dialog only, not a track or a selection. Replacing -->
            <!-- it always applies to every track in the album plus the folder cover file. -->
            <StackPanel Margin="20,12,20,0"
                        Visibility="{Binding ShowsArt, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <!-- The cover's size and format, read from its bytes: the current one, -->
                    <!-- or the one Save would write once a new cover is picked. -->
                    <StackPanel VerticalAlignment="Top" ToolTip="{Binding ArtSourceText}">
                        <Border Width="72" Height="72" Style="{DynamicResource AfArtFrame}">
                            <Grid>
                                <ui:SymbolIcon Symbol="MusicNote224"
                                               FontSize="{DynamicResource AfIconSizeMedium}"
                                               Foreground="{DynamicResource AfTextPlaceholder}"
                                               Visibility="{Binding ArtPreview, Converter={StaticResource NullToVisible}}" />
                                <Image Source="{Binding ArtPreview}" Stretch="UniformToFill"
                                       Visibility="{Binding ArtPreview, Converter={StaticResource NullToCollapsed}}" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="ArtSizeText" Text="{Binding ArtSizeText}" Style="{DynamicResource AfMetaText}"
                                   TextTrimming="None" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        <TextBlock x:Name="ArtFormatText" Text="{Binding ArtFormatText}" Style="{DynamicResource AfMetaText}"
                                   TextTrimming="None" HorizontalAlignment="Center" />
                    </StackPanel>
                    <!-- Centred on the art itself, not on the art plus its two lines. -->
                    <Grid VerticalAlignment="Top" Height="72" Margin="12,0,0,0">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="Choose Image..." Command="{Binding ChooseImageCommand}" />
                                <ui:Button x:Name="SearchInternetButton" Content="Search Internet..." Margin="8,0,0,0"
                                           ToolTip="Find a JPEG cover of at least 1,000 × 1,000 on the iTunes Store, the Cover Art Archive or fanart.tv"
                                           Click="SearchInternet_Click" />
                            </StackPanel>
                            <TextBlock Text="Replacing the cover updates every track in this album,&#10;plus its folder cover file."
                                       Style="{DynamicResource AfMetaText}" TextTrimming="None"
                                       Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>

            <Grid Margin="20,16,20,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Title" VerticalAlignment="Center" Margin="0,0,0,8"
                           Visibility="{Binding IsTrackMode, Converter={StaticResource BoolToVisibility}}" />
                <ui:TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                            Visibility="{Binding IsTrackMode, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Artist" VerticalAlignment="Center" Margin="0,0,0,8" />
                <ui:TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Artist, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="{Binding ArtistPlaceholder}" Margin="0,0,0,8" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Album Artist" VerticalAlignment="Center" Margin="0,0,0,8" />
                <ui:TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AlbumArtist, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="{Binding AlbumArtistPlaceholder}" Margin="0,0,0,8" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Album" VerticalAlignment="Center" Margin="0,0,0,8" />
                <ui:TextBox Grid.Row="3" Grid.Column="1" Text="{Binding AlbumTitle, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="{Binding AlbumTitlePlaceholder}" Margin="0,0,0,8" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Year" VerticalAlignment="Center" Margin="0,0,0,8" />
                <!-- Wide enough for a full date plus WPF-UI's clear button while focused. -->
                <ui:TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="{Binding YearPlaceholder}"
                            ToolTip="A year (2026), or a full date written year-month-day (2026-10-02)."
                            HorizontalAlignment="Left" Width="140" Margin="0,0,0,8" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Track" VerticalAlignment="Center" Margin="0,0,0,8"
                           Visibility="{Binding IsTrackMode, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8"
                            Visibility="{Binding IsTrackMode, Converter={StaticResource BoolToVisibility}}">
                    <ui:TextBox Text="{Binding TrackNumber, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                    <TextBlock Text="of" VerticalAlignment="Center" Margin="8,0,8,0"
                               Foreground="{DynamicResource AfTextTertiary}" />
                    <ui:TextBox Text="{Binding TrackCount, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                </StackPanel>

                <!-- Album mode has no track number to pair it with, so the total stands alone. -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Track Count" VerticalAlignment="Center" Margin="0,0,0,8"
                           Visibility="{Binding IsAlbumMode, Converter={StaticResource BoolToVisibility}}" />
                <ui:TextBox Grid.Row="5" Grid.Column="1" Text="{Binding TrackCount, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="{Binding TrackCountPlaceholder}"
                            HorizontalAlignment="Left" Width="80" Margin="0,0,0,8"
                            Visibility="{Binding IsAlbumMode, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Disc" VerticalAlignment="Center" Margin="0,0,0,8" />
                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:TextBox Text="{Binding DiscNumber, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{Binding DiscNumberPlaceholder}" Width="80" />
                    <TextBlock Text="of" VerticalAlignment="Center" Margin="8,0,8,0"
                               Foreground="{DynamicResource AfTextTertiary}" />
                    <ui:TextBox Text="{Binding DiscCount, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{Binding DiscCountPlaceholder}" Width="80" />
                </StackPanel>

                <!-- Each detail field has a clear button. In the album dialog it is the
                     only way to clear a field the tracks disagree on: that box starts
                     empty, and an empty box there means "keep each track's own". -->
                <TextBlock Grid.Row="7" Grid.Column="0" Text="Publisher" VerticalAlignment="Center" Margin="0,0,0,8" />
                <DockPanel Grid.Row="7" Grid.Column="1" Margin="0,0,0,8">
                    <ui:Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="6" VerticalAlignment="Center"
                               Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss16}"
                               Command="{Binding ClearFieldCommand}" CommandParameter="Publisher"
                               ToolTip="{Binding ClearToolTip}" AutomationProperties.Name="Clear Publisher" />
                    <ui:TextBox Text="{Binding Publisher, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{Binding PublisherPlaceholder}" />
                </DockPanel>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="Composer" VerticalAlignment="Center" Margin="0,0,0,8" />
                <DockPanel Grid.Row="8" Grid.Column="1" Margin="0,0,0,8">
                    <ui:Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="6" VerticalAlignment="Center"
                               Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss16}"
                               Command="{Binding ClearFieldCommand}" CommandParameter="Composer"
                               ToolTip="{Binding ClearToolTip}" AutomationProperties.Name="Clear Composer" />
                    <ui:TextBox Text="{Binding Composer, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{Binding ComposerPlaceholder}"
                                ToolTip="Separate several composers with a semicolon." />
                </DockPanel>

                <TextBlock Grid.Row="9" Grid.Column="0" Text="Conductor" VerticalAlignment="Center" Margin="0,0,0,8" />
                <DockPanel Grid.Row="9" Grid.Column="1" Margin="0,0,0,8">
                    <ui:Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="6" VerticalAlignment="Center"
                               Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss16}"
                               Command="{Binding ClearFieldCommand}" CommandParameter="Conductor"
                               ToolTip="{Binding ClearToolTip}" AutomationProperties.Name="Clear Conductor" />
                    <ui:TextBox Text="{Binding Conductor, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{Binding ConductorPlaceholder}" />
                </DockPanel>

                <TextBlock Grid.Row="10" Grid.Column="0" Text="Genre" VerticalAlignment="Center" Margin="0,0,0,8" />
                <DockPanel Grid.Row="10" Grid.Column="1" Margin="0,0,0,8">
                    <ui:Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="6" VerticalAlignment="Center"
                               Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss16}"
                               Command="{Binding ClearFieldCommand}" CommandParameter="Genre"
                               ToolTip="{Binding ClearToolTip}" AutomationProperties.Name="Clear Genre" />
                    <ui:TextBox Text="{Binding Genre, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{Binding GenrePlaceholder}"
                                ToolTip="Separate several genres with a semicolon." />
                </DockPanel>

                <!-- Top-aligned label: the box grows with the text, up to MaxHeight, then scrolls. -->
                <TextBlock Grid.Row="11" Grid.Column="0" Text="Comments" VerticalAlignment="Top" Margin="0,8,0,0" />
                <DockPanel Grid.Row="11" Grid.Column="1">
                    <ui:Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="6" VerticalAlignment="Top"
                               Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss16}"
                               Command="{Binding ClearFieldCommand}" CommandParameter="Comment"
                               ToolTip="{Binding ClearToolTip}" AutomationProperties.Name="Clear Comments" />
                    <ui:TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{Binding CommentPlaceholder}"
                                AcceptsReturn="True" TextWrapping="Wrap"
                                MinHeight="64" MaxHeight="140"
                                VerticalScrollBarVisibility="Auto"
                                VerticalContentAlignment="Top" />
                </DockPanel>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="2" Margin="20,4,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding ValidationError}"
                       Foreground="{DynamicResource AfStatusDangerText}"
                       FontSize="{DynamicResource AfFontSizeBody}" VerticalAlignment="Center"
                       TextWrapping="Wrap" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" />
                <ui:Button Content="Save" Appearance="Primary" IsEnabled="{Binding CanSave}" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
