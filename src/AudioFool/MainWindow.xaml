<ui:FluentWindow x:Class="AudioFool.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:AudioFool"
                 xmlns:fmt="clr-namespace:AudioFool.Formatting"
                 xmlns:vm="clr-namespace:AudioFool.ViewModels"
                 xmlns:core="clr-namespace:AudioFool.Core.Models;assembly=AudioFool.Core"
                 xmlns:scrob="clr-namespace:AudioFool.Core.Scrobbling;assembly=AudioFool.Core"
                 Title="{Binding WindowTitle}"
                 Icon="/Resources/AudioFool.ico"
                 Width="1560" Height="900"
                 MinWidth="900" MinHeight="560"
                 WindowStartupLocation="Manual"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round">

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="MediaPlayPause" Command="{Binding TogglePlayCommand}" />
        <KeyBinding Key="MediaNextTrack" Command="{Binding NextCommand}" />
        <KeyBinding Key="MediaPreviousTrack" Command="{Binding PreviousCommand}" />
        <KeyBinding Key="MediaStop" Command="{Binding StopCommand}" />
        <KeyBinding Key="F5" Command="{Binding ScanCommand}" />
    </ui:FluentWindow.InputBindings>

    <ui:FluentWindow.Resources>
        <!--
            Freezable subclasses inherit DataContext, so this proxy ferries the
            ViewModel into CompositeCollection items that otherwise have none.
        -->
        <local:BindingProxy x:Key="Proxy" Data="{Binding}" />
        <CollectionViewSource x:Key="FolderFiltersSource"
                              Source="{Binding Data.FolderFilters, Source={StaticResource Proxy}}" />
        <fmt:IsCurrentTrackConverter x:Key="IsCurrentTrack" />

        <!--
            Artist and album rows. The look is entirely in AfBrowserRowTemplate,
            which a theme owns; these two styles stay here because the album row
            also carries a context menu whose command is bound through the proxy
            above, and a dictionary in Themes/ cannot reach a window resource.
        -->
        <Style x:Key="BrowserRow" TargetType="ListBoxItem">
            <Setter Property="Template" Value="{DynamicResource AfBrowserRowTemplate}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="{DynamicResource AfPadRow}" />
            <Setter Property="Margin" Value="{DynamicResource AfPadRowMargin}" />
        </Style>

        <Style x:Key="AlbumRow" TargetType="ListBoxItem" BasedOn="{StaticResource BrowserRow}">
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="Edit Album Tags…"
                                  Command="{Binding Source={StaticResource Proxy}, Path=Data.EditAlbumTagsCommand}"
                                  CommandParameter="{Binding}" />
                    </ContextMenu>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- title bar -->
            <RowDefinition Height="*" />      <!-- browser -->
            <RowDefinition Height="Auto" />   <!-- now playing -->
            <RowDefinition Height="Auto" />   <!-- status -->
        </Grid.RowDefinitions>

        <!--
            The shell surface. First in the Grid so it draws behind everything
            else - a theme may put its plate, texture or geometry here, and it is
            the only place any of those are allowed to go. Dark and Vista leave
            the template empty and let the window backdrop show through.
        -->
        <Control Grid.Row="0" Grid.RowSpan="4"
                 Template="{DynamicResource AfWindowDecor}"
                 Focusable="False" IsTabStop="False" IsHitTestVisible="False" />

        <ui:TitleBar Grid.Row="0">
            <!--
                The logo is the File-style menu: clicking the mark drops the output
                and library controls that used to sit in the toolbar. No text label -
                the mark carries the identity, and the width that frees goes to the
                search box, whose right edge still lines up with the Albums panel.
            -->
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!--
                    The logo is drawn *over* the menu item, not inside it as its
                    Header. WPF-UI's top-level menu template caps header content at
                    20 px tall and layout-clips anything taller, which cropped 5 px
                    off the top and bottom of the 30 px mark. So the item carries a
                    transparent spacer the width of the mark, the mark is drawn on
                    top of it, and IsHitTestVisible="False" lets the click fall
                    through to the item underneath. The hover highlight and the
                    drop-down are WPF-UI's own, untouched.

                    The spacer takes its width from the mark rather than repeating a
                    number that depends on the image's aspect; 20 px is the cap, and
                    keeping the spacer at it leaves the item the size it has always
                    been.
                -->
                <Grid>
                    <Menu Background="Transparent" VerticalAlignment="Center">
                        <!--
                            FontWeight is set here for the submenu, not the header:
                            menu items inherit it from the item that owns them.
                        -->
                        <MenuItem FontWeight="{DynamicResource AfFontWeightSemiBold}"
                                  AutomationProperties.Name="AudioFool"
                                  ToolTip="AudioFool menu">
                            <MenuItem.Header>
                                <Border Height="20" Background="Transparent"
                                        Width="{Binding ActualWidth, ElementName=BrandMark, Mode=OneWay}" />
                            </MenuItem.Header>
                            <MenuItem Header="DSD passthrough"
                                      IsCheckable="True"
                                      IsChecked="{Binding IsDsdPassthrough, Mode=TwoWay}"
                                      IsEnabled="{Binding CanUseDsdPassthrough}">
                                <MenuItem.ToolTip>
                                    <TextBlock>
                                        Send DSD to the DAC untouched, wrapped as DSD-over-PCM,<LineBreak />
                                        instead of decoding it to PCM first.<LineBreak /><LineBreak />
                                        Needs bit-perfect output and a DoP-capable DAC. Falls back<LineBreak />
                                        to PCM conversion for any file the device can't clock.
                                    </TextBlock>
                                </MenuItem.ToolTip>
                            </MenuItem>
        
                            <Separator />
        
                            <MenuItem Header="Libraries"
                                      Icon="{ui:SymbolIcon Folder24}">
                                <MenuItem.ItemContainerStyle>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Header" Value="{Binding FolderPath}" />
                                        <Setter Property="IsCheckable" Value="True" />
                                        <Setter Property="IsChecked" Value="{Binding IsEnabled, Mode=TwoWay}" />
                                    </Style>
                                </MenuItem.ItemContainerStyle>
                                <MenuItem.ItemsSource>
                                    <CompositeCollection>
                                        <CollectionContainer Collection="{Binding Source={StaticResource FolderFiltersSource}}" />
                                        <Separator />
                                        <MenuItem Header="Add folder…"
                                                  Icon="{ui:SymbolIcon FolderAdd24}"
                                                  Command="{Binding Source={StaticResource Proxy}, Path=Data.AddFolderCommand}" />
                                    </CompositeCollection>
                                </MenuItem.ItemsSource>
                            </MenuItem>
        
                            <Separator />
        
                            <MenuItem Header="Themes"
                                      Icon="{ui:SymbolIcon Color24}"
                                      ItemsSource="{Binding ThemeItems}">
                                <MenuItem.ItemContainerStyle>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Header" Value="{Binding Name}" />
                                        <Setter Property="IsCheckable" Value="True" />
                                        <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=TwoWay}" />
                                    </Style>
                                </MenuItem.ItemContainerStyle>
                            </MenuItem>

                            <Separator />

                            <MenuItem Header="Statistics…"
                                      Icon="{ui:SymbolIcon DataBarVertical24}"
                                      Command="{Binding ShowStatisticsCommand}" />

                            <MenuItem Header="Last.fm…"
                                      Icon="{ui:SymbolIcon Live24}"
                                      Command="{Binding ShowLastFmCommand}" />
                        </MenuItem>
                    </Menu>

                    <Control x:Name="BrandMark"
                             Template="{DynamicResource AfBrandMark}"
                             Height="{DynamicResource AfSizeBrandMark}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                </Grid>

                <ui:TextBox x:Name="SearchBox"
                            Width="406"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Search"
                            ClearButtonEnabled="True"
                            Icon="{ui:SymbolIcon Search24}"
                            AutomationProperties.Name="Search"
                            ToolTip="Search artists, albums and songs" />

                <!--
                    The Statistics filter, while one is on. Beside the search box
                    because the two combine - search runs inside the filter - and
                    after it, so the box keeps its right edge level with Albums.
                    Clicking anywhere on the chip clears it.
                -->
                <ui:Button x:Name="LibraryFilterChip"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Icon="{ui:SymbolIcon Filter16}"
                           Command="{Binding ClearLibraryFilterCommand}"
                           Visibility="{Binding IsFiltered, Converter={StaticResource BoolToVisibility}}"
                           AutomationProperties.Name="{Binding LibraryFilter.Description, StringFormat=Clear filter: {0}}"
                           ToolTip="Showing only these tracks. Click to show the whole library again.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding LibraryFilter.Description}" VerticalAlignment="Center" />
                        <ui:SymbolIcon Symbol="Dismiss12" Margin="8,0,0,0" VerticalAlignment="Center"
                                       FontSize="{DynamicResource AfIconSizeMicro}" />
                    </StackPanel>
                </ui:Button>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- The moulding seam where the title strip meets the browser. Warm grey
             in PS1, invisible in the themes that do not use it. -->
        <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                Background="{DynamicResource AfStrokeWarm}"
                IsHitTestVisible="False" />

        <!-- ============================================ artist | album | tracks -->
        <Grid Grid.Row="1" Margin="{DynamicResource AfPadWindowBrowser}">
            <!-- Panes are deliberately narrow: the ten track columns need ~940px. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="140" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="260" MinWidth="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- artists -->
            <HeaderedContentControl Grid.Column="0" Style="{DynamicResource AfPane}">
                <HeaderedContentControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <Control Template="{DynamicResource AfPaneMarkArtists}" VerticalAlignment="Center"
                                 Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                        <TextBlock Text="ARTISTS" Style="{DynamicResource AfPaneHeaderText}" />
                    </StackPanel>
                </HeaderedContentControl.Header>
                <ListBox x:Name="ArtistList"
                         ItemsSource="{Binding Artists}"
                         SelectedItem="{Binding SelectedArtist, Mode=TwoWay}"
                         SelectionChanged="BrowserList_SelectionChanged"
                         MouseDoubleClick="ArtistList_MouseDoubleClick"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         Padding="{DynamicResource AfPadListInner}"
                         ItemContainerStyle="{StaticResource BrowserRow}"
                         AutomationProperties.Name="Artists"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type core:ArtistGroup}">
                            <StackPanel Margin="0,3">
                                <TextBlock Text="{Binding Name}"
                                           Style="{DynamicResource AfRowTitle}" />
                                <TextBlock Text="{Binding AlbumSummary}"
                                           Style="{DynamicResource AfMetaText}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </HeaderedContentControl>

            <GridSplitter Grid.Column="1" Width="{DynamicResource AfSizeSplitter}"
                          HorizontalAlignment="Center"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <!-- albums, oldest first -->
            <HeaderedContentControl Grid.Column="2" Style="{DynamicResource AfPane}">
                <HeaderedContentControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <Control Template="{DynamicResource AfPaneMarkAlbums}" VerticalAlignment="Center"
                                 Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                        <TextBlock Text="ALBUMS" Style="{DynamicResource AfPaneHeaderText}" />
                    </StackPanel>
                </HeaderedContentControl.Header>
                <ListBox x:Name="AlbumList"
                         ItemsSource="{Binding Albums}"
                         SelectedItem="{Binding SelectedAlbum, Mode=TwoWay}"
                         SelectionChanged="BrowserList_SelectionChanged"
                         MouseDoubleClick="AlbumList_MouseDoubleClick"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         Padding="{DynamicResource AfPadListInner}"
                         ItemContainerStyle="{StaticResource AlbumRow}"
                         AutomationProperties.Name="Albums"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AlbumItemViewModel}">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="{DynamicResource AfSizeArtRow}"
                                        Height="{DynamicResource AfSizeArtRow}"
                                        Style="{DynamicResource AfArtFrame}">
                                    <Grid>
                                        <ui:SymbolIcon Symbol="MusicNote224"
                                                       FontSize="{DynamicResource AfIconSizeMedium}"
                                                       Foreground="{DynamicResource AfTextPlaceholder}"
                                                       Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisible}}" />
                                        <Image Source="{Binding Thumbnail}"
                                               Stretch="UniformToFill"
                                               Visibility="{Binding Thumbnail, Converter={StaticResource NullToCollapsed}}" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Margin="{DynamicResource AfPadBesideArt}"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               Style="{DynamicResource AfRowTitle}" />
                                    <TextBlock Style="{DynamicResource AfMetaText}">
                                        <Run Text="{Binding YearDisplay, Mode=OneWay}" />
                                        <Run Text="·" />
                                        <Run Text="{Binding TrackSummary, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </HeaderedContentControl>

            <GridSplitter Grid.Column="3" Width="{DynamicResource AfSizeSplitter}"
                          HorizontalAlignment="Center"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <!--
                Album header + tracks, styled as the display rather than a plain
                pane: it is the one surface a theme may put texture behind, and
                the album facts ride on its header strip.
            -->
            <HeaderedContentControl Grid.Column="4" Style="{DynamicResource AfPaneDisplay}">
                <!-- big album art + album facts -->
                <HeaderedContentControl.Header>
                    <Grid Margin="{DynamicResource AfPadAlbumHeader}"
                          Visibility="{Binding SelectedAlbum, Converter={StaticResource NullToCollapsed}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="{DynamicResource AfSizeArtHeader}"
                                Height="{DynamicResource AfSizeArtHeader}"
                                Style="{DynamicResource AfArtFrameLarge}"
                                Cursor="Hand"
                                MouseLeftButtonDown="AlbumArt_MouseLeftButtonDown">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Edit Album Tags…"
                                              Command="{Binding Source={StaticResource Proxy}, Path=Data.EditAlbumTagsCommand}"
                                              CommandParameter="{Binding Source={StaticResource Proxy}, Path=Data.SelectedAlbum}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <ui:SymbolIcon Symbol="MusicNote224"
                                               FontSize="{DynamicResource AfIconSizeHero}"
                                               Foreground="{DynamicResource AfTextPlaceholder}"
                                               Visibility="{Binding SelectedAlbumArt, Converter={StaticResource NullToVisible}}" />
                                <Image Source="{Binding SelectedAlbumArt}" Stretch="UniformToFill"
                                       Visibility="{Binding SelectedAlbumArt, Converter={StaticResource NullToCollapsed}}" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="{DynamicResource AfPadBesideArtLarge}"
                                    VerticalAlignment="Center">
                            <DockPanel>
                                <Control DockPanel.Dock="Left" Template="{DynamicResource AfPaneMarkTracks}"
                                         VerticalAlignment="Center"
                                         Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                                <TextBlock Text="{Binding AlbumHeaderTitle}"
                                           Style="{DynamicResource AfAlbumTitle}" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding AlbumHeaderSubtitleLines}"
                                          Margin="0,6,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Style="{DynamicResource AfMetaText}"
                                                   FontSize="{DynamicResource AfFontSizeBody}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </HeaderedContentControl.Header>

                <Grid>
                    <!-- the ten columns, in track order -->
                    <DataGrid x:Name="TrackGrid"
                              ItemsSource="{Binding Tracks}"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              SelectionChanged="TrackGrid_SelectionChanged"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="True"
                              CanUserSortColumns="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeight="{DynamicResource AfSizeTrackRowHeight}"
                              AlternationCount="2"
                              AutomationProperties.Name="Tracks"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="False"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              PreviewMouseLeftButtonDown="TrackGrid_PreviewMouseLeftButtonDown"
                              MouseDoubleClick="TrackGrid_MouseDoubleClick"
                              PreviewKeyDown="TrackGrid_PreviewKeyDown"
                              BeginningEdit="TrackGrid_BeginningEdit"
                              CellEditEnding="TrackGrid_CellEditEnding">
                        <!--
                            DisplayIndex is pinned on every column on purpose. Left
                            to itself, DataGrid's width-distribution pass shuffles a
                            star-width column ("Song") to the end of the row, which
                            put Song fourth instead of second.
                        -->
                        <DataGrid.RowStyle>
                            <!--
                                Deliberately not BasedOn="{StaticResource {x:Type DataGridRow}}" -
                                that base style's own unconditional Background setter paints
                                every row solid white, regardless of selection. Transparent by
                                default (matching the DataGrid's own Background) and an explicit
                                highlight on selection replicate the original look without
                                inheriting whatever that base style actually does.

                                Property setters rather than a template, because this style
                                also carries a context menu and an event handler that can only
                                live here.

                                The left marker on a selected row is drawn by IndicatorColumn's
                                cell, not by a row border. A border that appears on selection
                                takes layout space, so every cell of the selected row slid right
                                by its width.
                            -->
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <!--
                                    A DataGridRow doesn't select itself on right-click the
                                    way a ListBoxItem does, so without this the context menu
                                    would act on whatever was last left-clicked instead of the
                                    row actually under the cursor.
                                -->
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="TrackGridRow_PreviewMouseRightButtonDown" />
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <MenuItem Header="Edit Tags…"
                                                      Command="{Binding Source={StaticResource Proxy}, Path=Data.EditTrackTagsCommand}"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <!-- Banding, then hover, then selection: later triggers
                                         win, so a selected odd row still reads as selected. -->
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                        <Setter Property="Background"
                                                Value="{DynamicResource AfSurfaceRowAlternate}" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource AfSurfaceRowHover}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource AfSurfaceTrackSelected}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <!-- Now-playing indicator: shows a music note on the active row -->
                            <DataGridTemplateColumn x:Name="IndicatorColumn" Width="22" DisplayIndex="0" CanUserSort="False" CanUserResize="False" IsReadOnly="True">
                                <!--
                                    This cell also draws the selected row's left marker (PS1's
                                    blue bar; zero width in the other themes). It lives here,
                                    overlaid on the cell, so it takes no layout space: as a row
                                    border it pushed the selected row's cells right by its width.
                                    A full cell style, not BasedOn, so no theme's cell padding
                                    can inset the bar from the row edge.

                                    Keyboard focus brightens the marker instead of outlining a
                                    cell. A dotted focus rectangle is the traditional answer and
                                    was tried; inside a cell it boxes the song title and reads
                                    as an edit field.
                                -->
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                                        <Border x:Name="SelectionBar"
                                                                BorderBrush="Transparent"
                                                                BorderThickness="{DynamicResource AfStrokeSelectionBarThickness}" />
                                                        <ContentPresenter VerticalAlignment="Center" />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                            <Setter TargetName="SelectionBar" Property="BorderBrush"
                                                                    Value="{DynamicResource AfStrokeTrackSelectionBar}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                            <Setter TargetName="SelectionBar" Property="BorderBrush"
                                                                    Value="{DynamicResource AfFocusRing}" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGridTemplateColumn.CellStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Control Template="{DynamicResource AfNowPlayingGlyph}"
                                                 Focusable="False" IsTabStop="False"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 ToolTip="Now playing">
                                            <Control.Visibility>
                                                <MultiBinding Converter="{StaticResource IsCurrentTrack}">
                                                    <Binding />
                                                    <Binding Source="{StaticResource Proxy}" Path="Data.NowPlaying" />
                                                </MultiBinding>
                                            </Control.Visibility>
                                        </Control>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <local:InlineEditColumn x:Name="TrackNumberColumn" Header="#" Width="44" DisplayIndex="1"
                                                Binding="{Binding TrackNumber, Converter={StaticResource Number}, Mode=OneWay}"
                                                SortMemberPath="TrackNumber"
                                                ElementStyle="{DynamicResource AfNumericCell}"
                                                EditingElementStyle="{DynamicResource AfNumericCellEditBox}" />

                            <local:InlineEditColumn x:Name="SongColumn" Header="Song" Width="*" MinWidth="180" DisplayIndex="2"
                                                Binding="{Binding DisplayTitle, Mode=OneWay}"
                                                ElementStyle="{DynamicResource AfTrackTitleCell}"
                                                EditingElementStyle="{DynamicResource AfCellEditBox}" />

                            <local:InlineEditColumn x:Name="ArtistColumn" Header="Artist" Width="140" DisplayIndex="3"
                                                Binding="{Binding Artist, Mode=OneWay}"
                                                EditingElementStyle="{DynamicResource AfCellEditBox}" />

                            <local:InlineEditColumn x:Name="AlbumColumn" Header="Album" Width="150" DisplayIndex="4"
                                                Binding="{Binding Album, Mode=OneWay}"
                                                EditingElementStyle="{DynamicResource AfCellEditBox}" />

                            <DataGridTextColumn x:Name="TimeColumn" IsReadOnly="True" Header="Time" Width="60" DisplayIndex="5"
                                                Binding="{Binding Duration, Converter={StaticResource Duration}}"
                                                SortMemberPath="Duration"
                                                ElementStyle="{DynamicResource AfNumericCell}" />

                            <DataGridTextColumn x:Name="DiscColumn" IsReadOnly="True" Header="Disc" Width="46" DisplayIndex="6"
                                                Binding="{Binding DiscNumber, Converter={StaticResource Number}}"
                                                SortMemberPath="DiscNumber"
                                                ElementStyle="{DynamicResource AfNumericCell}" />


                            <DataGridTextColumn x:Name="KindColumn" IsReadOnly="True" Header="Kind" Width="74" DisplayIndex="7"
                                                Binding="{Binding Kind}" />

                            <DataGridTextColumn x:Name="BitrateColumn" IsReadOnly="True" Header="Bitrate" Width="82" DisplayIndex="8"
                                                Binding="{Binding Bitrate, Converter={StaticResource Bitrate}}"
                                                SortMemberPath="Bitrate"
                                                ElementStyle="{DynamicResource AfNumericCell}" />

                            <DataGridTextColumn x:Name="BitDepthColumn" IsReadOnly="True" Header="Bit Depth" Width="72" DisplayIndex="9"
                                                Binding="{Binding BitDepth, Converter={StaticResource BitDepth}}"
                                                SortMemberPath="BitDepth"
                                                ElementStyle="{DynamicResource AfNumericCell}" />

                            <DataGridTextColumn x:Name="SampleRateColumn" IsReadOnly="True" Header="Sample Rate" Width="94" DisplayIndex="10"
                                                Binding="{Binding SampleRate, Converter={StaticResource SampleRate}}"
                                                SortMemberPath="SampleRate"
                                                ElementStyle="{DynamicResource AfNumericCell}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Nothing chosen yet. Draws nothing at all unless the theme
                         fills the slot, so the pane is simply empty in Dark. -->
                    <Control Template="{DynamicResource AfEmptyState}"
                             Focusable="False" IsTabStop="False" IsHitTestVisible="False"
                             Visibility="{Binding SelectedAlbum, Converter={StaticResource NullToVisible}}" />
                </Grid>
            </HeaderedContentControl>
        </Grid>

        <!-- ============================================ now playing -->
        <ContentControl Grid.Row="2"
                        Style="{DynamicResource AfDeck}"
                        Margin="{DynamicResource AfPadWindowDeck}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- cover -->
                <Border Grid.Column="0"
                        Width="{DynamicResource AfSizeArtDeck}"
                        Height="{DynamicResource AfSizeArtDeck}"
                        Style="{DynamicResource AfArtFrame}"
                        Cursor="Hand"
                        MouseLeftButtonDown="NowPlayingArt_MouseLeftButtonDown">
                    <Grid>
                        <ui:SymbolIcon Symbol="MusicNote224"
                                       FontSize="{DynamicResource AfIconSizeLarge}"
                                       Foreground="{DynamicResource AfTextPlaceholder}"
                                       Visibility="{Binding NowPlayingArt, Converter={StaticResource NullToVisible}}" />
                        <Image Source="{Binding NowPlayingArt}" Stretch="UniformToFill"
                               Visibility="{Binding NowPlayingArt, Converter={StaticResource NullToCollapsed}}" />
                    </Grid>
                </Border>

                <!-- what's playing -->
                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center"
                            Cursor="Hand"
                            MouseLeftButtonDown="NowPlayingInfo_MouseLeftButtonDown">
                    <TextBlock x:Name="NowPlayingTitle"
                               Text="{Binding NowPlaying.DisplayTitle, FallbackValue='', TargetNullValue=''}"
                               Style="{DynamicResource AfRowTitle}"
                               FontWeight="{DynamicResource AfFontWeightSemiBold}" />
                    <TextBlock Text="{Binding NowPlaying.Artist, TargetNullValue=''}"
                               Style="{DynamicResource AfMetaText}" />
                    <TextBlock Style="{DynamicResource AfMetaTextQuiet}"
                               Visibility="{Binding NowPlaying, Converter={StaticResource NullToCollapsed}}">
                        <Run Text="{Binding NowPlaying.Kind, Mode=OneWay}" />
                        <Run Text="·" />
                        <Run Text="{Binding NowPlaying.SampleRate, Mode=OneWay, Converter={StaticResource SampleRate}}" />
                    </TextBlock>
                </StackPanel>

                <!-- transport -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!--
                        Shuffle and repeat flank the three transport buttons, where
                        every other player has trained people to look for them. Both
                        swap glyph as well as tint: an accent colour on its own is a
                        weak "on" signal next to a Primary-appearance play button.
                    -->
                    <ui:Button Command="{Binding ToggleShuffleCommand}"
                               Appearance="Secondary"
                               Margin="0,0,8,0"
                               AutomationProperties.Name="Shuffle"
                               ToolTip="{Binding ShuffleTooltip}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon>
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="ArrowShuffleOff24" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsShuffle}" Value="True">
                                                <Setter Property="Symbol" Value="ArrowShuffle24" />
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource AfStateQueue}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button Command="{Binding PreviousCommand}"
                               Style="{DynamicResource AfSkipKey}"
                               Icon="{ui:SymbolIcon Previous24}"
                               AutomationProperties.Name="Previous track"
                               ToolTip="Previous (or restart)" />

                    <!-- Appearance comes from the style, not from here: a theme that
                         colours this key needs it off Primary, whose colours WPF-UI
                         sets in template triggers that no style can override. -->
                    <ui:Button Command="{Binding TogglePlayCommand}"
                               Style="{DynamicResource AfPlayKey}"
                               Width="46" Height="38"
                               Margin="8,0"
                               AutomationProperties.Name="Play or pause"
                               ToolTip="Play / pause">
                        <ui:Button.Icon>
                            <ui:SymbolIcon>
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="Play24" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Symbol" Value="Pause24" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button Command="{Binding NextCommand}"
                               Style="{DynamicResource AfSkipKey}"
                               Icon="{ui:SymbolIcon Next24}"
                               AutomationProperties.Name="Next track"
                               ToolTip="Next" />

                    <!-- Three-way cycle: off, whole queue, this track. -->
                    <ui:Button Command="{Binding CycleRepeatCommand}"
                               Appearance="Secondary"
                               Margin="8,0,0,0"
                               AutomationProperties.Name="Repeat"
                               ToolTip="{Binding RepeatTooltip}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon>
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="ArrowRepeatAllOff24" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRepeatAll}" Value="True">
                                                <Setter Property="Symbol" Value="ArrowRepeatAll24" />
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource AfStateQueue}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsRepeatOne}" Value="True">
                                                <Setter Property="Symbol" Value="ArrowRepeat124" />
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource AfStateQueue}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>

                <!-- seek -->
                <Grid Grid.Column="3" Margin="16,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="PositionText" Grid.Column="0" Text="{Binding PositionDisplay}"
                               Style="{DynamicResource AfReadout}"
                               MinWidth="42" TextAlignment="Right" />

                    <Slider x:Name="SeekBar" Grid.Column="1"
                            Margin="10,0"
                            Style="{DynamicResource AfSlider}"
                            Foreground="{DynamicResource AfSliderSeekFill}"
                            Minimum="0"
                            Maximum="{Binding DurationSeconds}"
                            Value="{Binding PositionSeconds, Mode=TwoWay}"
                            IsMoveToPointEnabled="True"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Playback position"
                            Thumb.DragStarted="SeekBar_DragStarted"
                            Thumb.DragCompleted="SeekBar_DragCompleted"
                            PreviewMouseLeftButtonUp="SeekBar_PreviewMouseLeftButtonUp" />

                    <TextBlock x:Name="DurationText" Grid.Column="2" Text="{Binding DurationDisplay}"
                               Style="{DynamicResource AfReadout}"
                               MinWidth="42" />
                </Grid>

                <!--
                    Volume goes dead in exclusive mode, where the gain has to stay at
                    unity. The whole group dims: WPF-UI's disabled Slider still draws
                    an accent-coloured thumb, which reads as active.
                -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                            ToolTip="{Binding VolumeTooltip}"
                            Opacity="{Binding IsVolumeEnabled, Converter={StaticResource EnabledOpacity}}">
                    <ui:SymbolIcon Symbol="Speaker224"
                                   FontSize="{DynamicResource AfIconSizeSmall}"
                                   VerticalAlignment="Center" />
                    <Slider Width="96" Margin="8,0,0,0"
                            Style="{DynamicResource AfSlider}"
                            Minimum="0" Maximum="1"
                            SmallChange="0.05" LargeChange="0.1"
                            IsMoveToPointEnabled="True"
                            Value="{Binding Volume, Mode=TwoWay}"
                            IsEnabled="{Binding IsVolumeEnabled}"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Volume" />
                </StackPanel>
            </Grid>
        </ContentControl>

        <!-- ============================================ status -->
        <Grid Grid.Row="3" Margin="{DynamicResource AfPadWindowStatus}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ui:Button Command="{Binding ScanCommand}"
                           Icon="{ui:SymbolIcon ArrowClockwise16}"
                           Appearance="Transparent"
                           Padding="2"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center"
                           IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}"
                           AutomationProperties.Name="Rescan library"
                           ToolTip="Rescan library" />

                <!-- Library state as a shape and a colour, beside the words that
                     say the same thing. Empty in Dark, and zero-width with it. -->
                <Control Template="{DynamicResource AfStatusLamp}"
                         VerticalAlignment="Center"
                         Focusable="False" IsTabStop="False"
                         AutomationProperties.Name="Library status" />

                <TextBlock Text="{Binding StatusText}"
                           Style="{DynamicResource AfMetaText}"
                           VerticalAlignment="Center" />

                <!--
                    Separator and readout share one panel so the dangling "·"
                    disappears with the text, rather than sitting there alone.
                -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsOutputActive, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="  ·  "
                               Style="{DynamicResource AfMetaTextQuiet}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding OutputDescription}"
                               Style="{DynamicResource AfReadout}"
                               ToolTip="{Binding OutputDeviceName}" />
                </StackPanel>
            </StackPanel>

            <ProgressBar Grid.Column="1"
                         Width="180" Height="4"
                         Minimum="0" Maximum="1"
                         Value="{Binding ScanFraction}"
                         VerticalAlignment="Center"
                         AutomationProperties.Name="Scan progress"
                         Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />

            <!--
                Last.fm, when connected: a dot and a word, and the word changes with
                the state, so the colour is never the only signal. Hidden until
                connected. Clicking opens the Last.fm window.
            -->
            <ui:Button x:Name="LastFmIndicator" Grid.Column="2"
                       Command="{Binding ShowLastFmCommand}"
                       Appearance="Transparent"
                       Padding="6,2"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       ToolTip="{Binding LastFmToolTip}"
                       AutomationProperties.Name="{Binding LastFmLabel}"
                       AutomationProperties.HelpText="{Binding LastFmToolTip}"
                       Visibility="{Binding IsLastFmShown, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                             Stroke="{DynamicResource AfStatusKeyline}"
                             StrokeThickness="{DynamicResource AfStatusKeylineThickness}">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource AfStatusOk}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LastFmState}" Value="{x:Static scrob:ScrobblerState.Off}">
                                        <Setter Property="Fill" Value="{DynamicResource AfStatusIdle}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LastFmState}" Value="{x:Static scrob:ScrobblerState.Failing}">
                                        <Setter Property="Fill" Value="{DynamicResource AfStatusCaution}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LastFmState}" Value="{x:Static scrob:ScrobblerState.NeedsReconnect}">
                                        <Setter Property="Fill" Value="{DynamicResource AfStatusDanger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding LastFmLabel}"
                               Style="{DynamicResource AfMetaText}"
                               FontSize="{DynamicResource AfFontSizeSmall}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </ui:Button>

            <ToggleButton Grid.Column="3"
                          Content="Bit-Perfect"
                          IsChecked="{Binding IsExclusiveOutput, Mode=TwoWay}"
                          IsEnabled="{Binding CanUseExclusiveOutput}"
                          FontSize="{DynamicResource AfFontSizeSmall}"
                          VerticalAlignment="Center"
                          Margin="8,0,0,0"
                          Padding="{DynamicResource AfPadUtilityKey}">
                <ToggleButton.ToolTip>
                    <TextBlock>
                        Exclusive WASAPI: opens the sound device at each track's own<LineBreak />
                        sample rate, so nothing is resampled on the way out.<LineBreak /><LineBreak />
                        Other applications go silent while music is playing, and the<LineBreak />
                        volume slider is fixed at 100%.
                    </TextBlock>
                </ToggleButton.ToolTip>
            </ToggleButton>
        </Grid>
    </Grid>
</ui:FluentWindow>
