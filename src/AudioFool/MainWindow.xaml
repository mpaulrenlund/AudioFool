<ui:FluentWindow x:Class="AudioFool.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:AudioFool"
                 xmlns:fmt="clr-namespace:AudioFool.Formatting"
                 xmlns:vm="clr-namespace:AudioFool.ViewModels"
                 xmlns:core="clr-namespace:AudioFool.Core.Models;assembly=AudioFool.Core"
                 xmlns:scrob="clr-namespace:AudioFool.Core.Scrobbling;assembly=AudioFool.Core"
                 xmlns:theme="clr-namespace:AudioFool.Theming"
                 Title="{Binding WindowTitle}"
                 Icon="/Resources/AudioFool.ico"
                 Width="1560" Height="900"
                 MinWidth="900" MinHeight="560"
                 WindowStartupLocation="Manual"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round">

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="MediaPlayPause" Command="{Binding TogglePlayCommand}" />
        <KeyBinding Key="MediaNextTrack" Command="{Binding NextCommand}" />
        <KeyBinding Key="MediaPreviousTrack" Command="{Binding PreviousCommand}" />
        <KeyBinding Key="MediaStop" Command="{Binding StopCommand}" />
        <KeyBinding Key="F5" Command="{Binding ScanCommand}" />
    </ui:FluentWindow.InputBindings>

    <ui:FluentWindow.Resources>
        <!--
            Freezable subclasses inherit DataContext, so this proxy ferries the
            ViewModel into CompositeCollection items that otherwise have none.
        -->
        <local:BindingProxy x:Key="Proxy" Data="{Binding}" />
        <CollectionViewSource x:Key="FolderFiltersSource"
                              Source="{Binding Data.FolderFilters, Source={StaticResource Proxy}}" />
        <CollectionViewSource x:Key="RemoveFoldersSource"
                              Source="{Binding Data.FolderFilters, Source={StaticResource Proxy}}" />
        <fmt:IsCurrentTrackConverter x:Key="IsCurrentTrack" />

        <!--
            Artist and album rows. The look is theme.browserRowTemplate
            (Theming/Chrome.xaml); the sizes are here per list, and the album row
            also carries a context menu whose command is bound through the proxy
            above, which a dictionary cannot reach.
        -->
        <Style x:Key="BrowserRow" TargetType="ListBoxItem">
            <Setter Property="Template" Value="{DynamicResource theme.browserRowTemplate}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="ArtistRow" TargetType="ListBoxItem" BasedOn="{StaticResource BrowserRow}">
            <Setter Property="Height" Value="{theme:Token artists.rowHeight}" />
            <Setter Property="Padding" Value="{theme:Thickness X=artists.rowPaddingX}" />
        </Style>

        <Style x:Key="AlbumRow" TargetType="ListBoxItem" BasedOn="{StaticResource BrowserRow}">
            <Setter Property="Height" Value="{theme:Token albums.rowHeight}" />
            <Setter Property="Padding" Value="{theme:Thickness X=albums.rowPaddingX, Y=albums.rowPaddingY}" />
            <Setter Property="Margin" Value="{theme:Thickness Bottom=albums.rowGap}" />
            <!-- What a screen reader speaks for the row; it would otherwise read
                 the view model's type name. -->
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="Edit Album Tags…"
                                  Command="{Binding Source={StaticResource Proxy}, Path=Data.EditAlbumTagsCommand}"
                                  CommandParameter="{Binding}" />
                    </ContextMenu>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The sublines go from muted to secondary on a selected row (6.3, 6.4). -->
        <Style x:Key="ArtistCountText" TargetType="TextBlock" BasedOn="{StaticResource type.artistCount}">
            <Setter Property="Margin" Value="{theme:Thickness Top=artists.lineGap}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource color.text.secondary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AlbumMetaText" TargetType="TextBlock" BasedOn="{StaticResource type.albumMeta}">
            <Setter Property="Margin" Value="{theme:Thickness Top=albums.lineGap}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource color.text.secondary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AlbumThumb" TargetType="Border">
            <Setter Property="Width" Value="{theme:Token albums.thumbSize}" />
            <Setter Property="Height" Value="{theme:Token albums.thumbSize}" />
            <Setter Property="BorderThickness" Value="{theme:Thickness All=layout.panelBorder}" />
            <Setter Property="BorderBrush" Value="{DynamicResource color.art.thumbBorder}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource color.art.thumbBorderSelected}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ARTISTS and ALBUMS (6.2): small grey capitals, tracked 0.12 em. -->
        <Style x:Key="PanelHeaderLabel" TargetType="TextBlock" BasedOn="{StaticResource type.panelHeader}">
            <Setter Property="fmt:LetterSpacing.Em" Value="{DynamicResource type.panelHeader.letterSpacingEm}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- title bar -->
            <RowDefinition Height="*" />      <!-- browser -->
            <RowDefinition Height="Auto" />   <!-- now playing -->
            <RowDefinition Height="Auto" />   <!-- status -->
        </Grid.RowDefinitions>

        <!--
            The window grey (spec 3): first in the Grid so it draws behind
            everything else - the title bar, the panel gaps and margins, around
            the playback bar and under the status bar.
        -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                Background="{DynamicResource color.window.bg}"
                IsHitTestVisible="False" />

        <!--
            6.1. The window buttons are WPF-UI's own, restyled by
            theme.windowButton; see Theming/Chrome.xaml for why they are not
            replaced. ButtonsBackground is the minimize/maximize hover, and
            PaletteRedBrush close's, the same grey (the user's call): WPF-UI's template sets that one directly.
        -->
        <ui:TitleBar x:Name="AppTitleBar"
                     Grid.Row="0"
                     Height="{theme:Token layout.titleBarHeight}"
                     Padding="0"
                     ButtonsBackground="{DynamicResource color.window.buttonHover}">
            <ui:TitleBar.Resources>
                <StaticResource x:Key="PaletteRedBrush" ResourceKey="color.window.buttonHover" />
                <Style TargetType="ui:TitleBarButton" BasedOn="{StaticResource theme.windowButton}" />
            </ui:TitleBar.Resources>
            <!--
                The logo is the File-style menu: clicking the mark drops the output
                and library controls that used to sit in the toolbar. No text label -
                the mark carries the identity.

                Positions are calculations, not numbers (spec 2, rules 1 and 2):
                AlignTitleBar centres the logo slot over the ARTISTS label and ends
                the search box at the Albums panel's right edge, and runs again
                whenever either panel changes size.
            -->
            <ui:TitleBar.Header>
                <StackPanel x:Name="TitleBarHeader" Orientation="Horizontal" VerticalAlignment="Center">
                <!--
                    The logo is drawn *over* the menu item, not inside it as its
                    Header. WPF-UI's top-level menu template caps header content at
                    20 px tall and layout-clips anything taller, which cropped 5 px
                    off the top and bottom of the 30 px mark. So the item carries a
                    transparent spacer, the mark is drawn on top of it, and
                    IsHitTestVisible="False" lets the click fall through to the
                    item underneath. The item has no hover highlight or tooltip
                    (theme.logoMenuItem); the drop-down is WPF-UI's own.

                    The spacer's width is set in code (FitLogoMenuToSlot) so the
                    whole item, WPF-UI's padding included, is exactly the width of
                    the logo slot. 20 px is WPF-UI's header cap, not a theme value.
                -->
                <Grid x:Name="LogoSlot"
                      Width="{theme:Token titleBar.logoSlot.width}"
                      Height="{theme:Token titleBar.logoSlot.height}">
                    <Menu Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <MenuItem x:Name="LogoMenuItem"
                                  Style="{StaticResource theme.logoMenuItem}"
                                  FocusVisualStyle="{DynamicResource theme.focusRing.inside}"
                                  AutomationProperties.Name="AudioFool">
                            <MenuItem.Header>
                                <Border x:Name="LogoMenuSpacer" Height="20" Background="Transparent" />
                            </MenuItem.Header>
                            <MenuItem Header="DSD passthrough"
                                      IsCheckable="True"
                                      IsChecked="{Binding IsDsdPassthrough, Mode=TwoWay}"
                                      IsEnabled="{Binding CanUseDsdPassthrough}">
                                <MenuItem.ToolTip>
                                    <TextBlock>
                                        Send DSD to the DAC untouched, wrapped as DSD-over-PCM,<LineBreak />
                                        instead of decoding it to PCM first.<LineBreak /><LineBreak />
                                        Needs bit-perfect output and a DoP-capable DAC. Falls back<LineBreak />
                                        to PCM conversion for any file the device can't clock.
                                    </TextBlock>
                                </MenuItem.ToolTip>
                            </MenuItem>
        
                            <Separator />
        
                            <MenuItem Header="Libraries"
                                      Icon="{ui:SymbolIcon Folder24}">
                                <MenuItem.ItemContainerStyle>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Header" Value="{Binding FolderPath}" />
                                        <Setter Property="IsCheckable" Value="True" />
                                        <Setter Property="IsChecked" Value="{Binding IsEnabled, Mode=TwoWay}" />
                                    </Style>
                                </MenuItem.ItemContainerStyle>
                                <MenuItem.ItemsSource>
                                    <CompositeCollection>
                                        <CollectionContainer Collection="{Binding Source={StaticResource FolderFiltersSource}}" />
                                        <Separator />
                                        <!--
                                            These two set their own Style: an item that is its own
                                            container is otherwise given the folder rows'
                                            ItemContainerStyle above, which made Add folder a
                                            checkable item bound to nothing.
                                        -->
                                        <MenuItem Header="Add folder…"
                                                  Style="{DynamicResource {x:Type MenuItem}}"
                                                  Icon="{ui:SymbolIcon FolderAdd24}"
                                                  Command="{Binding Source={StaticResource Proxy}, Path=Data.AddFolderCommand}" />
                                        <MenuItem Header="Remove folder"
                                                  Style="{DynamicResource {x:Type MenuItem}}"
                                                  Icon="{ui:SymbolIcon FolderProhibited24}"
                                                  ItemsSource="{Binding Source={StaticResource RemoveFoldersSource}}">
                                            <MenuItem.ItemContainerStyle>
                                                <Style TargetType="MenuItem">
                                                    <Setter Property="Header" Value="{Binding FolderPath}" />
                                                    <Setter Property="Command" Value="{Binding Source={StaticResource Proxy}, Path=Data.RemoveFolderCommand}" />
                                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                                    <Setter Property="ToolTip" Value="Stop watching this folder. Nothing on disk is deleted." />
                                                </Style>
                                            </MenuItem.ItemContainerStyle>
                                        </MenuItem>
                                    </CompositeCollection>
                                </MenuItem.ItemsSource>
                            </MenuItem>
        
                            <Separator />
        
                            <MenuItem Header="Statistics…"
                                      Icon="{ui:SymbolIcon DataBarVertical24}"
                                      Command="{Binding ShowStatisticsCommand}" />

                            <MenuItem Header="Last.fm…"
                                      Icon="{ui:SymbolIcon Live24}"
                                      Command="{Binding ShowLastFmCommand}" />
                        </MenuItem>
                    </Menu>

                    <!-- The existing logo asset (spec 10), fitted to the slot. -->
                    <Image x:Name="BrandMark"
                           Source="/Resources/logo.png"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Focusable="False" IsHitTestVisible="False" />
                </Grid>

                <!-- Width is set by AlignTitleBar (rule 2). -->
                <ui:TextBox x:Name="SearchBox"
                            Style="{DynamicResource theme.searchBox}"
                            Margin="{theme:Thickness Left=titleBar.logoToSearchGap}"
                            VerticalAlignment="Center"
                            Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Search"
                            ClearButtonEnabled="True"
                            AutomationProperties.Name="Search"
                            ToolTip="Search artists, albums and songs">
                    <!-- Escape clears the search: the keyboard's way to the clear ×,
                         which is not a Tab stop. -->
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <!--
                    The Statistics filter, while one is on. Beside the search box
                    because the two combine - search runs inside the filter - and
                    after it, so the box keeps its right edge level with Albums.
                    Clicking anywhere on the chip clears it. The spec has no filter
                    chip; it borrows the status-bar chip's colours and corners, and
                    its hover: control.faceHover, held while pressed, with the
                    border and text unchanged (theme.chip).
                -->
                <ui:Button x:Name="LibraryFilterChip"
                           Margin="{theme:Thickness Left=statusBar.chipGap}"
                           Height="{theme:Token titleBar.search.height}"
                           VerticalAlignment="Center"
                           Background="{DynamicResource color.status.chipBg}"
                           MouseOverBackground="{DynamicResource color.control.faceHover}"
                           PressedBackground="{DynamicResource color.control.faceHover}"
                           BorderBrush="{DynamicResource color.status.chipBorder}"
                           MouseOverBorderBrush="{DynamicResource color.status.chipBorder}"
                           PressedBorderBrush="{DynamicResource color.status.chipBorder}"
                           PressedForeground="{DynamicResource color.text.primary}"
                           BorderThickness="{theme:Thickness All=layout.panelBorder}"
                           CornerRadius="{DynamicResource radius.chip}"
                           FocusVisualStyle="{DynamicResource theme.focusRing.chip}"
                           Foreground="{DynamicResource color.text.primary}"
                           FontFamily="{DynamicResource font.family}"
                           FontSize="{theme:Token type.search.size}"
                           Icon="{ui:SymbolIcon Filter16}"
                           Command="{Binding ClearLibraryFilterCommand}"
                           Visibility="{Binding IsFiltered, Converter={StaticResource BoolToVisibility}}"
                           AutomationProperties.Name="{Binding LibraryFilter.Description, StringFormat=Clear filter: {0}}"
                           ToolTip="Showing only these tracks. Click to show the whole library again.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding LibraryFilter.Description}" VerticalAlignment="Center" />
                        <ui:SymbolIcon Symbol="Dismiss12"
                                       Margin="{theme:Thickness Left=titleBar.search.iconGap}"
                                       VerticalAlignment="Center"
                                       FontSize="{theme:Token type.search.size}" />
                    </StackPanel>
                </ui:Button>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- ============================================ artist | album | tracks -->
        <!--
            6.2: three panels with 6 px between them, 12 px in from the window
            sides and 6 px above the playback bar. Artists and Albums start at
            their spec widths and can still be dragged wider or narrower in the
            gaps. Songs takes the rest, down to a minimum that fits the song
            table's columns (ApplyMinimumWidth), so nothing scrolls sideways.
        -->
        <Grid Grid.Row="1"
              Margin="{theme:Thickness X=layout.windowMarginX, Top=0, Bottom=layout.panelsBottomMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{theme:Token layout.artistsPanelOuterWidth}" MinWidth="{theme:Token layout.artistsPanelMinWidth}" />
                <ColumnDefinition Width="{theme:Token layout.panelGap}" />
                <ColumnDefinition Width="{theme:Token layout.albumsPanelOuterWidth}" MinWidth="{theme:Token layout.albumsPanelMinWidth}" />
                <ColumnDefinition Width="{theme:Token layout.panelGap}" />
                <ColumnDefinition x:Name="SongsColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- artists -->
            <HeaderedContentControl x:Name="ArtistsPanel" Grid.Column="0" Style="{DynamicResource theme.panel}">
                <HeaderedContentControl.Header>
                    <!--
                        The header is the sort toggle: A-Z, or most recently added
                        first. Two fixed labels rather than one bound one, because
                        LetterSpacing spaces its text once and does not follow changes.
                        A bare template (Style x:Null) so it reads as the plain label
                        it always was, in the same place; hover and keyboard focus
                        underline it rather than adding a ring that would move it.

                        The plain ARTISTS label is hidden rather than collapsed while
                        the other one shows: it is what the logo centres over, so it
                        keeps its place either way. The underline is a rule under the
                        labels, since a text decoration would skip the letter gaps.
                    -->
                    <Button x:Name="ArtistSortHeader"
                            Style="{x:Null}"
                            Command="{Binding ToggleArtistSortCommand}"
                            ToolTip="{Binding ArtistSortTooltip}"
                            AutomationProperties.Name="Sort artists"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid>
                            <TextBlock x:Name="ArtistsHeaderLabel" Text="ARTISTS">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PanelHeaderLabel}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ArtistsByRecent}" Value="True">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="ARTISTS · RECENT" Style="{StaticResource PanelHeaderLabel}"
                                       Visibility="{Binding ArtistsByRecent, Converter={StaticResource BoolToVisibility}}" />
                            <Border VerticalAlignment="Bottom"
                                    Height="{theme:Token layout.panelBorder}"
                                    Background="{DynamicResource color.text.muted}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Hidden" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=ArtistSortHeader}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=ArtistSortHeader}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>
                    </Button>
                </HeaderedContentControl.Header>
                <!-- 6.3: 42 px rows, name over album count. Scrollbars hidden;
                     the wheel, trackpad and keyboard still scroll. The 6 px list
                     padding is a margin: WPF-UI's ListBox template ignores Padding.
                     No focus outline on the list itself: inset by that margin, it
                     drew a dark box inside the panel after any key press. -->

                <ListBox x:Name="ArtistList"
                         ItemsSource="{Binding Artists}"
                         SelectedItem="{Binding SelectedArtist, Mode=TwoWay}"
                         SelectionChanged="BrowserList_SelectionChanged"
                         MouseDoubleClick="ArtistList_MouseDoubleClick"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         Margin="{theme:Token layout.listPadding}"
                         FocusVisualStyle="{x:Null}"
                         ItemContainerStyle="{StaticResource ArtistRow}"
                         AutomationProperties.Name="Artists"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type core:ArtistGroup}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           Style="{DynamicResource type.artistName}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding AlbumSummary}"
                                           Style="{StaticResource ArtistCountText}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </HeaderedContentControl>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"
                          IsTabStop="False" />

            <!-- albums, oldest first -->
            <HeaderedContentControl x:Name="AlbumsPanel" Grid.Column="2" Style="{DynamicResource theme.panel}">
                <HeaderedContentControl.Header>
                    <TextBlock Text="ALBUMS" Style="{StaticResource PanelHeaderLabel}" />
                </HeaderedContentControl.Header>
                <ListBox x:Name="AlbumList"
                         ItemsSource="{Binding Albums}"
                         SelectedItem="{Binding SelectedAlbum, Mode=TwoWay}"
                         SelectionChanged="BrowserList_SelectionChanged"
                         MouseDoubleClick="AlbumList_MouseDoubleClick"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         Margin="{theme:Token layout.listPadding}"
                         FocusVisualStyle="{x:Null}"
                         ItemContainerStyle="{StaticResource AlbumRow}"
                         AutomationProperties.Name="Albums"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AlbumItemViewModel}">
                            <!--
                                6.4: a 56 px thumbnail, then the title wrapped to two
                                lines at most and the year and track count. The full
                                title shows on hover only when the clamp cut it off:
                                AlbumRow_ToolTipOpening cancels the tooltip otherwise.
                            -->
                            <Grid ToolTip="{Binding Title}"
                                  ToolTipService.InitialShowDelay="1000"
                                  Tag="{Binding ElementName=AlbumTitleText}"
                                  ToolTipOpening="AlbumRow_ToolTipOpening">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource AlbumThumb}">
                                    <Grid>
                                        <!-- No art: the spec has no placeholder, so the old
                                             note stays, at its old size, in the neutral-icon grey. -->
                                        <ui:SymbolIcon Symbol="MusicNote224"
                                                       FontSize="{theme:Token albums.placeholderIconSize}"
                                                       Foreground="{DynamicResource color.text.muted}"
                                                       Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisible}}" />
                                        <Image Source="{Binding Thumbnail}"
                                               Stretch="UniformToFill"
                                               Visibility="{Binding Thumbnail, Converter={StaticResource NullToCollapsed}}" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Margin="{theme:Thickness Left=albums.thumbGap}"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="AlbumTitleText"
                                               Text="{Binding Title}"
                                               Style="{DynamicResource type.albumTitle}" />
                                    <TextBlock Style="{StaticResource AlbumMetaText}">
                                        <Run Text="{Binding YearDisplay, Mode=OneWay}" />
                                        <Run Text="·" />
                                        <Run Text="{Binding TrackSummary, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </HeaderedContentControl>

            <GridSplitter Grid.Column="3"
                          HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"
                          IsTabStop="False" />

            <!--
                Album header + tracks. The shell is the shared panel (6.2), whose
                header strip draws the divider under the album header (6.5). The
                song table's parts are theme.song* in Theming/Chrome.xaml (6.6).
            -->
            <HeaderedContentControl Grid.Column="4" Style="{DynamicResource theme.panel.songs}">
                <!-- 6.5: big album art, then the title and four stacked facts -->
                <HeaderedContentControl.Header>
                    <Grid Margin="{theme:Thickness X=albumHeader.paddingX, Y=albumHeader.paddingY}"
                          Visibility="{Binding SelectedAlbum, Converter={StaticResource NullToCollapsed}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="{theme:Token albumHeader.artSize}"
                                Height="{theme:Token albumHeader.artSize}"
                                VerticalAlignment="Top"
                                BorderBrush="{DynamicResource color.art.border}"
                                BorderThickness="{theme:Thickness All=layout.panelBorder}"
                                CornerRadius="{DynamicResource radius.art}"
                                Effect="{DynamicResource shadow.headerArt}"
                                SnapsToDevicePixels="True"
                                Cursor="Hand"
                                MouseLeftButtonDown="AlbumArt_MouseLeftButtonDown">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Edit Album Tags…"
                                              Command="{Binding Source={StaticResource Proxy}, Path=Data.EditAlbumTagsCommand}"
                                              CommandParameter="{Binding Source={StaticResource Proxy}, Path=Data.SelectedAlbum}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <!-- Panel grey under the art, so an album with no cover
                                 shows the placeholder note on the panel colour. -->
                            <Grid Background="{DynamicResource color.panel.bg}">
                                <ui:SymbolIcon Symbol="MusicNote224"
                                               FontSize="{theme:Token albumHeader.placeholderIconSize}"
                                               Foreground="{DynamicResource color.text.muted}"
                                               Visibility="{Binding SelectedAlbumArt, Converter={StaticResource NullToVisible}}" />
                                <Image Source="{Binding SelectedAlbumArt}" Stretch="UniformToFill"
                                       Visibility="{Binding SelectedAlbumArt, Converter={StaticResource NullToCollapsed}}" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="{theme:Thickness Left=albumHeader.artGap}"
                                    VerticalAlignment="Top">
                            <!-- Two lines at most, then an ellipsis (the user's call).
                                 At least the mockup's 39 px box, which is taller than
                                 one 34.5 px line: that is where the details sit. -->
                            <TextBlock Text="{Binding AlbumHeaderTitle}"
                                       Style="{DynamicResource type.headerTitle}"
                                       MinHeight="{theme:Token albumHeader.titleMinHeight}" />
                            <StackPanel Margin="{theme:Thickness Top=albumHeader.titleToDetailsGap}">
                                <TextBlock Text="{Binding AlbumHeaderArtist}"
                                           Style="{DynamicResource type.headerArtist}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding AlbumHeaderYear}"
                                           Style="{DynamicResource type.headerDetails}"
                                           Margin="{theme:Thickness Top=albumHeader.detailsLineGap}" />
                                <TextBlock Text="{Binding AlbumHeaderTrackCount}"
                                           Style="{DynamicResource type.headerDetails}"
                                           Margin="{theme:Thickness Top=albumHeader.detailsLineGap}" />
                                <TextBlock Text="{Binding AlbumHeaderDuration}"
                                           Style="{DynamicResource type.headerDetails}"
                                           Margin="{theme:Thickness Top=albumHeader.detailsLineGap}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </HeaderedContentControl.Header>

                <Grid>
                    <!--
                        The ten columns, in track order. Widths, alignments and the
                        text style of each come from songTable.columns, set by
                        ApplySongTableLayout. Columns can still be resized and
                        dragged into another order; they start from the spec.

                        DisplayIndex is pinned on every column on purpose. Left
                        to itself, DataGrid's width-distribution pass shuffles a
                        star-width column ("Song") to the end of the row, which
                        put Song fourth instead of second.
                    -->
                    <DataGrid x:Name="TrackGrid"
                              Style="{DynamicResource theme.songTable}"
                              ItemsSource="{Binding Tracks}"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              SelectionChanged="TrackGrid_SelectionChanged"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              AutomationProperties.Name="Tracks"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="False"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              PreviewMouseLeftButtonDown="TrackGrid_PreviewMouseLeftButtonDown"
                              MouseDoubleClick="TrackGrid_MouseDoubleClick"
                              PreviewKeyDown="TrackGrid_PreviewKeyDown"
                              PreviewGotKeyboardFocus="TrackGrid_PreviewGotKeyboardFocus"
                              BeginningEdit="TrackGrid_BeginningEdit"
                              CellEditEnding="TrackGrid_CellEditEnding"
                              KeyboardNavigation.TabNavigation="Once">
                        <DataGrid.RowStyle>
                            <!--
                                Deliberately not BasedOn="{StaticResource {x:Type DataGridRow}}":
                                that base style's own unconditional Background setter paints
                                every row solid white. The look is theme.songRowTemplate; this
                                style adds what can only live here: the now-playing flag the
                                row and its cells style from, a context menu and an event handler.
                            -->
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template" Value="{DynamicResource theme.songRowTemplate}" />
                                <!--
                                    One Tab stop for the whole table, as for the lists: Tab
                                    enters it and the next Tab leaves (the grid is Once).
                                    WPF makes each row's cells a Tab group of their own,
                                    which walked every cell of every row; Continue folds
                                    them into the grid's group. Set on the row's own panel
                                    because an implicit style can't reach into a template.
                                -->
                                <Setter Property="ItemsPanel">
                                    <Setter.Value>
                                        <ItemsPanelTemplate>
                                            <DataGridCellsPanel KeyboardNavigation.TabNavigation="Continue" />
                                        </ItemsPanelTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="local:TrackRow.IsNowPlaying">
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource IsCurrentTrack}">
                                            <Binding />
                                            <Binding Source="{StaticResource Proxy}" Path="Data.NowPlaying" />
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                                <!--
                                    A DataGridRow doesn't select itself on right-click the
                                    way a ListBoxItem does, so without this the context menu
                                    would act on whatever was last left-clicked instead of the
                                    row actually under the cursor.
                                -->
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="TrackGridRow_PreviewMouseRightButtonDown" />
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <MenuItem Header="Edit Tags…"
                                                      Command="{Binding Source={StaticResource Proxy}, Path=Data.EditTrackTagsCommand}"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <!-- The # cell also carries the now-playing triangle. -->
                            <local:InlineEditColumn x:Name="TrackNumberColumn" Header="#" DisplayIndex="0"
                                                Binding="{Binding TrackNumber, Converter={StaticResource Number}, Mode=OneWay}"
                                                SortMemberPath="TrackNumber"
                                                CellStyle="{DynamicResource theme.songNumberCell}"
                                                EditingElementStyle="{StaticResource theme.cellEditBox.number}" />

                            <local:InlineEditColumn x:Name="SongColumn" Header="SONG" DisplayIndex="1"
                                                Binding="{Binding DisplayTitle, Mode=OneWay}"
                                                EditingElementStyle="{StaticResource theme.cellEditBox.title}" />

                            <local:InlineEditColumn x:Name="ArtistColumn" Header="ARTIST" DisplayIndex="2"
                                                Binding="{Binding Artist, Mode=OneWay}"
                                                EditingElementStyle="{StaticResource theme.cellEditBox}" />

                            <local:InlineEditColumn x:Name="AlbumColumn" Header="ALBUM" DisplayIndex="3"
                                                Binding="{Binding Album, Mode=OneWay}"
                                                EditingElementStyle="{StaticResource theme.cellEditBox}" />

                            <DataGridTextColumn x:Name="TimeColumn" IsReadOnly="True" Header="TIME" DisplayIndex="4"
                                                Binding="{Binding Duration, Converter={StaticResource Duration}}"
                                                SortMemberPath="Duration" />

                            <DataGridTextColumn x:Name="DiscColumn" IsReadOnly="True" Header="DISC" DisplayIndex="5"
                                                Binding="{Binding DiscNumber, Converter={StaticResource Number}}"
                                                SortMemberPath="DiscNumber" />

                            <DataGridTextColumn x:Name="KindColumn" IsReadOnly="True" Header="KIND" DisplayIndex="6"
                                                Binding="{Binding Kind}" />

                            <DataGridTextColumn x:Name="BitrateColumn" IsReadOnly="True" Header="BITRATE" DisplayIndex="7"
                                                Binding="{Binding Bitrate, Converter={StaticResource Bitrate}}"
                                                SortMemberPath="Bitrate" />

                            <DataGridTextColumn x:Name="BitDepthColumn" IsReadOnly="True" Header="BIT DEPTH" DisplayIndex="8"
                                                Binding="{Binding BitDepth, Converter={StaticResource BitDepth}}"
                                                SortMemberPath="BitDepth" />

                            <DataGridTextColumn x:Name="SampleRateColumn" IsReadOnly="True" Header="SAMPLE RATE" DisplayIndex="9"
                                                Binding="{Binding SampleRate, Converter={StaticResource SampleRate}}"
                                                SortMemberPath="SampleRate" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Nothing chosen yet; the wording says why. -->
                    <Control Template="{StaticResource theme.emptyState}"
                             Focusable="False" IsTabStop="False" IsHitTestVisible="False"
                             Visibility="{Binding SelectedAlbum, Converter={StaticResource NullToVisible}}" />
                </Grid>
            </HeaderedContentControl>
        </Grid>

        <!--
            ============================================ playback bar (6.7)
            The panel shell, without a header. Four zones 40 px apart. The first
            is sized by MainWindow.AlignPlaybackBar so the Shuffle button starts
            where the song list does (spec 2, rule 3).
        -->
        <HeaderedContentControl x:Name="PlaybackBar"
                                Grid.Row="2"
                                Template="{StaticResource theme.panelTemplate}"
                                Focusable="False"
                                Height="{theme:Token layout.playbackBarHeight}"
                                Margin="{theme:Thickness X=layout.windowMarginX, Bottom=layout.playbackBarBottomMargin}">
            <Grid x:Name="PlaybackZones" Margin="{theme:Thickness X=playbackBar.paddingX}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="NowPlayingZone" Width="{theme:Token playbackBar.nowPlayingZoneWidth}" />
                    <ColumnDefinition Width="{theme:Token playbackBar.zoneGap}" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{theme:Token playbackBar.zoneGap}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{theme:Token playbackBar.zoneGap}" />
                    <ColumnDefinition Width="{theme:Token playbackBar.volumeZoneWidth}" />
                </Grid.ColumnDefinitions>

                <!-- Zone 1: now playing. 88 px art, then three lines 3 px apart. -->
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="{theme:Token playbackBar.artGap}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="{theme:Token playbackBar.artSize}"
                            Height="{theme:Token playbackBar.artSize}"
                            Background="{DynamicResource color.panel.bg}"
                            BorderBrush="{DynamicResource color.art.border}"
                            BorderThickness="{theme:Token layout.panelBorder}"
                            Effect="{DynamicResource shadow.nowPlayingArt}"
                            Cursor="Hand"
                            MouseLeftButtonDown="NowPlayingArt_MouseLeftButtonDown">
                        <Grid>
                            <!-- No-art placeholder: not in the spec, so the old icon
                                 size stays, in the neutral-icon grey, as for the album list's. -->
                            <ui:SymbolIcon Symbol="MusicNote224"
                                           FontSize="{theme:Token playbackBar.placeholderIconSize}"
                                           Foreground="{DynamicResource color.text.muted}"
                                           Visibility="{Binding NowPlayingArt, Converter={StaticResource NullToVisible}}" />
                            <Image Source="{Binding NowPlayingArt}" Stretch="UniformToFill"
                                   Visibility="{Binding NowPlayingArt, Converter={StaticResource NullToCollapsed}}" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                Cursor="Hand"
                                MouseLeftButtonDown="NowPlayingInfo_MouseLeftButtonDown">
                        <TextBlock x:Name="NowPlayingTitle"
                                   Text="{Binding NowPlaying.DisplayTitle, FallbackValue='', TargetNullValue=''}"
                                   Style="{DynamicResource type.nowPlayingTitle}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="NowPlayingArtist"
                                   Text="{Binding NowPlaying.Artist, FallbackValue='', TargetNullValue=''}"
                                   Style="{DynamicResource type.nowPlayingArtist}"
                                   Margin="{theme:Thickness Top=playbackBar.textLineGap}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="NowPlayingFormat"
                                   Text="{Binding NowPlayingFormat}"
                                   Style="{DynamicResource type.nowPlayingFormat}"
                                   Margin="{theme:Thickness Top=playbackBar.textLineGap}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding NowPlaying, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </Grid>

                <!-- Zone 2: Shuffle, Previous, Play/Pause, Next, Repeat, 16 px apart. -->
                <StackPanel x:Name="TransportButtons" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="ShuffleButton"
                                  Command="{Binding ToggleShuffleCommand}"
                                  IsChecked="{Binding IsShuffle, Mode=OneWay}"
                                  AutomationProperties.Name="Shuffle"
                                  ToolTip="{Binding ShuffleTooltip}">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource theme.transportButton}">
                                <Setter Property="Foreground" Value="{DynamicResource color.control.iconOff}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsShuffle}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource color.control.shuffleOn}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                        <Viewbox Width="{theme:Token playbackBar.icons.shuffle}" Height="{theme:Token playbackBar.icons.shuffle}">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource theme.iconStroke}"
                                      Data="M 16,3 H 21 V 8 M 4,20 L 21,3 M 21,16 V 21 H 16 M 15,15 L 21,21 M 4,4 L 9,9" />
                            </Canvas>
                        </Viewbox>
                    </ToggleButton>

                    <Button x:Name="PreviousButton"
                            Style="{StaticResource theme.transportButton}"
                            Margin="{theme:Thickness Left=playbackBar.buttonGap}"
                            Command="{Binding PreviousCommand}"
                            AutomationProperties.Name="Previous track">
                        <Viewbox Width="{theme:Token playbackBar.icons.previous}" Height="{theme:Token playbackBar.icons.previous}">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource theme.iconStroke}" Data="M 6,5 V 19" />
                                <Path Style="{StaticResource theme.iconFill}" Data="M 18,5.5 L 8.5,12 L 18,18.5 Z" />
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <!-- Always teal (6.7): a triangle while paused, two bars while playing. -->
                    <Button x:Name="PlayPauseButton"
                            Style="{StaticResource theme.playButton}"
                            Margin="{theme:Thickness Left=playbackBar.buttonGap}"
                            Command="{Binding TogglePlayCommand}"
                            AutomationProperties.Name="Play/Pause">
                        <Viewbox Width="{theme:Token playbackBar.icons.playPause}" Height="{theme:Token playbackBar.icons.playPause}">
                            <Grid>
                                <!-- No layout rounding: at 26 px it rounded the two bars
                                     to 4 and 5 px wide. Unrounded, they're mirror images. -->
                                <Canvas Width="24" Height="24" UseLayoutRounding="False"
                                        Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}">
                                    <Rectangle Style="{StaticResource theme.iconSolid}" Canvas.Left="6.5" Canvas.Top="5" Width="4" Height="14" RadiusX="1.2" RadiusY="1.2" />
                                    <Rectangle Style="{StaticResource theme.iconSolid}" Canvas.Left="13.5" Canvas.Top="5" Width="4" Height="14" RadiusX="1.2" RadiusY="1.2" />
                                </Canvas>
                                <Canvas Width="24" Height="24"
                                        Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
                                    <Path Style="{StaticResource theme.iconSolid}"
                                          Data="M 8.5,5.2 V 18.8 A 0.8,0.8 0 0 0 9.7,19.5 L 19.9,12.7 A 0.8,0.8 0 0 0 19.9,11.3 L 9.7,4.5 A 0.8,0.8 0 0 0 8.5,5.2 Z" />
                                </Canvas>
                            </Grid>
                        </Viewbox>
                    </Button>

                    <Button x:Name="NextButton"
                            Style="{StaticResource theme.transportButton}"
                            Margin="{theme:Thickness Left=playbackBar.buttonGap}"
                            Command="{Binding NextCommand}"
                            AutomationProperties.Name="Next track">
                        <Viewbox Width="{theme:Token playbackBar.icons.next}" Height="{theme:Token playbackBar.icons.next}">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource theme.iconStroke}" Data="M 18,5 V 19" />
                                <Path Style="{StaticResource theme.iconFill}" Data="M 6,5.5 L 15.5,12 L 6,18.5 Z" />
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <!-- Off, all, one. Repeat-one adds a "1" in the middle of the icon. -->
                    <Button x:Name="RepeatButton"
                            Margin="{theme:Thickness Left=playbackBar.buttonGap}"
                            Command="{Binding CycleRepeatCommand}"
                            ToolTip="{Binding RepeatTooltip}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource theme.transportButton}">
                                <Setter Property="Foreground" Value="{DynamicResource color.control.iconOff}" />
                                <Setter Property="AutomationProperties.Name" Value="Repeat: off" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRepeatAll}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource color.control.repeatOn}" />
                                        <Setter Property="AutomationProperties.Name" Value="Repeat: all" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsRepeatOne}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource color.control.repeatOn}" />
                                        <Setter Property="AutomationProperties.Name" Value="Repeat: one" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Viewbox Width="{theme:Token playbackBar.icons.repeat}" Height="{theme:Token playbackBar.icons.repeat}">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource theme.iconStroke}"
                                          Data="M 4.5,12 A 7.5,7.5 0 0 1 17.3,6.7 L 19.5,9 M 19.5,4.5 V 9 H 15 M 19.5,12 A 7.5,7.5 0 0 1 6.7,17.3 L 4.5,15 M 4.5,19.5 V 15 H 9" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="RepeatOneBadge"
                                       Text="1"
                                       FontFamily="{DynamicResource font.family}"
                                       FontSize="{theme:Token playbackBar.repeatOneBadge.size}"
                                       FontWeight="{DynamicResource playbackBar.repeatOneBadge.weight.fontWeight}"
                                       Foreground="{DynamicResource color.control.repeatOn}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding IsRepeatOne, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Zone 3: elapsed, track, total. The labels are at least 36 px,
                     and grow rather than clip for a track over an hour. -->
                <Grid Grid.Column="4" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="PositionText" Grid.Column="0" Text="{Binding PositionDisplay}"
                               Style="{DynamicResource type.timeLabel}"
                               MinWidth="{theme:Token playbackBar.timeLabelWidth}"
                               TextAlignment="Right"
                               VerticalAlignment="Center" />

                    <Slider x:Name="SeekBar" Grid.Column="1"
                            Style="{StaticResource theme.slider}"
                            Margin="{theme:Thickness X=playbackBar.seekGap}"
                            Minimum="0"
                            Maximum="{Binding DurationSeconds}"
                            Value="{Binding PositionSeconds, Mode=TwoWay}"
                            SmallChange="5" LargeChange="30"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Playback position"
                            Thumb.DragStarted="SeekBar_DragStarted"
                            Thumb.DragCompleted="SeekBar_DragCompleted"
                            PreviewMouseLeftButtonUp="SeekBar_PreviewMouseLeftButtonUp" />

                    <TextBlock x:Name="DurationText" Grid.Column="2" Text="{Binding DurationDisplay}"
                               Style="{DynamicResource type.timeLabel}"
                               MinWidth="{theme:Token playbackBar.timeLabelWidth}"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Zone 4: speaker, 8 px, volume track on the seekbar's line. -->
                <Grid Grid.Column="6" VerticalAlignment="Center">
                    <!--
                        Volume goes dead in exclusive mode, where the gain has to stay at
                        unity, and the whole group dims, mute included.
                    -->
                    <Grid x:Name="VolumeGroup" ToolTip="{Binding VolumeTooltip}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVolumeEnabled}" Value="False">
                                        <Setter Property="Opacity" Value="{theme:Token layout.disabledOpacity}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="{theme:Token playbackBar.volumeGap}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Mute: an "x" for the waves while muted; the slider shows
                             zero, and unmuting restores the level. -->
                        <ToggleButton x:Name="MuteButton" Grid.Column="0"
                                      Style="{StaticResource theme.bareIconButton}"
                                      Command="{Binding ToggleMuteCommand}"
                                      IsChecked="{Binding IsMuted, Mode=OneWay}"
                                      IsEnabled="{Binding IsVolumeEnabled}"
                                      AutomationProperties.Name="{Binding MuteLabel}">
                            <Viewbox Width="{theme:Token playbackBar.icons.volume}" Height="{theme:Token playbackBar.icons.volume}">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource theme.iconFill}"
                                          StrokeThickness="{theme:Token playbackBar.volumeIconStrokeOn24Grid}"
                                          Data="M 11,5 L 6.5,9 H 3.5 V 15 H 6.5 L 11,19 Z" />
                                    <Path Style="{StaticResource theme.iconStroke}"
                                          StrokeThickness="{theme:Token playbackBar.volumeIconStrokeOn24Grid}"
                                          Visibility="{Binding IsMuted, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"
                                          Data="M 15.5,8.5 A 5,5 0 0 1 15.5,15.5 M 18.5,5.5 A 9,9 0 0 1 18.5,18.5" />
                                    <Path Style="{StaticResource theme.iconStroke}"
                                          StrokeThickness="{theme:Token playbackBar.volumeIconStrokeOn24Grid}"
                                          Visibility="{Binding IsMuted, Converter={StaticResource BoolToVisibility}}"
                                          Data="M 16,9.5 L 21,14.5 M 21,9.5 L 16,14.5" />
                                </Canvas>
                            </Viewbox>
                        </ToggleButton>

                        <Slider x:Name="VolumeSlider" Grid.Column="2"
                                Style="{StaticResource theme.slider}"
                                Tag="{theme:Token playbackBar.volumeThumb}"
                                Foreground="{DynamicResource color.slider.volumeFill}"
                                Minimum="0" Maximum="1"
                                SmallChange="0.05" LargeChange="0.1"
                                Value="{Binding Volume, Mode=TwoWay}"
                                IsEnabled="{Binding IsVolumeEnabled}"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Volume" />
                    </Grid>

                    <!--
                        The output readout, right-aligned just under the volume row. It
                        sits in a zero-height Canvas so it takes no layout space: the
                        slider stays level with the seek bar, and a long readout runs
                        left rather than widening the zone. Outside the dimmed group,
                        because exclusive mode is exactly when it matters.
                    -->
                    <Canvas Height="0" VerticalAlignment="Bottom"
                            Visibility="{Binding IsOutputActive, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock x:Name="OutputReadout"
                                   Canvas.Right="0" Canvas.Top="0"
                                   Text="{Binding OutputDescription}"
                                   Style="{DynamicResource type.outputReadout}"
                                   ToolTip="{Binding OutputDeviceName}" />
                    </Canvas>
                </Grid>
            </Grid>
        </HeaderedContentControl>

        <!-- ============================================ status bar (6.8) -->
        <Grid x:Name="StatusBar" Grid.Row="3"
              Height="{theme:Token layout.statusBarHeight}"
              Margin="{theme:Thickness X=layout.statusBarPaddingX}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Refresh, then the library dot and totals. -->
            <Grid Grid.Column="0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="RefreshButton" Grid.Column="0"
                        Style="{StaticResource theme.chip}"
                        Width="{theme:Token statusBar.refreshButton}"
                        Height="{theme:Token statusBar.refreshButton}"
                        Padding="0"
                        Margin="{theme:Thickness Right=statusBar.refreshAfterGap}"
                        Command="{Binding ScanCommand}"
                        IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}"
                        AutomationProperties.Name="Refresh library"
                        ToolTip="Refresh library">
                    <Viewbox Width="{theme:Token statusBar.refreshIcon}" Height="{theme:Token statusBar.refreshIcon}">
                        <Canvas Width="24" Height="24">
                            <Path Style="{StaticResource theme.iconStroke}"
                                  StrokeThickness="{theme:Token statusBar.refreshIconStrokeOn24Grid}"
                                  Data="M 20,12 A 8,8 0 1 1 17.66,6.34 M 20,4 V 9 H 15" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <Ellipse x:Name="LibraryDot" Grid.Column="1"
                         Style="{StaticResource theme.statusDot}"
                         Fill="{DynamicResource color.status.libraryDot}"
                         Margin="{theme:Thickness Left=statusBar.dotTextGap}" />

                <TextBlock x:Name="StatusLine" Grid.Column="2"
                           Text="{Binding StatusText}"
                           Style="{DynamicResource type.status}"
                           Margin="{theme:Thickness Left=statusBar.dotTextGap}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </Grid>

            <ProgressBar Grid.Column="1"
                         Style="{StaticResource theme.scanProgress}"
                         Margin="{theme:Thickness Left=statusBar.chipGap}"
                         Minimum="0" Maximum="1"
                         Value="{Binding ScanFraction}"
                         VerticalAlignment="Center"
                         AutomationProperties.Name="Scan progress"
                         Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />

            <!--
                Last.fm, only while there is no working session (the user's call):
                not connected, or needing reconnect. Hidden while connected. The
                dot is the "off" yellow; the label says which state, so colour is
                never the only signal. Clicking opens the Last.fm window.
            -->
            <Button x:Name="LastFmIndicator" Grid.Column="2"
                    Style="{StaticResource theme.chip}"
                    Margin="{theme:Thickness Left=statusBar.chipGap}"
                    Command="{Binding ShowLastFmCommand}"
                    ToolTip="{Binding LastFmToolTip}"
                    AutomationProperties.Name="{Binding LastFmLabel}"
                    AutomationProperties.HelpText="{Binding LastFmToolTip}"
                    Visibility="{Binding IsLastFmShown, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource theme.statusDot}"
                             Fill="{DynamicResource color.status.lastFmOff}"
                             Margin="{theme:Thickness Right=statusBar.chipDotGap}" />
                    <TextBlock Text="{Binding LastFmLabel}"
                               Style="{DynamicResource type.status}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Bit-Perfect: the dot alone shows the state (no On/Off text);
                 as a toggle button, screen readers still announce it. -->
            <ToggleButton x:Name="BitPerfectToggle" Grid.Column="3"
                          Style="{StaticResource theme.chip}"
                          Margin="{theme:Thickness Left=statusBar.chipGap}"
                          IsChecked="{Binding IsExclusiveOutput, Mode=TwoWay}"
                          IsEnabled="{Binding CanUseExclusiveOutput}"
                          AutomationProperties.Name="Bit-Perfect">
                <ToggleButton.ToolTip>
                    <TextBlock>
                        Exclusive WASAPI: opens the sound device at each track's own<LineBreak />
                        sample rate, so nothing is resampled on the way out.<LineBreak /><LineBreak />
                        Other applications go silent while music is playing, and the<LineBreak />
                        volume slider is fixed at 100%.
                    </TextBlock>
                </ToggleButton.ToolTip>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="BitPerfectDot"
                             Margin="{theme:Thickness Right=statusBar.chipDotGap}"
                             Stroke="{DynamicResource color.status.dotRing}"
                             StrokeThickness="{theme:Token layout.panelBorder}">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse" BasedOn="{StaticResource theme.statusDot}">
                                <Setter Property="Fill" Value="{DynamicResource color.status.bitPerfectOff}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExclusiveOutput}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource color.status.bitPerfectOn}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="Bit-Perfect"
                               Style="{DynamicResource type.status}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </ToggleButton>
        </Grid>
    </Grid>
</ui:FluentWindow>
