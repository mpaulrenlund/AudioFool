<ui:FluentWindow x:Class="AudioFool.StatisticsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Library Statistics"
                 Icon="/Resources/AudioFool.ico"
                 Width="900" SizeToContent="Height"
                 MinWidth="720" MinHeight="420"
                 WindowStartupLocation="Manual"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <!--
            A row you can click. A real Button, so it takes keyboard focus, answers
            Enter and Space, and exposes an Invoke pattern to UI Automation. Its
            template is written out in full rather than BasedOn WPF-UI's button,
            which would paint a filled control behind every row. The negative side
            margin lets the hover wash reach past the text while the text itself
            stays level with the pane header.

            A row with nothing to show - a tag no track is missing - is disabled,
            which removes the hover, the hand cursor and the focus stop together.
        -->
        <Style x:Key="StatRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="-6,0,-6,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Border x:Name="Wash" Opacity="0"
                                    Background="{DynamicResource AfSurfaceRowHover}"
                                    CornerRadius="{DynamicResource AfRadiusWell}" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                            <Border x:Name="FocusSpacer" Visibility="Collapsed" IsHitTestVisible="False"
                                    BorderBrush="{DynamicResource AfFocusRingSpacer}"
                                    BorderThickness="{DynamicResource AfFocusRingInset}"
                                    CornerRadius="{DynamicResource AfRadiusWell}" />
                            <Border x:Name="FocusRing" Visibility="Collapsed" IsHitTestVisible="False"
                                    Margin="1"
                                    BorderBrush="{DynamicResource AfFocusRing}"
                                    BorderThickness="{DynamicResource AfFocusRingInset}"
                                    CornerRadius="{DynamicResource AfRadiusWell}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Wash" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Wash" Property="Background"
                                        Value="{DynamicResource AfSurfaceRowSelected}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusSpacer" Property="Visibility" Value="Visible" />
                                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            One labelled bar: label and figure on the first line, the bar, then an
            optional quieter detail line. The bar colour comes from the owning
            ItemsControl's Tag, so each section picks its own brush without a
            template per section.
        -->
        <DataTemplate x:Key="BarRowTemplate">
            <Button Style="{StaticResource StatRowButton}"
                    Click="Row_Click"
                    IsEnabled="{Binding IsClickable}"
                    ToolTip="{Binding ToolTip}"
                    AutomationProperties.Name="{Binding Label}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                   FontSize="{DynamicResource AfFontSizeBody}"
                                   Foreground="{DynamicResource AfTextPrimary}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ValueText" Grid.Column="1" Text="{Binding Value}"
                                   Style="{DynamicResource AfMetaText}"
                                   FontFamily="{DynamicResource AfFontMono}"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <!-- The track is the divider stroke, not the well: PS1's panes are
                         already wells, and a well-coloured track vanishes into them. -->
                    <Border Height="6" Margin="0,4,0,0"
                            CornerRadius="{DynamicResource AfRadiusWell}"
                            Background="{DynamicResource AfStrokeDivider}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding Fill}" />
                                <ColumnDefinition Width="{Binding Rest}" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="{DynamicResource AfRadiusWell}"
                                    Background="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding Detail}" Style="{DynamicResource AfMetaTextQuiet}"
                               Margin="0,3,0,0"
                               Visibility="{Binding Detail, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsComplete}" Value="True">
                    <Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource AfStatusOkText}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <!-- The shell colour, for a theme that paints one; transparent (the backdrop) otherwise. -->
    <Grid Background="{DynamicResource AfSurfaceShell}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Library Statistics">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Resources/AudioFool.ico" Width="16" Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel Margin="20,4,20,8">

                <TextBlock Text="{Binding Scope}" Style="{DynamicResource AfMetaText}"
                           Foreground="{DynamicResource AfStatusCautionText}"
                           TextWrapping="Wrap" Margin="0,0,0,10"
                           Visibility="{Binding HasScope, Converter={StaticResource BoolToVisibility}}" />

                <!-- headline figures -->
                <ItemsControl x:Name="Tiles" ItemsSource="{Binding Tiles}" Focusable="False" Margin="0,0,-8,12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <HeaderedContentControl Style="{DynamicResource AfPane}" Margin="0,0,8,0">
                                <StackPanel Margin="14,12,14,12">
                                    <TextBlock Text="{Binding Value}"
                                               FontFamily="{DynamicResource AfFontMono}"
                                               FontSize="{DynamicResource AfFontSizeTitle}"
                                               FontWeight="{DynamicResource AfFontWeightSemiBold}"
                                               Foreground="{DynamicResource AfTextPrimary}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Label}" Style="{DynamicResource AfMetaTextQuiet}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </HeaderedContentControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <HeaderedContentControl Style="{DynamicResource AfPane}" Margin="0,0,0,12">
                            <HeaderedContentControl.Header>
                                <TextBlock Text="TOP ARTISTS BY TRACKS" Style="{DynamicResource AfPaneHeaderText}" />
                            </HeaderedContentControl.Header>
                            <ItemsControl x:Name="TopArtistList" ItemsSource="{Binding TopArtists}"
                                          ItemTemplate="{StaticResource BarRowTemplate}"
                                          Tag="{DynamicResource AccentFillColorDefaultBrush}"
                                          Focusable="False" Margin="12,6,12,2" />
                        </HeaderedContentControl>

                        <HeaderedContentControl Style="{DynamicResource AfPane}" Margin="0,0,0,12">
                            <HeaderedContentControl.Header>
                                <TextBlock Text="FILE TYPES" Style="{DynamicResource AfPaneHeaderText}" />
                            </HeaderedContentControl.Header>
                            <ItemsControl x:Name="FileTypeList" ItemsSource="{Binding FileTypes}"
                                          ItemTemplate="{StaticResource BarRowTemplate}"
                                          Tag="{DynamicResource AccentFillColorDefaultBrush}"
                                          Focusable="False" Margin="12,6,12,2" />
                        </HeaderedContentControl>

                        <HeaderedContentControl Style="{DynamicResource AfPane}" Margin="0,0,0,12">
                            <HeaderedContentControl.Header>
                                <TextBlock Text="AUDIO QUALITY" Style="{DynamicResource AfPaneHeaderText}" />
                            </HeaderedContentControl.Header>
                            <ItemsControl x:Name="QualityList" ItemsSource="{Binding Quality}"
                                          ItemTemplate="{StaticResource BarRowTemplate}"
                                          Tag="{DynamicResource AccentFillColorDefaultBrush}"
                                          Focusable="False" Margin="12,6,12,2" />
                        </HeaderedContentControl>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <HeaderedContentControl Style="{DynamicResource AfPane}" Margin="0,0,0,12">
                            <HeaderedContentControl.Header>
                                <TextBlock Text="MISSING TAGS" Style="{DynamicResource AfPaneHeaderText}" />
                            </HeaderedContentControl.Header>
                            <StackPanel Margin="12,6,12,2">
                                <TextBlock x:Name="TagSummary" Text="{Binding TagSummary}"
                                           Style="{DynamicResource AfMetaText}" TextWrapping="Wrap"
                                           Margin="0,0,0,10" />
                                <!-- Caution, not danger: a missing tag is a gap to fill, not a fault. -->
                                <ItemsControl x:Name="TagGapList" ItemsSource="{Binding TagGaps}"
                                              ItemTemplate="{StaticResource BarRowTemplate}"
                                              Tag="{DynamicResource AfStatBarCaution}"
                                              Focusable="False" />
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Style="{DynamicResource AfPane}" Margin="0,0,0,12">
                            <HeaderedContentControl.Header>
                                <TextBlock Text="TRACKS BY DECADE" Style="{DynamicResource AfPaneHeaderText}" />
                            </HeaderedContentControl.Header>
                            <ItemsControl x:Name="DecadeList" ItemsSource="{Binding Decades}"
                                          ItemTemplate="{StaticResource BarRowTemplate}"
                                          Tag="{DynamicResource AccentFillColorDefaultBrush}"
                                          Focusable="False" Margin="12,6,12,2" />
                        </HeaderedContentControl>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="20,4,20,16">
            <TextBlock Text="Click a row to show those tracks in the library, or an artist to go to them."
                       Style="{DynamicResource AfMetaTextQuiet}" VerticalAlignment="Center"
                       Margin="0,0,96,0" />
            <!-- Not IsDefault: Enter belongs to whichever row has focus. -->
            <ui:Button x:Name="CloseButton" HorizontalAlignment="Right" Content="Close" IsCancel="True"
                       Click="Close_Click" />
        </Grid>
    </Grid>
</ui:FluentWindow>
