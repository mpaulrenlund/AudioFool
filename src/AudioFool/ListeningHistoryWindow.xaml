<ui:FluentWindow x:Class="AudioFool.ListeningHistoryWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:theme="clr-namespace:AudioFool.Theming"
                 xmlns:fmt="clr-namespace:AudioFool.Formatting"
                 Title="{Binding Title}"
                 Icon="/Resources/AudioFool.ico"
                 Width="{theme:Token statistics.width}"
                 MinWidth="{theme:Token statistics.minWidth}" MinHeight="{theme:Token statistics.minHeight}"
                 WindowStartupLocation="Manual"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round">

    <!--
        Built as Statistics is (the user's call, 2026-11-02): the same tiles,
        panels, rows and bars, from the same tokens. The styles below are
        Statistics' own, restated; only the period switch is new.
    -->
    <ui:FluentWindow.Resources>
        <Style TargetType="Hyperlink" BasedOn="{StaticResource theme.link}" />

        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource type.panelHeader}">
            <Setter Property="fmt:LetterSpacing.Em" Value="{DynamicResource type.panelHeader.letterSpacingEm}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Body" TargetType="TextBlock" BasedOn="{StaticResource type.tableCell}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
        </Style>

        <!-- A section's line when it has no rows: shown only while its list (the Tag) is empty. -->
        <Style x:Key="EmptyLine" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Margin" Value="{theme:Thickness Bottom=statistics.sectionPaddingY}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag.HasItems, RelativeSource={RelativeSource Self}}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Statistics' clickable row: hover wash, then the selection grey; inert when nothing in the library matches. -->
        <Style x:Key="StatRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="{theme:Thickness X=statistics.rowPaddingX, Y=statistics.rowPaddingY}" />
            <Setter Property="Margin" Value="{theme:Thickness Left=-statistics.rowPaddingX, Right=-statistics.rowPaddingX, Bottom=statistics.rowGap}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Border x:Name="Wash" Opacity="0"
                                    Background="{DynamicResource color.state.hoverOverlay}"
                                    CornerRadius="{DynamicResource radius.row}" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Wash" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Wash" Property="Background"
                                        Value="{DynamicResource color.state.selectionBg}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Label and figure, the bar (top lists only), then the artist or album in grey. -->
        <DataTemplate x:Key="ListeningRowTemplate">
            <Button Style="{StaticResource StatRowButton}"
                    Click="Row_Click"
                    IsEnabled="{Binding IsClickable}"
                    AutomationProperties.Name="{Binding Label}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                   Style="{DynamicResource type.songTitle}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}"
                                   Style="{DynamicResource type.timeLabel}"
                                   VerticalAlignment="Center"
                                   Margin="{theme:Thickness Left=statistics.columnGap}" />
                    </Grid>

                    <Grid Height="{theme:Token playbackBar.trackHeight}"
                          Margin="{theme:Thickness Top=statistics.barGap}"
                          SnapsToDevicePixels="True"
                          Visibility="{Binding HasBar, Converter={StaticResource BoolToVisibility}}">
                        <Border Background="{DynamicResource color.slider.track}"
                                CornerRadius="{DynamicResource radius.sliderTrack}">
                            <Border Height="{theme:Token shadow.sliderTrackInset.inset1.depth}"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource shadow.sliderTrackInset.inset1.fade}"
                                    CornerRadius="{DynamicResource radius.sliderTrack}" />
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding Fill}" />
                                <ColumnDefinition Width="{Binding Rest}" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="{DynamicResource radius.sliderTrack}"
                                    Background="{DynamicResource color.slider.volumeFill}" />
                        </Grid>
                    </Grid>

                    <TextBlock Text="{Binding Detail}" Style="{DynamicResource type.albumMeta}"
                               TextTrimming="CharacterEllipsis"
                               Margin="{theme:Thickness Top=statistics.detailGap}"
                               Visibility="{Binding Detail, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <Style x:Key="SectionList" TargetType="ItemsControl">
            <Setter Property="ItemTemplate" Value="{StaticResource ListeningRowTemplate}" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <Style x:Key="Section" TargetType="HeaderedContentControl" BasedOn="{StaticResource theme.panel}">
            <Setter Property="Margin" Value="{theme:Thickness Bottom=statistics.sectionGap}" />
        </Style>

        <!--
            One word of the period switch (spec silent; approved 2026-11-02): the
            chosen one in the heading colour and the dialogs' emphasis weight, the
            rest muted, darker on hover. No face, no tooltip, no focus outline,
            as the rows. A hidden emphasised copy holds each word's width, so the
            row doesn't shift when the choice moves.
        -->
        <Style x:Key="PeriodButton" TargetType="RadioButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="{theme:Thickness Right=listeningHistory.periodGap}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <TextBlock Text="{Binding Label}" Style="{DynamicResource type.songTitle}"
                                       FontWeight="{DynamicResource dialog.emphasisWeight.fontWeight}"
                                       Visibility="Hidden" />
                            <TextBlock x:Name="Word" Text="{Binding Label}" Style="{DynamicResource type.songTitle}"
                                       Foreground="{DynamicResource color.text.muted}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Word" Property="Foreground" Value="{DynamicResource color.text.primary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Word" Property="Foreground" Value="{DynamicResource color.text.heading}" />
                                <Setter TargetName="Word" Property="FontWeight" Value="{DynamicResource dialog.emphasisWeight.fontWeight}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="{DynamicResource color.window.bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Style="{DynamicResource theme.dialogTitleBar}"
                     Header="{DynamicResource theme.dialogTitle}" />

        <!-- No visible scrollbar (the theme's rule); the wheel and keys still scroll. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel Margin="{theme:Thickness X=dialog.paddingX, Top=dialog.paddingTop}">

                <!-- Not connected: say so and lead to the Last.fm window. -->
                <TextBlock x:Name="NotConnectedText" Style="{StaticResource Body}"
                           Margin="{theme:Thickness Bottom=statistics.summaryGap}"
                           Visibility="{Binding IsNotConnected, Converter={StaticResource BoolToVisibility}}">
                    AudioFool isn't connected to Last.fm, so there is no listening history to show.
                    <Hyperlink Click="OpenLastFm_Click">Connect in the Last.fm window</Hyperlink>
                </TextBlock>

                <!-- Loading, or why it couldn't. No colour, like a dialog's error line. -->
                <TextBlock x:Name="MessageText" Text="{Binding Message}" Style="{StaticResource Body}"
                           Foreground="{DynamicResource color.text.heading}"
                           FontWeight="{DynamicResource dialog.emphasisWeight.fontWeight}"
                           Margin="{theme:Thickness Bottom=statistics.summaryGap}"
                           Visibility="{Binding ShowsMessage, Converter={StaticResource BoolToVisibility}}" />

                <StackPanel Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVisibility}}">
                    <!-- headline figures -->
                    <ItemsControl x:Name="Tiles" ItemsSource="{Binding Tiles}" Focusable="False"
                                  Margin="{theme:Thickness Right=-statistics.tileGap, Bottom=statistics.sectionGap}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <HeaderedContentControl Style="{DynamicResource theme.panel}"
                                                        Margin="{theme:Thickness Right=statistics.tileGap}">
                                    <StackPanel Margin="{theme:Thickness X=statistics.tilePaddingX, Y=statistics.tilePaddingY}">
                                        <TextBlock Text="{Binding Value}"
                                                   Style="{DynamicResource type.statValue}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Label}" Style="{DynamicResource type.albumMeta}"
                                                   Margin="{theme:Thickness Top=statistics.tileLineGap}" />
                                    </StackPanel>
                                </HeaderedContentControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- The period the three top lists cover. -->
                    <ItemsControl x:Name="PeriodSwitch" ItemsSource="{Binding Periods}" Focusable="False"
                                  Margin="{theme:Thickness Bottom=statistics.sectionGap}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource PeriodButton}" GroupName="ListeningPeriod"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                             AutomationProperties.Name="{Binding Label}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{theme:Token statistics.columnGap}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <HeaderedContentControl Style="{StaticResource Section}">
                                <HeaderedContentControl.Header>
                                    <TextBlock Text="TOP ARTISTS" Style="{StaticResource SectionHeader}" />
                                </HeaderedContentControl.Header>
                                <StackPanel Margin="{theme:Thickness X=layout.panelHeaderPaddingX, Y=statistics.sectionPaddingY}">
                                    <TextBlock Text="{Binding TopEmptyText}" Style="{StaticResource EmptyLine}"
                                               Tag="{Binding ElementName=TopArtistList}" />
                                    <ItemsControl x:Name="TopArtistList" ItemsSource="{Binding TopArtists}"
                                                  Style="{StaticResource SectionList}" />
                                </StackPanel>
                            </HeaderedContentControl>

                            <HeaderedContentControl Style="{StaticResource Section}">
                                <HeaderedContentControl.Header>
                                    <TextBlock Text="TOP ALBUMS" Style="{StaticResource SectionHeader}" />
                                </HeaderedContentControl.Header>
                                <StackPanel Margin="{theme:Thickness X=layout.panelHeaderPaddingX, Y=statistics.sectionPaddingY}">
                                    <TextBlock Text="{Binding TopEmptyText}" Style="{StaticResource EmptyLine}"
                                               Tag="{Binding ElementName=TopAlbumList}" />
                                    <ItemsControl x:Name="TopAlbumList" ItemsSource="{Binding TopAlbums}"
                                                  Style="{StaticResource SectionList}" />
                                </StackPanel>
                            </HeaderedContentControl>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <HeaderedContentControl Style="{StaticResource Section}">
                                <HeaderedContentControl.Header>
                                    <TextBlock Text="TOP TRACKS" Style="{StaticResource SectionHeader}" />
                                </HeaderedContentControl.Header>
                                <StackPanel Margin="{theme:Thickness X=layout.panelHeaderPaddingX, Y=statistics.sectionPaddingY}">
                                    <TextBlock Text="{Binding TopEmptyText}" Style="{StaticResource EmptyLine}"
                                               Tag="{Binding ElementName=TopTrackList}" />
                                    <ItemsControl x:Name="TopTrackList" ItemsSource="{Binding TopTracks}"
                                                  Style="{StaticResource SectionList}" />
                                </StackPanel>
                            </HeaderedContentControl>

                            <HeaderedContentControl Style="{StaticResource Section}">
                                <HeaderedContentControl.Header>
                                    <TextBlock Text="RECENTLY PLAYED" Style="{StaticResource SectionHeader}" />
                                </HeaderedContentControl.Header>
                                <StackPanel Margin="{theme:Thickness X=layout.panelHeaderPaddingX, Y=statistics.sectionPaddingY}">
                                    <TextBlock Text="{Binding RecentEmptyText}" Style="{StaticResource EmptyLine}"
                                               Tag="{Binding ElementName=RecentList}" />
                                    <ItemsControl x:Name="RecentList" ItemsSource="{Binding Recent}"
                                                  Style="{StaticResource SectionList}" />
                                </StackPanel>
                            </HeaderedContentControl>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="{theme:Thickness X=dialog.paddingX, Bottom=dialog.paddingBottom}">
            <!-- Not IsDefault: Enter belongs to whichever row has focus. -->
            <Button x:Name="CloseButton" HorizontalAlignment="Right" Content="Close" IsCancel="True"
                    Style="{StaticResource theme.dialogButton}"
                    Click="Close_Click" />
        </Grid>
    </Grid>
</ui:FluentWindow>
