<ui:FluentWindow x:Class="AudioFool.LastFmWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:theme="clr-namespace:AudioFool.Theming"
                 Title="Last.fm"
                 Icon="/Resources/AudioFool.ico"
                 Width="{theme:Token lastFm.width}" SizeToContent="Height"
                 MinWidth="{theme:Token lastFm.minWidth}"
                 ResizeMode="NoResize"
                 WindowStartupLocation="Manual"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <Style TargetType="Hyperlink" BasedOn="{StaticResource theme.link}" />

        <!-- Explanations and status: the table's text. -->
        <Style x:Key="Body" TargetType="TextBlock" BasedOn="{StaticResource type.tableCell}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
        </Style>

        <!-- The fine print under the checkbox. -->
        <Style x:Key="FinePrint" TargetType="TextBlock" BasedOn="{StaticResource type.albumMeta}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="{DynamicResource color.window.bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Style="{DynamicResource theme.dialogTitleBar}"
                     Header="{DynamicResource theme.dialogTitle}"
                     ShowMinimize="False" ShowMaximize="False" />

        <StackPanel Grid.Row="1" Margin="{theme:Thickness X=dialog.paddingX, Top=dialog.paddingTop}">

            <!-- Not connected, or the saved session was rejected. -->
            <StackPanel x:Name="SetupPanel"
                        Visibility="{Binding ShowsSetup, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource Body}">
                    Last.fm gives every application its own API account. Make one for
                    AudioFool - any name and description will do, and the callback URL
                    can stay empty - then paste its key and shared secret here.
                </TextBlock>
                <TextBlock Style="{StaticResource Body}" Margin="{theme:Thickness Top=dialog.fieldGap}">
                    <Hyperlink Command="{Binding OpenLinkCommand}"
                               CommandParameter="{Binding CreateApiAccountUrl}">Create an API account on last.fm</Hyperlink>
                </TextBlock>

                <Grid Margin="{theme:Thickness Top=dialog.paddingTop}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{theme:Token lastFm.labelWidth}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="API key" Style="{StaticResource Body}" VerticalAlignment="Center"
                               Margin="{theme:Thickness Bottom=dialog.fieldGap}" />
                    <TextBox x:Name="ApiKeyBox" Grid.Row="0" Grid.Column="1"
                             Style="{StaticResource theme.dialogTextBox}"
                             Margin="{theme:Thickness Bottom=dialog.fieldGap}"
                             AutomationProperties.Name="API key"
                             Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsWaitingForApproval, Converter={StaticResource InverseBool}}" />

                    <TextBlock Grid.Row="1" Text="Shared secret" Style="{StaticResource Body}" VerticalAlignment="Center" />
                    <TextBox x:Name="ApiSecretBox" Grid.Row="1" Grid.Column="1"
                             Style="{StaticResource theme.dialogTextBox}"
                             AutomationProperties.Name="Shared secret"
                             Text="{Binding ApiSecret, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsWaitingForApproval, Converter={StaticResource InverseBool}}" />
                </Grid>

                <StackPanel Margin="{theme:Thickness Top=dialog.paddingTop}"
                            Visibility="{Binding IsWaitingForApproval, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Body}">
                        Approve AudioFool on the last.fm page that just opened in your browser.
                        This window finishes by itself once you have.
                    </TextBlock>
                    <TextBlock Style="{StaticResource Body}" Margin="{theme:Thickness Top=dialog.fieldGap}">
                        <Hyperlink Command="{Binding OpenApprovalPageAgainCommand}">Open the page again</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <!-- Connected. -->
            <StackPanel x:Name="ConnectedPanel"
                        Visibility="{Binding ShowsConnected, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource Body}">
                    <Hyperlink Command="{Binding OpenLinkCommand}" CommandParameter="{Binding ProfileUrl}">
                        <Run Text="{Binding ConnectedAs, Mode=OneWay}" />
                    </Hyperlink>
                </TextBlock>

                <CheckBox x:Name="ScrobblingCheck"
                          Style="{StaticResource theme.checkBox}"
                          Margin="{theme:Thickness Top=dialog.paddingTop}"
                          Content="Scrobble what I play"
                          IsChecked="{Binding ScrobblingEnabled, Mode=TwoWay}" />

                <TextBlock x:Name="QueueStatusText"
                           Style="{StaticResource Body}"
                           Margin="{theme:Thickness Top=dialog.paragraphGap}"
                           Text="{Binding QueueStatus}" />

                <TextBlock Style="{StaticResource FinePrint}" Margin="{theme:Thickness Top=dialog.paragraphGap}">
                    A track is scrobbled once it has played for half its length or four
                    minutes, whichever comes first. Tracks of 30 seconds or less, and
                    tracks with no title or artist tag, are not. Plays made while offline
                    are kept and sent later, for up to two weeks.
                </TextBlock>

                <TextBlock Style="{StaticResource FinePrint}" Margin="{theme:Thickness Top=dialog.paragraphGap}">
                    Disconnecting forgets the session here. To withdraw AudioFool's access
                    on last.fm too, remove it on your
                    <Hyperlink Command="{Binding OpenLinkCommand}"
                               CommandParameter="{Binding ApplicationsSettingsUrl}">applications page</Hyperlink>.
                </TextBlock>
            </StackPanel>

            <!-- No colour (the user's call): the spec has no error role, and the
                 wording already says what went wrong. -->
            <TextBlock x:Name="ErrorText"
                       Style="{StaticResource Body}"
                       Margin="{theme:Thickness Top=dialog.paragraphGap}"
                       Foreground="{DynamicResource color.text.heading}"
                       FontWeight="{DynamicResource dialog.emphasisWeight.fontWeight}"
                       Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="{theme:Thickness X=dialog.paddingX, Top=dialog.paddingTop, Bottom=dialog.paddingBottom}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="DisconnectButton" Content="Disconnect"
                        Style="{StaticResource theme.dialogButton}"
                        Command="{Binding DisconnectCommand}"
                        Visibility="{Binding ShowsConnected, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancel"
                        Style="{StaticResource theme.dialogButton}"
                        Margin="{theme:Thickness Right=dialog.buttonGap}"
                        Command="{Binding CancelConnectCommand}"
                        Visibility="{Binding IsWaitingForApproval, Converter={StaticResource BoolToVisibility}}" />
                <Button x:Name="ConnectButton" Content="Connect"
                        Style="{StaticResource theme.dialogButton.primary}"
                        Margin="{theme:Thickness Right=dialog.buttonGap}"
                        Command="{Binding ConnectCommand}"
                        Visibility="{Binding ShowsSetup, Converter={StaticResource BoolToVisibility}}" />
                <Button x:Name="CloseButton" Content="Close" IsCancel="True"
                        Style="{StaticResource theme.dialogButton}"
                        Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
