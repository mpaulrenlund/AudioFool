<ui:FluentWindow x:Class="AudioFool.ArtSearchWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:theme="clr-namespace:AudioFool.Theming"
                 Title="Search Internet for Cover Art"
                 Icon="/Resources/AudioFool.ico"
                 Width="{theme:Token artSearch.width}" Height="{theme:Token artSearch.height}"
                 MinWidth="{theme:Token artSearch.minWidth}" MinHeight="{theme:Token artSearch.minHeight}"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round">

    <Grid Background="{DynamicResource color.window.bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Style="{DynamicResource theme.dialogTitleBar}"
                     Header="{DynamicResource theme.dialogTitle}" />

        <!-- What to search for, pre-filled from the album and editable. -->
        <Grid Grid.Row="1" Margin="{theme:Thickness X=dialog.paddingX, Top=dialog.paddingTop}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ArtistBox" Grid.Column="0"
                     Style="{StaticResource theme.dialogTextBox}"
                     theme:Placeholder.Text="Artist"
                     Text="{Binding Artist, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Artist" KeyDown="Query_KeyDown" />
            <TextBox x:Name="AlbumBox" Grid.Column="1"
                     Style="{StaticResource theme.dialogTextBox}"
                     Margin="{theme:Thickness Left=dialog.fieldGap}"
                     theme:Placeholder.Text="Album"
                     Text="{Binding Album, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Album" KeyDown="Query_KeyDown" />
            <!-- The search box's magnifier (6.1) before the label. -->
            <Button x:Name="SearchButton" Grid.Column="2"
                    Style="{StaticResource theme.dialogButton}"
                    Margin="{theme:Thickness Left=dialog.fieldGap}"
                    AutomationProperties.Name="Search"
                    Command="{Binding SearchCommand}">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="{theme:Token titleBar.search.iconSize}"
                             Height="{theme:Token titleBar.search.iconSize}"
                             VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="M 17.5,11 A 6.5,6.5 0 1 1 4.5,11 A 6.5,6.5 0 1 1 17.5,11 Z M 16,16 L 20,20"
                                  Stroke="{DynamicResource color.text.muted}"
                                  StrokeThickness="{theme:Token titleBar.search.iconStrokeOn24Grid}"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Search" VerticalAlignment="Center"
                               Margin="{theme:Thickness Left=dialog.fieldGap}" />
                </StackPanel>
            </Button>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2"
                   Margin="{theme:Thickness X=dialog.paddingX, Top=artSearch.statusGapTop, Bottom=artSearch.statusGapBottom}"
                   Text="{Binding Status}" Style="{DynamicResource type.tableCell}"
                   TextWrapping="Wrap" TextTrimming="None" />

        <!--
            JPEG only, at least 1,000 px on both sides: the filter is applied
            before a cover appears here, measured from the file itself.

            The covers behave as the Albums list (6.4), in a panel like it: the
            selection grey only reads on panel grey, not on the window's. Hover
            wash, selection grey, row corners, and the thumbnail frame darkening
            when selected. No focus outline, as on the main window's list rows.
            The list padding is a Margin: WPF-UI's ListBox ignores Padding. No
            visible scrollbar (the theme's rule).
        -->
        <HeaderedContentControl Grid.Row="3"
                                Style="{DynamicResource theme.panel}"
                                Margin="{theme:Thickness X=dialog.paddingX}">
            <ListBox x:Name="ResultList"
                     Margin="{theme:Thickness All=layout.listPadding}"
                     ItemsSource="{Binding Results}"
                     SelectedItem="{Binding Selected}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     Background="Transparent" BorderThickness="0"
                     FocusVisualStyle="{x:Null}"
                     MouseDoubleClick="ResultList_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="{theme:Thickness All=artSearch.tileMargin}" />
                        <Setter Property="Padding" Value="{theme:Thickness All=artSearch.tilePadding}" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Chrome" Padding="{TemplateBinding Padding}"
                                            Background="Transparent"
                                            CornerRadius="{DynamicResource radius.row}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource color.state.hoverOverlay}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource color.state.selectionBg}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="{theme:Token artSearch.tileSize}" ToolTip="{Binding Title}">
                            <Border Width="{theme:Token artSearch.tileSize}" Height="{theme:Token artSearch.tileSize}"
                                    Background="{DynamicResource color.panel.bg}"
                                    BorderThickness="{theme:Thickness All=layout.panelBorder}"
                                    CornerRadius="{DynamicResource radius.art}"
                                    SnapsToDevicePixels="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource color.art.thumbBorder}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource color.art.thumbBorderSelected}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <ui:SymbolIcon Symbol="MusicNote224"
                                                   FontSize="{theme:Token albums.placeholderIconSize}"
                                                   Foreground="{DynamicResource color.text.muted}"
                                                   Visibility="{Binding Preview, Converter={StaticResource NullToVisible}}" />
                                    <Image Source="{Binding Preview}" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding Preview, Converter={StaticResource NullToCollapsed}}" />
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding SizeText}"
                                       Style="{DynamicResource type.songTitle}"
                                       FontWeight="{DynamicResource dialog.emphasisWeight.fontWeight}"
                                       Margin="{theme:Thickness Top=artSearch.tileTextGap}" />
                            <TextBlock Text="{Binding Source}" Style="{DynamicResource type.albumMeta}" />
                            <TextBlock Text="{Binding Title}" Style="{DynamicResource type.albumMeta}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </HeaderedContentControl>

        <Grid Grid.Row="4" Margin="{theme:Thickness X=dialog.paddingX, Top=dialog.paddingTop, Bottom=dialog.paddingBottom}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                       Style="{DynamicResource type.albumMeta}"
                       TextWrapping="Wrap"
                       Margin="{theme:Thickness Right=dialog.buttonGap}"
                       Text="Double-click a cover, or select one and press Use Image." />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel" Click="Cancel_Click"
                        Style="{StaticResource theme.dialogButton}"
                        Margin="{theme:Thickness Right=dialog.buttonGap}" />
                <Button x:Name="UseButton" Content="Use Image"
                        Style="{StaticResource theme.dialogButton.primary}"
                        IsEnabled="{Binding CanUse}" Click="Use_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
