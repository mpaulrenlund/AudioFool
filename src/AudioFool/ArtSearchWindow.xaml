<ui:FluentWindow x:Class="AudioFool.ArtSearchWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Search Internet for Cover Art"
                 Icon="/Resources/AudioFool.ico"
                 Width="820" Height="640"
                 MinWidth="520" MinHeight="400"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Search Internet for Cover Art">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Resources/AudioFool.ico" Width="16" Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- What to search for, pre-filled from the album and editable. -->
        <Grid Grid.Row="1" Margin="20,12,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="ArtistBox" Grid.Column="0" PlaceholderText="Artist"
                        Text="{Binding Artist, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="Artist" KeyDown="Query_KeyDown" />
            <ui:TextBox x:Name="AlbumBox" Grid.Column="1" Margin="8,0,0,0" PlaceholderText="Album"
                        Text="{Binding Album, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="Album" KeyDown="Query_KeyDown" />
            <ui:Button x:Name="SearchButton" Grid.Column="2" Margin="8,0,0,0" Content="Search"
                       Icon="{ui:SymbolIcon Search24}" Command="{Binding SearchCommand}" />
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="20,10,20,6"
                   Text="{Binding Status}" Style="{DynamicResource AfMetaText}"
                   TextWrapping="Wrap" TextTrimming="None" />

        <!-- JPEG only, at least 1,000 px on both sides: the filter is applied
             before a cover appears here, measured from the file itself. -->
        <ListBox x:Name="ResultList" Grid.Row="3" Margin="14,0,14,0"
                 ItemsSource="{Binding Results}"
                 SelectedItem="{Binding Selected}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Background="Transparent" BorderThickness="0"
                 MouseDoubleClick="ResultList_MouseDoubleClick">
            <!-- Not BasedOn WPF-UI's item: that fills the selected cover with a slab
                 of accent colour. An accent ring over a row wash keeps the art and
                 its text readable. -->
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="4" />
                    <Setter Property="Padding" Value="6" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Chrome" Padding="{TemplateBinding Padding}"
                                        Background="Transparent" BorderBrush="Transparent" BorderThickness="2"
                                        CornerRadius="{DynamicResource AfRadiusControl}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AfSurfaceRowHover}" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AfFocusRing}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AfSurfaceRowSelected}" />
                                        <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="164" ToolTip="{Binding Title}">
                        <Border Width="164" Height="164" Style="{DynamicResource AfArtFrame}">
                            <Grid>
                                <ui:SymbolIcon Symbol="MusicNote224"
                                               FontSize="{DynamicResource AfIconSizeMedium}"
                                               Foreground="{DynamicResource AfTextPlaceholder}"
                                               Visibility="{Binding Preview, Converter={StaticResource NullToVisible}}" />
                                <Image Source="{Binding Preview}" Stretch="Uniform"
                                       Visibility="{Binding Preview, Converter={StaticResource NullToCollapsed}}" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding SizeText}" Margin="0,6,0,0" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Source}" Style="{DynamicResource AfMetaText}" />
                        <TextBlock Text="{Binding Title}" Style="{DynamicResource AfMetaText}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="4" Margin="20,10,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{DynamicResource AfMetaText}"
                       Text="Double-click a cover, or select one and press Use Image." />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" />
                <ui:Button x:Name="UseButton" Content="Use Image" Appearance="Primary"
                           IsEnabled="{Binding CanUse}" Click="Use_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
