<ui:FluentWindow x:Class="AudioFool.ArtWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Album art"
                 Icon="/Resources/AudioFool.ico"
                 Width="720" Height="780"
                 MinWidth="280" MinHeight="280"
                 WindowStartupLocation="Manual"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="Bar" Grid.Row="0" Title="Album art">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Resources/AudioFool.ico" Width="16" Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!--
            Dark mat behind the cover so a light-edged image still reads as a
            distinct object, the way a picture frame does.
        -->
        <Border Grid.Row="1" Margin="12,0,12,0"
                CornerRadius="{DynamicResource AfRadiusArt}"
                Background="{DynamicResource AfSurfaceMat}">
            <Image x:Name="ArtImage"
                   Stretch="Uniform"
                   StretchDirection="Both"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Margin="6" />
        </Border>

        <TextBlock x:Name="Caption"
                   Grid.Row="2"
                   Margin="16,10,16,12"
                   Style="{DynamicResource AfMetaText}"
                   TextAlignment="Center" />
    </Grid>
</ui:FluentWindow>
