<ui:FluentWindow x:Class="AudioFool.ArtWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:theme="clr-namespace:AudioFool.Theming"
                 Title="Album art"
                 Icon="/Resources/AudioFool.ico"
                 MinWidth="{theme:Token artViewer.minSize}" MinHeight="{theme:Token artViewer.minSize}"
                 WindowStartupLocation="Manual"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round">

    <Grid Background="{DynamicResource color.window.bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="Bar" Grid.Row="0"
                     Style="{DynamicResource theme.dialogTitleBar}"
                     Header="{DynamicResource theme.dialogTitle}" />

        <!--
            The cover as the album header shows it: straight on the window grey,
            in a 1 px frame with the header art's shadow. The frame is centred
            and sized by the image, so it hugs a cover of any shape.
        -->
        <Border Grid.Row="1"
                Margin="{theme:Thickness X=layout.windowMarginX}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="{DynamicResource color.art.border}"
                BorderThickness="{theme:Thickness All=layout.panelBorder}"
                CornerRadius="{DynamicResource radius.art}"
                Effect="{DynamicResource shadow.headerArt}"
                SnapsToDevicePixels="True">
            <Image x:Name="ArtImage"
                   Stretch="Uniform"
                   StretchDirection="Both"
                   RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>

        <TextBlock x:Name="Caption"
                   Grid.Row="2"
                   Margin="{theme:Thickness X=layout.windowMarginX, Top=artViewer.captionPaddingTop, Bottom=artViewer.captionPaddingBottom}"
                   Style="{DynamicResource type.albumMeta}"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
    </Grid>
</ui:FluentWindow>
