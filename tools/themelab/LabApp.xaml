<Application x:Class="ThemeLab.LabApp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:fmt="clr-namespace:AudioFool.Formatting;assembly=AudioFool">
    <!--
        Mirrors AudioFool's App.xaml resource composition, and nothing else.

        The harness cannot construct AudioFool.App itself: Application's
        constructor queues OnStartup onto the dispatcher, so the first time the
        harness pumps the queue the real startup path runs - loading the user's
        settings and building and showing a second MainWindow on the desktop.

        The two AudioFool dictionaries below are the real files, so anything
        themeable is shared rather than copied. Only this list and the converter
        keys are duplicated; if App.xaml gains a dictionary, add it here too.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="pack://application:,,,/AudioFool;component/Themes/DesignTokens.xaml" />
                <ResourceDictionary Source="pack://application:,,,/AudioFool;component/Themes/Components.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <fmt:DurationConverter x:Key="Duration" />
            <fmt:BitrateConverter x:Key="Bitrate" />
            <fmt:BitDepthConverter x:Key="BitDepth" />
            <fmt:SampleRateConverter x:Key="SampleRate" />
            <fmt:NumberConverter x:Key="Number" />
            <fmt:NullToCollapsedConverter x:Key="NullToCollapsed" />
            <fmt:NullToVisibleConverter x:Key="NullToVisible" />
            <fmt:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <fmt:InverseBoolConverter x:Key="InverseBool" />
            <fmt:EnabledOpacityConverter x:Key="EnabledOpacity" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
